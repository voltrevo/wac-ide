From afe23c12f459196b18cd997b00dad35a617e35cf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 08:14:16 +0000
Subject: [PATCH 2/4] bootstrap: say what wac-L5 refused, not only how many

A change to wacc that steps outside the ladder's subset failed with
"wac-L5 refused 50 thing(s)" and nothing else; the refusals are in the
L0 text as !! lines, so the first twenty are printed before the count.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J7c8hTEmTN5s7KvmrRMqXX
---
 bootstrap/js/wacc.js | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/bootstrap/js/wacc.js b/bootstrap/js/wacc.js
index 0dc6d0e84..dddeffd41 100644
--- a/bootstrap/js/wacc.js
+++ b/bootstrap/js/wacc.js
@@ -153,6 +153,8 @@ export function wacc(instance) {
 export async function buildWithWacc(o) {
   const l0 = await o.l5ToL0(o.waccSource);
   const refusals = (l0.match(/^!!/gm) ?? []).length;
+  // What was refused, not only how much: a count alone sends whoever changed wacc hunting for it.
+  if (refusals > 0) console.error((l0.match(/^!!.*$/gm) ?? []).slice(0, 20).join("\n"));
   if (refusals > 0) throw new Error(`wac-L5 refused ${refusals} thing(s) in wacc's own source`);
 
   const instance = await WebAssembly.instantiate(
