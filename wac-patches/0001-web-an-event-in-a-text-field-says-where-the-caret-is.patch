 /** What the fake document saw, as one line per call. */
@@ -322,3 +322,31 @@ export string test_an_element_scrolls_itself_or_a_named_element_under_it_into_vi
   t.eqStr(doc.scrolled, "1 ", "the element itself");
   return t.report();
 }
+
+async string caretOf(Element field) {
+  ElementEvent plain = await field.next();
+  ElementEvent typed = await field.next();
+  return "\{plain.selStart},\{plain.selEnd} \{typed.selStart},\{typed.selEnd}";
+}
+
+export string test_an_event_in_a_text_field_says_where_the_caret_is_and_a_program_can_move_it() {
+  Check t = Check.create();
+  Seen seen = Seen("", 0);
+  Dom d = fakeDom(seen);
+  d.elements.prop = (i32 id, string name, string value, i32 eventsSeen) => {
+    seen.log = seen.log + "prop \{id} \{name} \{value} \{eventsSeen}\n";
+  };
+  Page page = Page.create(d);
+  Element field = page.root().append("textarea");
+  field.listen("keyup", Listen.none());
+  Ticket<string> got = caretOf(field);
+  // An event from no text field says so; one from a field carries its selection.
+  elementEvent(page, 1, "keyup", 1, 1, "a", 0, 0, 0);
+  elementEventAt(page, 2, "keyup", 1, 1, "b", 0, 0, 0, 4, 9);
+  page.drain();
+  t.eqStr(got.wait().unwrap(), "-1,-1 4,9", "the caret, or -1 where there is none");
+  seen.log = "";
+  field.select(3, 3);
+  t.eqStr(seen.log, "prop 1 selection 3,3 2\n", "and select sends the range, with the events seen");
+  return t.report();
+}
