diff --git a/packages/web/src/element.wac b/packages/web/src/element.wac
index af3462048..90fe6644c 100644
--- a/packages/web/src/element.wac
+++ b/packages/web/src/element.wac
@@ -57,6 +57,17 @@ export struct ElementEvent {
   i32 y;
   /** The modifier keys held, as `MOD_*` bits from `page.wac`. */
   i32 mods;
+  /**
+   * **Where the caret is**, in a text field the event happened in — an `<input>` or a `<textarea>` —
+   * as the field's `selectionStart` and `selectionEnd`, which are equal when nothing is selected; -1 for
+   * an element that has none. Counted in UTF-16 code units, as the browser counts them, not in bytes.
+   *
+   * Read when the event happens, so a `keydown` sees the caret before the key acts and a `keyup`,
+   * `input` or `click` sees it after: an editor that wants to indent on Enter listens for `keydown`,
+   * and one that shows "line 12, column 4" listens for `keyup` and `click`.
+   */
+  i32 selStart;
+  i32 selEnd;
 }
 
 /**
@@ -140,12 +151,18 @@ export struct Elements {
    * that is gone.
    */
   void deliver(this, i32 seq, string kind, i32 targetId, i32 listenerId, string value, i32 x, i32 y, i32 mods) {
+    this.deliverAt(seq, kind, targetId, listenerId, value, x, y, mods, -1, -1);
+  }
+
+  /** `deliver`, with the caret of the text field the event happened in (see `ElementEvent.selStart`). */
+  void deliverAt(this, i32 seq, string kind, i32 targetId, i32 listenerId, string value, i32 x, i32 y, i32 mods,
+                 i32 selStart, i32 selEnd) {
     if (seq > this.seen) { this.seen = seq; }
     if (listenerId < 0 || listenerId >= this.byId.len() || targetId < 0 || targetId >= this.byId.len()) { return; }
     Element? l = this.byId.get(listenerId);
     Element? t = this.byId.get(targetId);
     if (l is null || t is null) { return; }
-    l!.heard(ElementEvent(kind, t!, value, x, y, mods));
+    l!.heard(ElementEvent(kind, t!, value, x, y, mods, selStart, selEnd));
   }
 
   /** The answer to a `value()` read. */
@@ -267,6 +284,17 @@ export struct Element {
     this.es.ops.prop(this.id, name, value, this.es.seen);
   }
 
+  /**
+   * Select `start` to `end` of this text field — the caret alone, when they are equal — counted as
+   * `ElementEvent.selStart` is. Like a `value` set by a render, it does not land if the user has typed
+   * here since the last event the program saw: a caret moved by a program that is behind the typing
+   * would put the next keystroke in the wrong place.
+   */
+  void select(this, i32 start, i32 end) {
+    this.alive("select");
+    this.es.ops.prop(this.id, "selection", "\{start},\{end}", this.es.seen);
+  }
+
   void focus(this) {
     this.alive("focus");
     this.es.ops.focus(this.id);
