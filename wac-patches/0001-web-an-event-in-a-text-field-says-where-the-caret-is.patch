+}
+
+/** `elementEvent`, with the caret of the text field it happened in (`ElementEvent.selStart`). */
+export void elementEventAt(Page page, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y,
+                           i32 mods, i32 selStart, i32 selEnd) {
   schedule page.take;
-  page.es.deliver(seq, kind, target, listener, value, x, y, mods);
+  page.es.deliverAt(seq, kind, target, listener, value, x, y, mods, selStart, selEnd);
   page.drain();
   page.turn();
 }
