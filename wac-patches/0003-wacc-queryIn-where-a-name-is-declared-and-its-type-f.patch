new file mode 100644
index 000000000..948d56edf
--- /dev/null
+++ b/packages/wacc/test/wac/query_test.wac
@@ -0,0 +1,133 @@
+// An editor's questions about a position (`queryIn`): where a name is declared, what its type is, and
+// what its declaration says — for a local, a loop variable, a parameter, an imported function, a struct,
+// a field, a method reached through a value's type, and a name inside a lambda.
+
+import { queryIn } from "../../src/api.wac";
+import { Res } from "../../src/path.wac";
+
+static string LIB = """
+/** A point. */
+export struct Point {
+  i32 x;
+  i32 y;
+  /** How far from the origin, squared. */
+  i32 norm(const this) { return this.x * this.x + this.y * this.y; }
+}
+
+/** Make one. */
+export Point at(i32 x, i32 y) { return Point(x, y); }
+""";
+
+static string MAIN = """
+import { Point, at } from "./lib.wac";
+
+export i32 main(i32 extra) {
+  Point p = at(3, 4);
+  i32 total = p.norm() + p.x;
+  for (i32 i = 0; i < 2; i++) { total = total + i; }
+  fn<i32(i32)> twice = (i32 n) => n * 2 + extra;
+  return twice(total);
+}
+""";
+
+/** What `queryIn` says about the `nth` (from 0) occurrence of `needle` in MAIN, a field at a time. */
+string ask(string needle, i32 nth) {
+  i32 at = -1;
+  i32 from = 0;
+  for (i32 k = 0; k <= nth; k++) {
+    i32 found = MAIN.slice(from, MAIN.len()).indexOf(needle);
+    if (found < 0) { return "<no \{needle}>"; }
+    at = from + found;
+    from = at + 1;
+  }
+  return queryIn(["/p/main.wac", "/p/lib.wac"], [MAIN, LIB], Res.of(["/p", "/p"]), "/p/main.wac", at);
+}
+
+/** The value of `key`'s line, the fields after it joined by a space; "" when there is none. */
+string field(string answer, string key) {
+  i32 start = 0;
+  u8[] b = answer.toBytes();
+  for (i32 i = 0; i <= b.len(); i++) {
+    if (i < b.len() && b[i] != '\n') { continue; }
+    string line = answer.slice(start, i);
+    start = i + 1;
+    if (line.len() > key.len() && line.slice(0, key.len() + 1) == key + "\t") {
+      string rest = line.slice(key.len() + 1, line.len());
+      string out = "";
+      u8[] r = rest.toBytes();
+      for (i32 k = 0; k < r.len(); k++) { out = out + (r[k] == '\t' ? " " : rest.slice(k, k + 1)); }
+      return out;
+    }
+  }
+  return "";
+}
+
+export string test_a_local_and_a_loop_variable_are_declared_above_their_use() {
+  string total = ask("total + i", 0);
+  if (field(total, "def") != "/p/main.wac 5 7 local" || field(total, "type") != "i32") { return "total: " + total; }
+  string i = ask("i; }", 0);
+  if (field(i, "def") != "/p/main.wac 6 12 local" || field(i, "type") != "i32") { return "i: " + i; }
+  string p = ask("p.norm", 0);
+  if (field(p, "def") != "/p/main.wac 4 9 local" || field(p, "type") != "Point") { return "p: " + p; }
+  if (field(p, "sig") != "Point p = at(3, 4);") { return "p's line: " + p; }
+  return "";
+}
+
+export string test_an_imported_function_is_found_where_it_is_declared_with_its_doc() {
+  string a = ask("at(3", 0);
+  if (field(a, "def") != "/p/lib.wac 10 14 function") { return "at: " + a; }
+  if (field(a, "sig") != "export Point at(i32 x, i32 y) { return Point(x, y); }" || field(a, "doc") != "Make one.") { return "at's doc: " + a; }
+  string pt = ask("Point p", 0);
+  if (field(pt, "def") != "/p/lib.wac 2 15 struct" || field(pt, "doc") != "A point.") { return "Point: " + pt; }
+  return "";
+}
+
+export string test_a_member_is_found_through_the_type_of_its_receiver() {
+  string norm = ask("norm()", 0);
+  if (field(norm, "def") != "/p/lib.wac 6 7 method") { return "norm: " + norm; }
+  if (field(norm, "doc") != "How far from the origin, squared.") { return "norm's doc: " + norm; }
+  string fx = queryIn(["/p/main.wac", "/p/lib.wac"], [MAIN, LIB], Res.of(["/p", "/p"]), "/p/main.wac", MAIN.indexOf("p.x") + 2);
+  if (field(fx, "def") != "/p/lib.wac 3 7 field" || field(fx, "type") != "i32") { return "p.x: " + fx; }
+  return "";
+}
+
+export string test_a_lambda_sees_its_parameters_and_the_function_s() {
+  string n = queryIn(["/p/main.wac", "/p/lib.wac"], [MAIN, LIB], Res.of(["/p", "/p"]), "/p/main.wac", MAIN.indexOf("n * 2"));
+  if (field(n, "def") != "/p/main.wac 7 29 parameter") { return "n: " + n; }
+  string extra = ask("extra;", 0);
+  if (field(extra, "def") != "/p/main.wac 3 21 parameter") { return "extra: " + extra; }
+  return "";
+}
+
+export string test_a_declaration_is_its_own_definition_and_a_space_is_nothing() {
+  string d = ask("total =", 0);
+  if (field(d, "def") != "/p/main.wac 5 7 local" || field(d, "type") != "i32") { return "declared: " + d; }
+  if (queryIn(["/p/main.wac"], [MAIN], Res.of(["/p"]), "/p/main.wac", 1000) != "") { return "past the end"; }
+  return "";
+}
+
+static string SHAPES = """
+export enum Color { Red, Green }
+
+export struct Box {
+  Color c;
+  i32 side;
+  i32 area(const this) { return this.side * this.side; }
+}
+
+export Color pick(bool warm) { return warm ? Color.Red : Color.Green; }
+""";
+
+string inShapes(string needle, i32 skip) {
+  return queryIn(["/p/shapes.wac"], [SHAPES], Res.of(["/p"]), "/p/shapes.wac", SHAPES.indexOf(needle) + skip);
+}
+
+export string test_this_and_a_variant_are_found_in_their_declarations() {
+  string side = inShapes("this.side", 5);
+  if (field(side, "def") != "/p/shapes.wac 5 7 field" || field(side, "type") != "i32") { return "this.side: " + side; }
+  string red = inShapes("Color.Red", 6);
+  if (field(red, "def") != "/p/shapes.wac 1 21 variant") { return "Color.Red: " + red; }
+  string color = inShapes("Color c", 0);
+  if (field(color, "def") != "/p/shapes.wac 1 13 enum") { return "Color: " + color; }
+  return "";
+}
