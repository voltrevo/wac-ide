{
  imports: {
    // wac's packages, as one dependency — `import { gzip.inflateResult } from "wac"`.
    wac: { git: 'https://github.com/voltrevo/wac', ref: '5d15f2ed6f55ef855afa36df06ff0cc6e9fa825a' },
    // The page a program is handed.
    web: { git: 'https://github.com/voltrevo/wac', ref: '5d15f2ed6f55ef855afa36df06ff0cc6e9fa825a', subdir: './packages/web' },
    // The page builder `build.wac` calls.
    webbuild: { git: 'https://github.com/voltrevo/wac', ref: '5d15f2ed6f55ef855afa36df06ff0cc6e9fa825a', subdir: './packages/web/tools' },
  },
}
