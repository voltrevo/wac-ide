// wac IDE: projects in the browser's storage, an editor coloured by wac's own lexer, and wac's own
// compiler checking as you type, in a process of its own.
//
// **The page** is the projects screen and the workbench: a file tree, tabs, the editor, the problems the
// last check found, and a finder (Ctrl+P). **The checker** (`checker.wac`) is a copy of this page started
// with `--spawn checker`; it keeps the compiler warm and every file it has read, and each edit is sent to
// it as it is made, so a check sees what is on screen, saved or not. Edits are saved a moment after
// typing stops, as they are sent.

import { Map, Ticket, Vec, hashString, stringEq } from "core";
import { Files, MemoryStore, Sys } from "std";
import { Desktop, ElementEvent, MOD_CTRL, MOD_META, Node, Page, Picked, Ref, Ui, html.b, html.button, html.div, html.h1, html.input,
         html.label, html.p, html.span, html.style } from "web";
import { Checker, Outcome, serve } from "./checker.wac";
import { Diag, errorCount, inFile, parseWire } from "./diag.wac";
import { Doc, Editor, dirty, lineAt, newDoc, offsetOf, retext, u16Of } from "./editor.wac";
import { Info, parseInfo } from "./info.wac";
import { Entry, Got, Incoming, Unpacked, PROJECTS, commonTop, ignored, join, leafOf, list, lowerOf, parentOf, projectName,
         projects, read, remove, rootOf, store, unpack, walk, write } from "./store.wac";
import { css, icon } from "./style.wac";

static string STATE = "ide/state";
static i32 QUIET = 600;
static i32 SETTLE = 350;

/** The checker's process: what `--spawn checker` runs. */
export async i32 checker(Sys sys) { return await serve(sys); }

// ── what the page holds ─────────────────────────────────────────────────────

struct App {
  Files fs;
  bool persistent;
  /** The folder of projects: `PROJECTS` on its own, or the folder wac's desktop started it with. */
  string home;
  /** The desktop that started it, which a build is noted on; `null` on a page of its own. */
  Desktop? desk;
  Checker? check;
  /** The open project, or "" for the projects screen. */
  string project;
  string[] projects;
  /** Each folder's entries, once listed, by path on the disk; and which folders are open. */
  Map<string, Entry[]> dirs;
  Map<string, bool> open;
  string selected;
  Vec<Doc> docs;
  i32 active;
  /** The last check: what it found, of which entry, how long it took. */
  Diag[] diags;
  i32 diagSeq;
  string checkedEntry;
  string checkSummary;
  bool checking;
  bool checkWanted;
  bool problems;
  /** Edits not yet sent to the checker and the disk. */
  i32 editSeq;
  /** The finder: whether it is up, what is typed, which hit is chosen, and every file of the project. */
  bool finding;
  string query;
  i32 hit;
  string[] index;
  /** Making a new file: the folder it goes in, while the name is typed. */
  bool naming;
  /** Bumped to put the caret in the editor in front. */
  i32 focusSeq;
  /** What is known about the name at the caret, for the card under it; and the caret, which moved last. */
  Info? info;
  i32 infoSeq;
  i32 caretSeq;
  i32 caretByte;
  string caretAt;
  string importing;
  string note;
  string error;
  string confirm;
  string checkerNote;
}

App newApp(Files fs, bool persistent) {
  return App(fs, persistent, PROJECTS, null, null, "", string[](), Map.create(hashString, stringEq), Map.create(hashString, stringEq), "",
             Vec.create(), -1, Diag[](), 0, "", "", false, false, true, 0, false, "", 0, string[](), false, 0, null, 0, 0, 0, "", "", "", "", "", "");
}

Doc? activeDoc(App a) { return a.active >= 0 && a.active < a.docs.len() ? a.docs.get(a.active) : null; }

/** A path on the disk, relative to the open project. */
string rel(App a, string path) {
  string root = rootOf(a.home, a.project) + "/";
  return path.len() > root.len() && path.slice(0, root.len()) == root ? path.slice(root.len(), path.len()) : path;
}

bool isWac(string path) { return path.len() > 4 && path.slice(path.len() - 4, path.len()) == ".wac"; }

/** Milliseconds by the page's clock, or 0 where it has none. */
async i64 nowOf(Page page) {
  match (await page.sys.clock().nowMillis()) {
    Ok(ms): { return ms; }
    Err(why): { return 0 as i64; }
  }
}

// ── remembering where we were ───────────────────────────────────────────────

async void saveState(App a) {
  string s = a.project + "\n";
  Doc? d = activeDoc(a);
  s = s + (d is null ? "" : d!.path) + "\n";
  for (i32 i = 0; i < a.docs.len(); i++) { s = s + a.docs.get(i).path + "\n"; }
  await write(a.fs, STATE, s.toBytes());
}

string[] linesOf(string s) {
  Vec<string> out = Vec.create();
  i32 start = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '\n') { out.push(s.slice(start, i)); start = i + 1; } }
  if (start < b.len()) { out.push(s.slice(start, b.len())); }
  return out.toArray();
}

async void start(Page page, App a, fn<void()> bump) {
  a.projects = await projects(a.fs, a.home);
  Got st = await read(a.fs, STATE);
  bump();
  Checker c = await Checker.start(page.sys, a.fs, a.persistent);
  a.check = c;
  a.checkerNote = c.note;
  if (st.ok) {
    string[] l = linesOf(string.fromBytes(st.bytes));
    bool known = false;
    for (i32 i = 0; i < a.projects.len(); i++) { if (l.len() > 0 && a.projects[i] == l[0]) { known = true; } }
    if (known) {
      await openProject(a, l[0], bump);
      for (i32 i = 2; i < l.len(); i++) { await openFile(a, l[i], bump); }
      for (i32 i = 0; i < a.docs.len(); i++) { if (l.len() > 1 && a.docs.get(i).path == l[1]) { a.active = i; } }
      wantCheck(a, bump);
    }
  }
  bump();
}

// ── projects ────────────────────────────────────────────────────────────────

async void openProject(App a, string name, fn<void()> bump) {
  a.project = name;
  a.docs = Vec.create();
  a.active = -1;
  a.dirs = Map.create(hashString, stringEq);
  a.open = Map.create(hashString, stringEq);
  a.open.set(rootOf(a.home, name), true);
  a.diags = Diag[]();
  a.diagSeq++;
  a.checkSummary = "";
  a.selected = rootOf(a.home, name);
  a.index = string[]();
  if (a.check is not null) { a.check!.reset(); }
  await listDir(a, rootOf(a.home, name), bump);
  // The finder's list of every file: written at import, made by walking the project otherwise.
  Got idx = await read(a.fs, "ide/\{name}.files");
  if (idx.ok) {
    a.index = linesOf(string.fromBytes(idx.bytes));
  } else {
    Vec<string> all = Vec.create();
    await walk(a.fs, rootOf(a.home, name), "", all);
    a.index = all.toArray();
    await write(a.fs, "ide/\{name}.files", joinLines(a.index).toBytes());
  }
  saveState(a);
  bump();
}

string joinLines(string[] xs) {
  string s = "";
  for (i32 i = 0; i < xs.len(); i++) { s = s + xs[i] + "\n"; }
  return s;
}

async void listDir(App a, string dir, fn<void()> bump) {
  a.dirs.set(dir, await list(a.fs, dir));
  bump();
}

async void deleteProject(App a, string name, fn<void()> bump) {
  await remove(a.fs, rootOf(a.home, name));
  await remove(a.fs, "ide/\{name}.files");
  a.projects = await projects(a.fs, a.home);
  a.note = "Deleted \{name}";
  bump();
}

static string HELLO = """
// A wac program. Its errors show as you type; Build makes a module of it.
import { Sys } from "std";

export i32 main(Sys sys) {
  sys.stdout().line("hello from wac");
  return 0;
}
""";

async void newProject(App a, fn<void()> bump) {
  string name = projectName("hello", a.projects);
  await write(a.fs, join(rootOf(a.home, name), "main.wac"), HELLO.toBytes());
  await write(a.fs, "ide/\{name}.files", "main.wac\n".toBytes());
  a.projects = await projects(a.fs, a.home);
  await openProject(a, name, bump);
  await openFile(a, join(rootOf(a.home, name), "main.wac"), bump);
  wantCheck(a, bump);
}

/** Files arriving — a dropped or chosen folder, or an archive — gathered until they stop, then stored. */
async void arrivals(Page page, App a, fn<void()> bump) {
  Vec<Picked> batch = Vec.create();
  Ticket<Picked> next = page.nextFile();
  while (true) {
    if (batch.len() == 0) {
      await next;
    } else {
      Ticket<f64> quiet = page.sleep(QUIET);
      await Ticket.any(next, quiet);
      if (!next.settled()) {
        Vec<Picked> done = batch;
        batch = Vec.create();
        importBatch(page, a, done, bump);
        continue;
      }
    }
    Picked f = next.value();
    next = page.nextFile();
    if (f.ok && !ignored(f.name)) { batch.push(f); }
    a.importing = "Receiving \{batch.len()} files…";
    bump();
  }
}

async void importBatch(Page page, App a, Vec<Picked> batch, fn<void()> bump) {
  Incoming[] files = Incoming[]();
  string name = "";
  if (batch.len() == 1 && batch.get(0).name.indexOf("/") < 0) {
    // One file: an archive of a project.
    a.importing = "Opening \{batch.get(0).name}…";
    bump();
    await page.painted();
    Unpacked u = unpack(batch.get(0).bytes, batch.get(0).name);
    if (u.why != "") { a.importing = ""; a.error = u.why; bump(); return; }
    files = u.files;
    string[] paths = string[].filled(files.len(), "");
    for (i32 i = 0; i < files.len(); i++) { paths[i] = files[i].path; }
    string top = commonTop(paths);
    name = projectName(top != "" ? top : batch.get(0).name, a.projects);
  } else {
    // A folder: its files, named by their paths inside it.
    Incoming[] fs2 = Incoming[].filled(batch.len(), Incoming("", u8[]()));
    for (i32 i = 0; i < batch.len(); i++) { fs2[i] = Incoming(batch.get(i).name, batch.get(i).bytes); }
    files = fs2;
    string[] paths = string[].filled(files.len(), "");
    for (i32 i = 0; i < files.len(); i++) { paths[i] = files[i].path; }
    string top = commonTop(paths);
    name = projectName(top != "" ? top : "project", a.projects);
  }
  if (files.len() == 0) { a.importing = ""; a.error = "There was nothing to import."; bump(); return; }
  i64 t0 = await nowOf(page);
  // Passed in through fixed locals: a lambda inside an `await` that captured the reassigned ones made
  // the emitter lose a temporary (see docs/wac-wishlist.md).
  string called = name;
  i32 total = files.len();
  fn<void(i32)> progress = (i32 done) => { a.importing = "Importing \{called}: \{done} of \{total} files…"; bump(); };
  i32 n = await store(a.fs, a.home, name, files, progress);
  // The finder's index, written once rather than walked for.
  string[] paths = string[].filled(files.len(), "");
  for (i32 i = 0; i < files.len(); i++) { paths[i] = files[i].path; }
  string top = commonTop(paths);
  for (i32 i = 0; i < paths.len(); i++) { if (top != "") { paths[i] = paths[i].slice(top.len() + 1, paths[i].len()); } }
  await write(a.fs, "ide/\{name}.files", joinLines(paths).toBytes());
  a.importing = "";
  a.projects = await projects(a.fs, a.home);
  a.note = "Imported \{n} files as \{name} in \{(await nowOf(page) - t0) / 1000} s";
  await openProject(a, name, bump);
}

// ── files ───────────────────────────────────────────────────────────────────

bool binary(u8[] b) {
  if (!string.isUtf8(b)) { return true; }
  i32 n = b.len() < 8000 ? b.len() : 8000;
  for (i32 i = 0; i < n; i++) { if (b[i] == 0) { return true; } }
  return false;
}

/** Open `path` in a tab — or bring its tab forward. */
async void openFile(App a, string path, fn<void()> bump) {
  for (i32 i = 0; i < a.docs.len(); i++) {
    if (a.docs.get(i).path == path) { a.active = i; a.selected = path; a.focusSeq++; bump(); return; }
  }
  Doc d = newDoc(path);
  a.docs.push(d);
  a.active = a.docs.len() - 1;
  a.selected = path;
  a.focusSeq++;
  bump();
  Got f = await read(a.fs, path);
  if (!f.ok) { a.error = "\{rel(a, path)} could not be read: \{f.error}"; closeTab(a, a.docs.len() - 1); bump(); return; }
  if (binary(f.bytes)) {
    d.binary = true;
    d.saved = string.fromBytes(f.bytes.len() > 0 ? u8[]() : u8[]());
  } else {
    d.saved = string.fromBytes(f.bytes);
    retext(d, d.saved);
  }
  d.loaded = true;
  saveState(a);
  if (isWac(path)) { wantCheck(a, bump); }
  bump();
}

void closeTab(App a, i32 i) {
  a.docs.remove(i);
  if (a.active >= a.docs.len()) { a.active = a.docs.len() - 1; }
  else if (a.active > i) { a.active--; }
  saveState(a);
}

/** Every edit since the last flush: to the checker, and to the disk. */
async void flush(App a, fn<void()> bump) {
  bool any = false;
  for (i32 i = 0; i < a.docs.len(); i++) {
    Doc d = a.docs.get(i);
    if (!dirty(d)) { continue; }
    string text = d.text;
    if (a.check is not null) { a.check!.put(d.path, text.toBytes()); }
    string why = await write(a.fs, d.path, text.toBytes());
    if (why == "") { d.saved = text; } else { a.error = "\{rel(a, d.path)} could not be saved: \{why}"; }
    any = true;
  }
  if (any) { wantCheck(a, bump); }
  bump();
}

async void newFile(App a, string name, fn<void()> bump) {
  a.naming = false;
  if (name == "") { bump(); return; }
  string dir = a.selected;
  // A file selected means the folder it is in.
  bool isDir = a.dirs.get(dir) is not null;
  if (!isDir) { dir = parentOf(dir); }
  string path = join(dir, name);
  Got there = await read(a.fs, path);
  if (there.ok) { a.error = "\{rel(a, path)} already exists"; bump(); return; }
  string why = await write(a.fs, path, (isWac(path) ? "// \{leafOf(path)}\n" : "").toBytes());
  if (why != "") { a.error = why; bump(); return; }
  a.open.set(dir, true);
  await listDir(a, dir, bump);
  Vec<string> idx = Vec.fromArray(a.index);
  idx.push(rel(a, path));
  a.index = idx.toArray();
  write(a.fs, "ide/\{a.project}.files", joinLines(a.index).toBytes());
  await openFile(a, path, bump);
}

// ── checking ────────────────────────────────────────────────────────────────

/** Check the file in front, now if the checker is free, after the check it is doing if not. */
void wantCheck(App a, fn<void()> bump) {
  a.checkWanted = true;
  if (!a.checking) { checkLoop(a, bump); }
}

async void checkLoop(App a, fn<void()> bump) {
  if (a.check is null) { return; }
  a.checking = true;
  while (a.checkWanted) {
    a.checkWanted = false;
    Doc? d = activeDoc(a);
    string entry = (d is not null) && isWac(d!.path) ? d!.path : a.checkedEntry;
    if (entry == "") { break; }
    bump();
    Outcome o = await a.check!.run("check", entry);
    a.checkedEntry = entry;
    if (o.kind == "check") {
      a.diags = parseWire(string.fromBytes(o.bytes));
      a.checkSummary = "\{o.files} files checked in \{o.ms} ms";
    } else {
      a.diags = [Diag(entry, 1, 1, string.fromBytes(o.bytes), "", "", 1, false)];
      a.checkSummary = "could not check";
    }
    a.diagSeq++;
    bump();
  }
  a.checking = false;
  bump();
}

async void build(Page page, App a, fn<void()> bump) {
  Doc? d = activeDoc(a);
  if ((d is null) || !isWac(d!.path) || a.check is null) { return; }
  await flush(a, bump);
  a.note = "Building \{leafOf(d!.path)}…";
  bump();
  while (a.checking) { await page.sleep(50); }
  a.checking = true;
  Outcome o = await a.check!.run("build", d!.path);
  a.checking = false;
  if (o.kind == "wasm") {
    string stem = leafOf(d!.path).slice(0, leafOf(d!.path).len() - 4);
    string made = "\{o.bytes.len() / 1024} KB from \{o.files} files in \{o.ms} ms";
    if (a.desk is null) {
      page.download("\{stem}.wasm", o.bytes);
      a.note = "Built \{stem}.wasm — \{made}";
    } else {
      // **On wac's desktop the module goes beside its source**, where Files shows it and a double-click runs it.
      string out = join(parentOf(d!.path), "\{stem}.wasm");
      string why = await write(a.fs, out, o.bytes);
      if (why == "") {
        a.note = "Built \{rel(a, out)} — \{made}";
        await listDir(a, parentOf(d!.path), bump);
      } else {
        a.error = "\{rel(a, out)} could not be written: \{why}";
      }
    }
  } else {
    a.note = "";
    a.error = "\{leafOf(d!.path)} did not build: \{string.fromBytes(o.bytes)}";
  }
  wantCheck(a, bump);
  bump();
}

// ── what a name is, and where ───────────────────────────────────────────────

/** The caret came to rest at byte `at` of the file in front: say where, and ask what is there soon. */
void caretMoved(App a, i32 at, fn<void()> bump) {
  Doc? d = activeDoc(a);
  if (d is null) { return; }
  i32 line = lineAt(d!, at);
  a.caretAt = "Ln \{line}, Col \{u16Of(d!.text.slice(d!.starts[line - 1], at), at - d!.starts[line - 1]) + 1}";
  a.caretByte = at;
  if ((a.info is not null) && (a.info!.path != d!.path || at < a.info!.start || at > a.info!.end)) { a.info = null; a.infoSeq++; }
  a.caretSeq++;
  bump();
}

bool nameByte(u8 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }

/** Whether byte `at` of `text` is in or just after a name — the only places worth asking about. */
bool onName(string text, i32 at) {
  u8[] b = text.toBytes();
  return (at < b.len() && nameByte(b[at])) || (at > 0 && at <= b.len() && nameByte(b[at - 1]));
}

/** What the checker says is at byte `at` of `d` — after it has been sent what is on screen. */
async Info? askAbout(App a, Doc d, i32 at, fn<void()> bump) {
  if (a.check is null || !isWac(d.path) || !onName(d.text, at)) { return null; }
  if (dirty(d)) { await flush(a, bump); }
  Outcome o = await a.check!.run("query", "\{d.path}\t\{at}");
  if (o.kind != "query") { return null; }
  return parseInfo(d.path, string.fromBytes(o.bytes));
}

async void showInfo(App a, fn<void()> bump) {
  Doc? d = activeDoc(a);
  if (d is null) { return; }
  i32 at = a.caretByte;
  i32 seq = a.caretSeq;
  Info? i = await askAbout(a, d!, at, bump);
  // Only if the caret is still where it was asked about.
  if (seq != a.caretSeq || i is null || (i!.type == "" && i!.defPath == "")) { return; }
  a.info = i;
  a.infoSeq++;
  bump();
}

/** Go to where the name at byte `at` of the file in front is declared. */
async void goToDefinition(App a, i32 at, fn<void()> bump) {
  Doc? d = activeDoc(a);
  if (d is null) { return; }
  Info? i = await askAbout(a, d!, at, bump);
  if (i is null || i!.defPath == "") { a.note = "Nothing to go to here"; bump(); return; }
  Info info = i!;
  if (info.defPath == "core" || info.defPath == "std") {
    // Built into the compiler, so not a file of this project: what it says is shown instead.
    a.info = info;
    a.infoSeq++;
    a.note = "Declared in \{info.defPath}, which is built into wac";
    bump();
    return;
  }
  await jumpTo(a, info.defPath, info.defLine, info.defCol, bump);
  a.info = null;
  a.infoSeq++;
  bump();
}

// ── the finder ──────────────────────────────────────────────────────────────

/** How well `path` matches `q`, its letters in order: higher is better, -1 is no match. */
export i32 score(string path, string q) {
  if (q == "") { return 0; }
  u8[] p = lowerOf(path).toBytes();
  u8[] w = lowerOf(q).toBytes();
  i32 at = 0;
  i32 s = 0;
  i32 last = -2;
  i32 leaf = 0;
  for (i32 i = p.len() - 1; i >= 0; i--) { if (p[i] == '/') { leaf = i + 1; break; } }
  for (i32 i = 0; i < p.len() && at < w.len(); i++) {
    if (p[i] == w[at]) {
      s += i == last + 1 ? 5 : 1;
      if (i >= leaf) { s += 2; }
      if (i == 0 || p[i - 1] == '/' || p[i - 1] == '_' || p[i - 1] == '.') { s += 3; }
      last = i;
      at++;
    }
  }
  if (at < w.len()) { return -1; }
  return s * 100 - p.len();
}

string[] hits(App a) {
  Vec<string> out = Vec.create();
  Vec<i32> scores = Vec.create();
  for (i32 i = 0; i < a.index.len(); i++) {
    i32 s = score(a.index[i], a.query);
    if (s < 0) { continue; }
    // Kept best first, and only the best fifty.
    i32 k = out.len();
    while (k > 0 && scores.get(k - 1) < s) { k--; }
    if (k >= 50) { continue; }
    out.insert(k, a.index[i]);
    scores.insert(k, s);
    if (out.len() > 50) { out.pop(); scores.pop(); }
  }
  return out.toArray();
}

Node finder(App a, Ref field, fn<void()> bump) {
  string[] hs = hits(a);
  if (a.hit >= hs.len()) { a.hit = hs.len() - 1; }
  if (a.hit < 0) { a.hit = 0; }
  Node[] rows = Node[].filled(hs.len(), Node.Text(""));
  for (i32 i = 0; i < hs.len(); i++) {
    string p = hs[i];
    rows[i] = <div class={i == a.hit ? "hit on" : "hit"} key={p}
                   onclick={(ElementEvent e) => { a.finding = false; openFile(a, join(rootOf(a.home, a.project), p), bump); }}>
      {icon(isWac(p) ? "wac" : "file", "sm")}<span>{leafOf(p)}</span><span class="dir">{parentOf(p)}</span></div>;
  }
  return <div class="veil" onclick={(ElementEvent e) => { a.finding = false; bump(); }}>
    <div class="finder" onclick={(ElementEvent e) => { }}>
      <input class="findq" ref={field} placeholder={"Go to a file in \{a.project} (\{a.index.len()} files)"} value={a.query}
             prevent="ArrowDown ArrowUp Enter Escape"
             oninput={(ElementEvent e) => { a.query = e.value; a.hit = 0; bump(); }}
             onkeydown={(ElementEvent e) => {
               if (e.value == "ArrowDown") { a.hit++; bump(); }
               else if (e.value == "ArrowUp") { a.hit--; bump(); }
               else if (e.value == "Escape") { a.finding = false; a.focusSeq++; bump(); }
               else if (e.value == "Enter" && hs.len() > 0) { a.finding = false; openFile(a, join(rootOf(a.home, a.project), hs[a.hit]), bump); }
             }}/>
      <div class="hits">{hs.len() == 0 ? <div class="pnone">No file matches.</div> : Node.Text("")}{rows}</div>
    </div>
  </div>;
}

// ── the tree ────────────────────────────────────────────────────────────────

void treeRows(App a, string dir, i32 depth, Map<string, i32> errs, Vec<Node> out, fn<void()> bump) {
  Entry[]? kids = a.dirs.get(dir);
  if (kids is null) {
    out.push(<div class="tnode" style={"padding-left:\{depth * 14 + 26}px"}><span class="nm" style="color:var(--faint)">…</span></div>);
    return;
  }
  for (i32 i = 0; i < kids!.len(); i++) {
    Entry e = kids![i];
    string path = join(dir, e.name);
    string pad = "padding-left:\{depth * 14 + 8}px";
    if (e.isDir) {
      bool isOpen = a.open.get(path) is not null;
      out.push(<div class={"tnode" + (isOpen ? " open" : "") + (a.selected == path ? " on" : "")} key={path} style={pad} title={rel(a, path)}
                    onclick={(ElementEvent ev) => {
                      a.selected = path;
                      if (isOpen) { a.open.remove(path); } else { a.open.set(path, true); if (a.dirs.get(path) is null) { listDir(a, path, bump); } }
                      bump();
                    }}>
        <span class="tw">{icon("chev", "")}</span>{icon("folder", "sm")}<span class="nm">{e.name}</span></div>);
      if (isOpen) { treeRows(a, path, depth + 1, errs, out, bump); }
    } else {
      i32? n = errs.get(path);
      out.push(<div class={"tnode" + (a.selected == path ? " on" : "")} key={path} style={pad} title={rel(a, path)}
                    onclick={(ElementEvent ev) => { openFile(a, path, bump); }}>
        <span class="tw"></span>{icon(isWac(e.name) ? "wac" : "file", "sm")}<span class="nm">{e.name}</span>
        {n is not null ? <span class="cnt">{"\{n!}"}</span> : Node.Text("")}</div>);
    }
  }
}

// ── the workbench ───────────────────────────────────────────────────────────

Node problemsPanel(App a, fn<void()> bump) {
  Vec<Node> rows = Vec.create();
  string last = "";
  for (i32 i = 0; i < a.diags.len(); i++) {
    Diag g = a.diags[i];
    if (g.file != last) {
      last = g.file;
      rows.push(<div class="pfile">{icon(isWac(g.file) ? "wac" : "file", "sm")}{leafOf(g.file)}<span class="where">{parentOf(rel(a, g.file))}</span></div>);
    }
    rows.push(<div class={g.warning ? "prow warn" : "prow err"} key={"p\{i}"}
                   onclick={(ElementEvent e) => { jumpTo(a, g.file, g.line, g.col, bump); }}>
      {icon(g.warning ? "warn" : "alert", "sm")}<span>{g.message}</span>
      {g.note != "" ? <span class="note">{g.note}</span> : Node.Text("")}
      <span class="pos">{"\{g.line}:\{g.col}"}</span></div>);
  }
  return <div class="problems">
    <div class="phead">Problems <span class="spacer"></span>
      <button class="btn ghost" title="Hide" onclick={(ElementEvent e) => { a.problems = false; bump(); }}>{icon("close", "sm")}</button></div>
    <div class="plist">
      {a.diags.len() == 0 ? <div class="pnone">{a.checkedEntry == "" ? "Open a .wac file to check it." : "No problems in \{leafOf(a.checkedEntry)} or anything it imports."}</div> : Node.Text("")}
      {rows.toArray()}
    </div>
  </div>;
}

/** Open `path` with `line`, `col` in view and the caret on it. */
async void jumpTo(App a, string path, i32 line, i32 col, fn<void()> bump) {
  await openFile(a, path, bump);
  Doc? d = activeDoc(a);
  if (d is null || d!.path != path) { return; }
  while (!d!.loaded && a.check is not null) { await a.check!.sleep(20); }
  d!.jumpLine = line;
  d!.jumpByte = offsetOf(d!, line, col);
  d!.jumpSeq++;
  bump();
}

Node statusPill(App a, fn<void()> bump) {
  fn<void(ElementEvent)> toggle = (ElementEvent e) => { a.problems = !a.problems; bump(); };
  if (a.checking) { return <button class="status busy" onclick={toggle}>{icon("spin", "sm spin")}Checking {leafOf(a.checkedEntry == "" ? "" : a.checkedEntry)}…</button>; }
  if (a.checkedEntry == "") { return <button class="status idle" onclick={toggle}>{icon("check", "sm")}Not checked yet</button>; }
  i32 errors = errorCount(a.diags);
  i32 warnings = a.diags.len() - errors;
  if (a.diags.len() == 0) { return <button class="status ok" onclick={toggle}>{icon("check", "sm")}No problems</button>; }
  string what = errors > 0 ? (errors == 1 ? "1 error" : "\{errors} errors") : "";
  if (warnings > 0) { what = what + (what == "" ? "" : ", ") + (warnings == 1 ? "1 warning" : "\{warnings} warnings"); }
  return <button class="status bad" onclick={toggle}>{icon("alert", "sm")}{what}</button>;
}

Node workbench(Page page, App a, Ref nameRef, fn<void()> bump) {
  fn<void()> onEdit = () => {
    a.editSeq++;
    if (a.info is not null) { a.info = null; a.infoSeq++; }
    bump();
  };
  fn<void(i32)> onCaret = (i32 at) => { caretMoved(a, at, bump); };
  fn<void(i32)> onDefinition = (i32 at) => { goToDefinition(a, at, bump); };
  // How many errors each file has, for the tree.
  Map<string, i32> errs = Map.create(hashString, stringEq);
  for (i32 i = 0; i < a.diags.len(); i++) {
    if (a.diags[i].warning) { continue; }
    i32? n = errs.get(a.diags[i].file);
    errs.set(a.diags[i].file, n is null ? 1 : n! + 1);
  }
  Vec<Node> tree = Vec.create();
  treeRows(a, rootOf(a.home, a.project), 0, errs, tree, bump);
  Node[] tabs = Node[].filled(a.docs.len(), Node.Text(""));
  Node[] editors = Node[].filled(a.docs.len(), Node.Text(""));
  for (i32 i = 0; i < a.docs.len(); i++) {
    Doc d = a.docs.get(i);
    i32 at = i;
    i32? n = errs.get(d.path);
    tabs[i] = <button class={"tab" + (i == a.active ? " on" : "") + (n is not null ? " err" : "")} key={d.path} title={rel(a, d.path)}
                      onclick={(ElementEvent e) => { a.active = at; a.selected = d.path; a.focusSeq++; saveState(a); if (isWac(d.path)) { wantCheck(a, bump); } bump(); }}>
      {icon(isWac(d.path) ? "wac" : "file", "sm")}<span class="nm">{leafOf(d.path)}</span>
      {dirty(d) ? <span class="dot" title="Not saved yet"></span> : Node.Text("")}
      <span class="x" title="Close" onclick={(ElementEvent e) => { flush(a, bump); closeTab(a, at); bump(); }}>{icon("close", "sm")}</span></button>;
    Diag[] mine = inFile(a.diags, d.path);
    editors[i] = <div class={i == a.active ? "slot" : "slot hidden"} key={d.path} style="height:100%">
      <Editor doc={d} version={d.version} diags={mine} diagKey={"\{a.diagSeq}"} jumpSeq={d.jumpSeq}
              focusSeq={i == a.active ? a.focusSeq : 0} info={i == a.active ? a.info : null}
              infoKey={i == a.active ? "\{a.infoSeq}" : ""}
              onEdit={onEdit} onCaret={onCaret} onDefinition={onDefinition}/></div>;
  }
  Doc? d = activeDoc(a);
  return <>
    <div class="top">
      <span class="brand">{icon("logo", "")}</span>
      <button class="proj" title="All projects" onclick={(ElementEvent e) => { flush(a, bump); a.project = ""; saveState(a); bump(); }}>
        {icon("back", "sm")}<span>Projects /</span><b>{a.project}</b></button>
      <span class="spacer"></span>
      {statusPill(a, bump)}
      <button class="btn" title="Go to a file (Ctrl+P)" onclick={(ElementEvent e) => { a.finding = true; a.query = ""; bump(); }}>{icon("search", "sm")}Go to file</button>
      <button class="btn primary" disabled={(d is not null) && isWac(d!.path) ? null : ""} title="Compile the file in front to a .wasm module"
              onclick={(ElementEvent e) => { build(page, a, bump); }}>{icon("build", "sm")}Build</button>
    </div>
    <div class="work">
      <div class="side">
        <div class="sidehead">Files<span class="spacer"></span>
          <button class="btn ghost" title="New file in the selected folder" onclick={(ElementEvent e) => { a.naming = true; bump(); }}>{icon("plus", "sm")}</button></div>
        {a.naming ? <div class="newname"><input ref={nameRef} placeholder="name.wac — Enter to make it" prevent="Escape"
                                                onkeydown={(ElementEvent e) => { if (e.value == "Escape") { a.naming = false; bump(); } }}
                                                onchange={(ElementEvent e) => { newFile(a, e.value, bump); }}/></div> : Node.Text("")}
        <div class="tree">{tree.toArray()}</div>
      </div>
      <div class="main">
        <div class="tabs">{tabs}</div>
        <div style="position:relative;min-height:0">
          {a.docs.len() == 0 ? <div class="empty"><div>
              <div>Open a file from the tree, or go to one by name.</div>
              <div class="keys"><"kbd">Ctrl+P</"kbd"><span>go to a file</span><"kbd">Ctrl+S</"kbd"><span>save now (edits save themselves)</span></div>
            </div></div> : Node.Text("")}
          {editors}
        </div>
      </div>
    </div>
    {a.problems ? problemsPanel(a, bump) : <div></div>}
    <div class="bar">
      {a.caretAt != "" && (d is not null) ? <span>{a.caretAt}</span> : Node.Text("")}
      <span>{a.checkSummary}</span>
      {a.checkerNote != "" ? <span class="warnnote">{a.checkerNote}</span> : Node.Text("")}
      <span class="spacer"></span>
      <span>{a.persistent ? "Saved in this browser" : "Not saved: opened from a file"}</span>
    </div>
  </>;
}

// ── the projects screen ─────────────────────────────────────────────────────

Node home(App a, fn<void()> bump) {
  Node[] cards = Node[].filled(a.projects.len(), Node.Text(""));
  for (i32 i = 0; i < a.projects.len(); i++) {
    string n = a.projects[i];
    bool asking = a.confirm == n;
    cards[i] = <div class="pcard" key={n} onclick={(ElementEvent e) => { if (a.confirm == "") { openProject(a, n, bump); } }}>
      {icon("folder", "")}<span class="nm">{n}</span>
      <button class={asking ? "btn danger" : "btn ghost"} title="Delete this project from the browser"
              onclick={(ElementEvent e) => { if (asking) { a.confirm = ""; deleteProject(a, n, bump); } else { a.confirm = n; bump(); } }}>
        {icon("trash", "sm")}{asking ? "Delete for good?" : ""}</button>
    </div>;
  }
  return <div class="home"><div class="homecard">
    <div class="hero"><span class="brand">{icon("logo", "")}</span>
      <div><h1>wac IDE</h1><p>Edit wac with wac's own compiler checking as you type. Projects stay in this browser.</p></div></div>
    <div class="drop">
      <div><b>Drop a project here</b> — a folder, or a .zip or .tar.gz of one.</div>
      <p>A whole repository is fine: <span class="mono">git archive -o wac.tar.gz HEAD</span> makes one without its history.</p>
      <div class="row">
        <label class="btn">{icon("upload", "sm")}Choose a folder<"input" type="file" class="hidden" webkitdirectory=""/></label>
        <label class="btn">{icon("upload", "sm")}Choose an archive<input type="file" class="hidden pick" accept=".zip,.tar,.gz,.tgz,.zst"/></label>
        <button class="btn primary" onclick={(ElementEvent e) => { newProject(a, bump); }}>{icon("plus", "sm")}New project</button>
      </div>
      {a.importing != "" ? <div class="progress">{icon("spin", "sm spin")}{a.importing}</div> : Node.Text("")}
    </div>
    {a.projects.len() > 0 ? <div class="h2">Your projects</div> : Node.Text("")}
    <div class="plist2">{cards}</div>
  </div></div>;
}

// ── the page ────────────────────────────────────────────────────────────────

Node Ide(Ui ui, Page page) {
  App a = ui.memo<App>("", () => newApp(MemoryStore.create(page.sys.clock()).asUser("root"), false));
  auto version = ui.state(0);
  auto ready = ui.state(false);
  fn<void()> bump = () => { version.update((i32 v) => v + 1); };
  // Keys reach the app's handler only from inside it, so it takes the focus when it starts and whenever
  // a project opens — a page has no way to listen to the whole document.
  Ref root = ui.ref();
  // An element made after the page loaded is not focused by `autofocus`, so these are focused by hand.
  Ref findRef = ui.ref();
  Ref nameRef = ui.ref();
  ui.effect("\{a.finding}", () => {
    if (a.finding && findRef.element() is not null) { findRef.element()!.focus(); }
    return () => { };
  });
  ui.effect("\{a.naming}", () => {
    if (a.naming && nameRef.element() is not null) { nameRef.element()!.focus(); }
    return () => { };
  });
  ui.effect("\{ready.get()}|\{a.project}", () => {
    if (root.element() is not null && activeDoc(a) is null) { root.element()!.focus(); }
    return () => { };
  });
  ui.effect("", () => {
    begin(page, a, bump, () => { ready.set(true); });
    return () => { };
  });
  // What the name at the caret is, once the caret has rested there a moment.
  ui.effect("\{a.caretSeq}", () => {
    if (a.caretSeq == 0) { return () => { }; }
    return ui.after(450, () => { showInfo(a, bump); });
  });
  // Edits reach the checker and the disk once typing pauses.
  ui.effect("\{a.editSeq}", () => {
    if (a.editSeq == 0) { return () => { }; }
    return ui.after(SETTLE, () => { flush(a, bump); });
  });
  ui.effect("\{a.note}|\{a.error}", () => {
    if (a.note == "" && a.error == "") { return () => { }; }
    string note = a.note;
    string error = a.error;
    return ui.after(error != "" ? 9000 : 4000, () => {
      if (a.note == note) { a.note = ""; }
      if (a.error == error) { a.error = ""; }
      bump();
    });
  });
  return <div class={a.project == "" ? "app" : "app ide"} tabindex="-1" ref={root} prevent="Ctrl+p Meta+p Ctrl+s Meta+s"
              onkeydown={(ElementEvent e) => {
                bool cmd = (e.mods & (MOD_CTRL | MOD_META)) != 0;
                if (cmd && (e.value == "p" || e.value == "P") && a.project != "") { a.finding = true; a.query = ""; a.hit = 0; bump(); }
                else if (cmd && (e.value == "s" || e.value == "S")) { flush(a, bump); }
                else if (e.value == "Escape" && a.finding) { a.finding = false; bump(); }
                else if (e.value == "Escape" && a.info is not null) { a.info = null; a.infoSeq++; bump(); }
              }}>
    <style>{css()}</style>
    {!ready.get() ? <div class="home"><div class="progress">{icon("spin", "sm spin")}Starting…</div></div>
                  : (a.project == "" ? home(a, bump) : workbench(page, a, nameRef, bump))}
    {a.finding ? finder(a, findRef, bump) : Node.Text("")}
    {a.error != "" ? <div class="toast bad">{icon("alert", "sm")}<span>{a.error}</span></div>
                   : (a.note != "" ? <div class="toast">{icon("check", "sm")}<span>{a.note}</span></div> : Node.Text(""))}
  </div>;
}

/**
 * Choose the disk — the browser's storage if it is offered, memory if not — then start. **Started by wac's desktop**
 * with a folder as its argument, its projects are that folder's folders, on the desktop's disk, where Files and the
 * Terminal see them too.
 */
async void begin(Page page, App a, fn<void()> bump, fn<void()> ready) {
  string[] args = page.sys.args();
  if (args.len() > 0 && args[0] != "") { a.home = args[0]; }
  match (await Desktop.of(page.sys)) {
    Ok(d): { a.desk = d; }
    Err(why): { }
  }
  a.persistent = (await page.sys.files().mkdir(a.home, true)).isOk();
  a.fs = a.persistent ? page.sys.files() : MemoryStore.create(page.sys.clock()).asUser("root");
  if (!a.persistent) { await a.fs.mkdir(a.home, true); }
  await start(page, a, bump);
  ready();
  arrivals(page, a, bump);
}

export async i32 main(Page page) {
  page.title("wac IDE");
  page.mount((Ui ui) => <Ide page={page}/>);
  return 0;
}
