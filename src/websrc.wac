// Written by tools/websrc.py from web f474bfbdb: the `web` package the IDE is built with, for the page programs
// written in it (`webcache.wac`). Do not edit; run the script when the pin moves.

/** The repository `web` is fetched from, and the commit these are. */
export string webGit() { return "https://github.com/voltrevo/wac-web.git"; }
export string webCommit() { return "f474bfbdbbed3e51c13b1e7aa392871d0af3ed79"; }

/** Each file's path in the package, and its text. */
export string[] webPaths() { return ["wac.json5", "src/desktop.wac", "src/element.wac", "src/html.wac", "src/line.wac", "src/page.wac", "src/serve.wac", "src/site.wac", "src/tags.wac", "src/testdoc.wac", "src/view.wac"]; }

export string[] webTexts() {
  return [
    "{\n  // One module is the package: `import { Page } from \"web\"`.\n  exports: './src/page.wac',\n}\n",
    "// `wac.desktop`: what a desktop does for a program it started, asked by name.\n//\n// **A program does not know it is on a desktop until it asks** (the desktop handover's design points 3 and 4).\n// `Desktop.of(sys)` looks the capability up on the program's own host: a desktop that started it answers, and\n// anything else — a standalone page, a command line — says it has none, which is a program's cue to do without.\n// Holding a `Sys` is enough to ask, as it is to make a `Files`: no new authority.\n//\n// **A program starts with no window** (design point 2), and opens one — or several — when it wants: `openWindow` is a\n// page drawn into a new window of the desktop's, as `Page.open` is the page a host provides. A page's program built\n// by this package's builder opens its first window by opening its page, and a program with nothing to show opens\n// none.\n//\n// **More than it is handed is asked for, once** (design point 6, as the owner answered it): `askFor` names a path and\n// whether the program would change it too, the desktop asks the person, and their answer is remembered for the\n// program — the next time it starts it holds what it was allowed, and is not asked again.\n//\n// **The picker is the grant.** `pick` shows the person the desktop's files; what they choose is answered as a path\n// the program's `Files` can now read — and nothing else it could not before. So is `newFile`: a free name on the\n// desktop, which the program may write and nothing beside it. `open` shows a path in the desktop's app for it, and\n// `edit` in its editor; `note` says something in the desktop's own voice; `copy` and `paste` are the desktop's clipboard,\n// which is text.\n//\n// Each request's fields, as `line.wac` gives `wac.page`'s. The desktop answers every request, `note` and `copy`\n// included, since only what a program asks reaches a parent: a `host.tell` goes to the program's own host.\n\nimport { Answer, FAULT_NONE, OP_CAPABILITY, Sys, ask } from \"std\";\nimport { Result, Ticket } from \"core\";\nimport { PAGE_CAPABILITY, PAGE_WINDOW, PageLine } from \"./line.wac\";\nimport { Page } from \"./page.wac\";\n\nexport string DESKTOP_CAPABILITY() { return \"wac.desktop\"; }\nexport string DESKTOP_VERSION() { return \"1.0.0\"; }\n\n/** `text` what the person is choosing for → `text` the path chosen; `flags` 1 when they chose nothing. */\nexport static i32 DESKTOP_PICK = 0;\n/**\n * `text` a path the program may read → shown in the desktop's app for it — `a` 1: as text, in its editor; a fault\n * when it may not.\n */\nexport static i32 DESKTOP_OPEN = 1;\n/** `text`: said in the desktop's note. */\nexport static i32 DESKTOP_NOTE = 2;\n/** `text`: put on the desktop's clipboard. */\nexport static i32 DESKTOP_COPY = 3;\n/** → `text`: what is on the desktop's clipboard. */\nexport static i32 DESKTOP_PASTE = 4;\n/**\n * `text` a title → a window of the program's own: `n` which of its windows it is. The window's page is that window's\n * slice of `wac.page` — `PAGE_WINDOW` requests from the capability's base, times `n` — which `openWindow` makes.\n */\nexport static i32 DESKTOP_WINDOW = 5;\n/**\n * `text` a path, `a` 1 to change what is there too → `flags` 0 when the program may from now on, 1 when not. The\n * desktop asks the person once and remembers their answer for this program.\n */\nexport static i32 DESKTOP_ASK = 6;\n/**\n * `text` a name → `text` a path on the desktop for a new file of that name — or the first free name like it — which\n * the program may write from now on. Nothing is there until it writes it.\n */\nexport static i32 DESKTOP_NEW = 7;\n/** How many request numbers the capability takes. */\nexport static i32 DESKTOP_COUNT = 8;\n\n/** The desktop that started this program: its host, and where the capability's numbers start on it. */\nexport struct Desktop {\n  Sys sys;\n  i32 base;\n\n  /** The desktop, if the program's host is one; `Err` says why not — run anywhere else, there is none. */\n  async Result<Desktop, string> of(Sys sys) {\n    Answer found = await ask(sys.host, OP_CAPABILITY(), 0 as i64, 0 as i64, DESKTOP_CAPABILITY(), \"^1\".toBytes());\n    if (found.fault != FAULT_NONE()) { return Result.Err(found.text); }\n    return Result.Ok(Desktop(sys, found.n as~ i32));\n  }\n\n  Ticket<Answer> ask(this, i32 op, string text) {\n    return ask(this.sys.host, this.base + op, 0 as i64, 0 as i64, text, u8[]());\n  }\n\n  /**\n   * Ask the person to choose a file, saying what for. The path they chose — which this program's files can read\n   * from now on — or `Err` when they chose nothing.\n   */\n  async Result<string, string> pick(this, string what) {\n    Answer a = await this.ask(DESKTOP_PICK, what);\n    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }\n    if (a.flags == 1) { return Result.Err(\"nothing was chosen\"); }\n    return Result.Ok(a.text);\n  }\n\n  /** Show `path` in the desktop's app for it. `Err` when this program may not read it. */\n  async Result<void, string> open(this, string path) {\n    Answer a = await this.ask(DESKTOP_OPEN, path);\n    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }\n    return Result.Ok();\n  }\n\n  /** Show `path` as text, in the desktop's editor. `Err` when this program may not read it. */\n  async Result<void, string> edit(this, string path) {\n    Answer a = await ask(this.sys.host, this.base + DESKTOP_OPEN, 1 as i64, 0 as i64, path, u8[]());\n    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }\n    return Result.Ok();\n  }\n\n  /**\n   * Somewhere on the desktop for a new file named `name`: its path, which this program may write from now on — the\n   * name as asked, or the first free one like it. `Err` saying why not.\n   */\n  async Result<string, string> newFile(this, string name) {\n    Answer a = await this.ask(DESKTOP_NEW, name);\n    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }\n    return Result.Ok(a.text);\n  }\n\n  /** Say `text` in the desktop's note. */\n  void note(this, string text) { this.ask(DESKTOP_NOTE, text); }\n\n  /** Put `text` on the desktop's clipboard. */\n  void copy(this, string text) { this.ask(DESKTOP_COPY, text); }\n\n  /** What is on the desktop's clipboard. */\n  async string paste(this) { return (await this.ask(DESKTOP_PASTE, \"\")).text; }\n\n  /**\n   * Ask to read `path` — and to change what is there too, when `write`. The person is asked once; `Ok` when the\n   * program may from now on, `Err` saying why not.\n   */\n  async Result<void, string> askFor(this, string path, bool write) {\n    Answer a = await ask(this.sys.host, this.base + DESKTOP_ASK, (write ? 1 : 0) as i64, 0 as i64, path, u8[]());\n    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }\n    if (a.flags != 0) { return Result.Err(a.text == \"\" ? \"not allowed\" : a.text); }\n    return Result.Ok();\n  }\n\n  /**\n   * A new window of this program's own, titled `title`: the page drawn into it, which renders itself from here on\n   * (`Page.keepRendering`). `Err` when the desktop has no window to give.\n   */\n  async Result<Page, string> openWindow(this, string title) {\n    // `wac.page` looked up first, which is what routes a window's requests to the desktop at all.\n    Answer page = await ask(this.sys.host, OP_CAPABILITY(), 0 as i64, 0 as i64, PAGE_CAPABILITY(), \"^1\".toBytes());\n    if (page.fault != FAULT_NONE()) { return Result.Err(page.text); }\n    Answer w = await this.ask(DESKTOP_WINDOW, title);\n    if (w.fault != FAULT_NONE()) { return Result.Err(w.text); }\n    i32 base = (page.n as~ i32) + (w.n as~ i32) * PAGE_WINDOW;\n    Page p = Page.over(PageLine.of(this.sys.host, base, page.flags), this.sys);\n    p.title(title);\n    p.keepRendering();\n    return Result.Ok(p);\n  }\n}\n",
    "// A handle to one element of the page, and the authority over everything under it.\n//\n// **Holding an `Element` is the right to change that element and its subtree, and to hear their events\n// — nothing above it or beside it** (`design/system/0012`). `page.root()` hands a program the root; a\n// child made through a handle comes back as a handle; passing one to a widget is a grant, as passing\n// `Sys` is. There is no `querySelector`, no `parentNode`, no `innerHTML`, and no page-wide string that\n// names an element.\n//\n// **The program mints the handles.** A handle is a number this side chooses, and the document records\n// the element it made under it — so making and changing elements never waits. Each change is a `wac.page`\n// request nobody answers (`line.wac`), sent as it is made; a host batches them as it likes. Only reads\n// wait, and each is a ticket.\n//\n// **A handle lives as long as its element is in the tree.** `remove` ends it and every handle under it,\n// and a call on an ended handle traps saying which. The program keeps a mirror — parents and children,\n// no attributes — which is what makes ending a subtree possible, and what tells the document when a\n// handle can be forgotten.\n//\n// **Policy is here, and the browser enforces it again.** `attr` refuses an `on…` name, a name outside\n// `[a-z][a-z0-9-]*`, and `javascript:` in a URL attribute; `append` refuses the elements that run or\n// load something on their own. The build writes a Content Security Policy as well, so a page with no\n// network grant cannot send anything anywhere even if this were wrong.\n\nimport { Queue, Ticket, Vec } from \"core\";\nimport { Answer } from \"std\";\nimport { Happened, PageLine, happenedOf, when } from \"./line.wac\";\n\n/** What the document does with an event of a kind, decided before any event happens. */\nexport struct Listen {\n  /**\n   * The keys whose default the document prevents, for a key event — `\"Tab ArrowUp ArrowDown\"` — or\n   * `\"*\"` for every event of the kind, or `\"\"` for none. A worker learns of an event after the browser\n   * has acted on it, so this cannot be decided per event.\n   *\n   * **A key may name its modifiers**: `\"Ctrl+s Ctrl+l\"` prevents those and not a plain `s` or `l`. A key\n   * with modifiers matches only when exactly those are held, of `Ctrl`, `Alt`, `Shift` and `Meta`; a key\n   * without them matches whatever is held, as it always has. A single letter matches either case. The\n   * handler tells the two apart by `ElementEvent.mods`.\n   */\n  string prevent;\n\n  Listen none() { return Listen(\"\"); }\n  Listen all() { return Listen(\"*\"); }\n  Listen keys(string names) { return Listen(names); }\n}\n\n/** Something that happened on an element. */\nexport struct ElementEvent {\n  /** What was listened for: `\"click\"`, `\"input\"`, `\"keydown\"`… */\n  string kind;\n  /** The handle it happened on: the listener or something under it. */\n  Element target;\n  /**\n   * An input's value for `input` and `change`; the key for a key event, as the browser names it; for `wheel`, how far\n   * it turned, in whole pixels down (`\"-120\"` is up); for `resize`, the device's pixels to a CSS pixel.\n   */\n  string value;\n  /**\n   * Where the pointer is, in the pixels of the element that listened — not of whatever smaller element\n   * it is over — for a pointer event; 0 otherwise. A canvas's are its backing store's. For `resize`, which a\n   * program listens for with `Element.on`, the element's width and height on screen, in the device's pixels.\n   */\n  i32 x;\n  i32 y;\n  /** The modifier keys held, as `MOD_*` bits from `page.wac`. */\n  i32 mods;\n  /**\n   * **Where the caret is**, in a text field the event happened in — an `<input>` or a `<textarea>` — as the\n   * field's `selectionStart` and `selectionEnd`, equal when nothing is selected; -1 for an element that has\n   * none. Counted as the browser counts, in UTF-16 code units, not bytes.\n   *\n   * Read when the event happens, so a `keydown` sees the caret before the key acts and a `keyup`, `input`\n   * or `click` sees it after.\n   */\n  i32 selStart;\n  i32 selEnd;\n  /**\n   * **When it happened**: in milliseconds by the page's clock (`Page.now`), as the browser stamped it — before it\n   * crossed to the program. `page.now() - e.at` is how long it took to arrive, and a game measures from it how long a\n   * key takes to show.\n   */\n  f64 at;\n}\n\n/** Every live handle, by id, and what the program has seen. */\nexport struct Elements {\n  /** Where the changes go, and the events come from. */\n  PageLine line;\n  /** Each handle by its number; ended ones are null. Index 0 is the root. */\n  Vec<Element?> byId;\n  /** The number of the last event delivered to the program — what `prop` measures typing against. */\n  i32 seen;\n  /** Settled when the host says no more events will come: the page was closed (`Page.closed`). */\n  Ticket<bool> ended;\n\n  /** The handles over `line`, the root among them, hearing the document's events from here on. */\n  Elements create(PageLine line) {\n    Vec<Element?> byId = Vec.create();\n    Ticket<bool> ended;\n    Elements es = Elements(line, byId, 0, ended);\n    Element root = Element.made(es, 0, \"\", null);\n    byId.push(root);\n    es.follow();\n    return es;\n  }\n\n  /**\n   * **One event asked for at a time**, and the next asked for once it is delivered: the host keeps what\n   * happens meanwhile, and a host that never answers — a page with no document — is never called back.\n   */\n  void follow(this) {\n    Elements es = this;\n    Ticket<Answer> t = this.line.event();\n    when(t, () => {\n      // **A fault is the host saying there will be no more**: a desktop's window that was closed. Nothing is\n      // asked again, and whoever waits on the page's end hears of it.\n      if (t.value().fault != 0) {\n        if (!es.ended.settled()) { es.ended.resolve(true); }\n        return;\n      }\n      Happened h = happenedOf(t.value());\n      es.deliver(h.seq, h.kind, h.target, h.listener, h.value, h.x, h.y, h.mods, h.selStart, h.selEnd, h.at);\n      es.follow();\n    });\n  }\n\n  Element root(this) { return this.byId.get(0)!; }\n\n  i32 mint(this) {\n    this.byId.push(null);\n    return this.byId.len() - 1;\n  }\n\n  /**\n   * An event from the document: `kind` on `targetId`, heard by the listener on `listenerId`, numbered\n   * `seq`. One on a handle the program has already ended is dropped — a late click cannot reach a row\n   * that is gone.\n   */\n  void deliver(this, i32 seq, string kind, i32 targetId, i32 listenerId, string value, i32 x, i32 y, i32 mods,\n               i32 selStart, i32 selEnd, f64 at) {\n    if (seq > this.seen) { this.seen = seq; }\n    if (listenerId < 0 || listenerId >= this.byId.len() || targetId < 0 || targetId >= this.byId.len()) { return; }\n    Element? l = this.byId.get(listenerId);\n    Element? t = this.byId.get(targetId);\n    if (l is null || t is null) { return; }\n    l!.heard(ElementEvent(kind, t!, value, x, y, mods, selStart, selEnd, at));\n  }\n}\n\n/** One element, as far as this handle reaches. */\nexport struct Element {\n  Elements es;\n  i32 id;\n  /** The element's tag, or `\"\"` for a text node. */\n  string tag;\n  Element? parent;\n  /** The children made through handles, in document order: the mirror. */\n  Vec<Element> kids;\n  bool live;\n  /** The kinds listened for, and how. */\n  Vec<string> kinds;\n  /** A handler per kind, beside `kinds` — for one listened for with `listen`, the queue `next()` reads. */\n  Vec<fn<void(ElementEvent)>> handlers;\n  /** Events that arrived while nothing waited, and the tickets `next()` handed out. */\n  Queue<ElementEvent> arrived;\n  Queue<Ticket<ElementEvent>> waiting;\n\n  Element made(Elements es, i32 id, string tag, Element? parent) {\n    Vec<Element> kids = Vec.create();\n    Vec<string> kinds = Vec.create();\n    Vec<fn<void(ElementEvent)>> handlers = Vec.create();\n    Queue<ElementEvent> arrived;\n    Queue<Ticket<ElementEvent>> waiting;\n    return Element(es, id, tag, parent, kids, true, kinds, handlers, arrived, waiting);\n  }\n\n  void alive(this, string what) {\n    if (!this.live) { trap \"Element.\" + what + \": handle \" + \"\\{this.id}\" + \" was removed\"; }\n  }\n\n  // ── Children ───────────────────────────────────────────────────────────────\n\n  /** A child element, last. */\n  Element append(this, string tag) { return this.insert(tag, null); }\n\n  /** A child element before `before`, which must be a child of this one; last when null. */\n  Element insert(this, string tag, Element? before) {\n    this.alive(\"insert\");\n    if (this.tag == \"\" && this.id != 0) { trap \"Element.insert: a text node has no children\"; }\n    refuseTag(\"Element.append\", tag);\n    i32 at = this.positionOf(before, \"insert\");\n    Element e = Element.made(this.es, this.es.mint(), tag, this);\n    this.es.byId.set(e.id, e);\n    this.place(e, at);\n    this.es.line.make(e.id, this.id, tag, before is null ? -1 : before!.id);\n    return e;\n  }\n\n  /**\n   * **A shadow root on this element: a page of its own inside it.** What is made under the handle it answers is drawn\n   * in this element, and a stylesheet there applies there and nowhere else — in neither direction, so the page\n   * around it cannot restyle what is inside, and what is inside cannot restyle the page around it. For a program\n   * that draws another program's page into one of its elements: a desktop's window, served by `PageServer`.\n   *\n   * Asked of an element by this program, never by a page it serves: `#shadow` is no element name, so `PageServer`\n   * refuses it from a child as it refuses any other.\n   */\n  Element shadow(this) {\n    this.alive(\"shadow\");\n    if (this.tag == \"\" && this.id != 0) { trap \"Element.shadow: a text node has no shadow root\"; }\n    Element e = Element.made(this.es, this.es.mint(), \"#shadow\", this);\n    this.es.byId.set(e.id, e);\n    this.es.line.make(e.id, this.id, \"#shadow\", -1);\n    return e;\n  }\n\n  /** A text child the program can change later, last, or before `before`. */\n  Element appendText(this, string text) { return this.insertText(text, null); }\n\n  Element insertText(this, string text, Element? before) {\n    this.alive(\"insertText\");\n    i32 at = this.positionOf(before, \"insertText\");\n    Element e = Element.made(this.es, this.es.mint(), \"\", this);\n    this.es.byId.set(e.id, e);\n    this.place(e, at);\n    this.es.line.makeText(e.id, this.id, text, before is null ? -1 : before!.id);\n    return e;\n  }\n\n  /** Replace everything under this element with text — ending every handle under it — or set a text node's. */\n  void text(this, string s) {\n    this.alive(\"text\");\n    for (i32 i = 0; i < this.kids.len(); i++) { this.kids.get(i).end(); }\n    this.kids.clear();\n    this.es.line.text(this.id, s);\n  }\n\n  /** Move this element before `before` within its parent, or last when null. */\n  void move(this, Element? before) {\n    this.alive(\"move\");\n    if (this.parent is null) { trap \"Element.move: the root has no parent\"; }\n    Element p = this.parent!;\n    i32 from = p.indexOfKid(this);\n    p.kids.remove(from);\n    i32 at = p.positionOf(before, \"move\");\n    p.place(this, at);\n    this.es.line.move(this.id, before is null ? -1 : before!.id);\n  }\n\n  /** Remove this element and everything under it; every handle there ends. */\n  void remove(this) {\n    this.alive(\"remove\");\n    if (this.parent is null) { trap \"Element.remove: the root cannot be removed\"; }\n    Element p = this.parent!;\n    p.kids.remove(p.indexOfKid(this));\n    this.end();\n    this.es.line.remove(this.id);\n  }\n\n  // ── What it is ─────────────────────────────────────────────────────────────\n\n  /** Set attribute `name`, or remove it with `null`. */\n  void attr(this, string name, string? value) {\n    this.alive(\"attr\");\n    refuseAttr(\"Element.attr\", name, value);\n    this.es.line.attr(this.id, name, value ?? \"\", value is not null);\n  }\n\n  /** Set a property: `value`, `checked` (`\"true\"`/`\"false\"`) or `selected`. */\n  void prop(this, string name, string value) {\n    this.alive(\"prop\");\n    if (name != \"value\" && name != \"checked\" && name != \"selected\") {\n      trap \"Element.prop: \" + name + \" is not a property this sets — value, checked or selected\";\n    }\n    this.es.line.prop(this.id, name, value, this.es.seen);\n  }\n\n  /**\n   * Select `start` to `end` of this text field — the caret alone, when they are equal — counted as\n   * `ElementEvent.selStart` is. Like a `value` set by a render, it does not land if the user has typed here\n   * since the last event the program saw: a caret moved by a program behind the typing would put the next\n   * keystroke in the wrong place.\n   */\n  void select(this, i32 start, i32 end) {\n    this.alive(\"select\");\n    this.es.line.select(this.id, start, end, this.es.seen);\n  }\n\n  /**\n   * Type `text` into this text field at its caret, replacing what is selected — as the browser would for a\n   * keystroke, so it joins the field's undo history and an `input` event follows. Setting `value` instead wipes\n   * that history, which is why an editor's Tab uses this.\n   *\n   * Like `select`, it does not land over typing the program has not seen: typed after a key the user pressed\n   * later, it would arrive in the wrong place. So a program typing for a key it intercepted can lose that key\n   * when the user types on faster than the page answers, and never misplaces it. Where the browser can do the\n   * key itself — Enter — let it, and type only what follows.\n   */\n  void typeText(this, string text) {\n    this.alive(\"typeText\");\n    this.es.line.typeText(this.id, text, this.es.seen);\n  }\n\n  void focus(this) {\n    this.alive(\"focus\");\n    this.es.line.focus(this.id);\n  }\n\n  /** Scroll the page until this element's top is at the top of the window, as far as it will go. */\n  void scrollIntoView(this) {\n    this.alive(\"scrollIntoView\");\n    this.es.line.scroll(this.id, \"\");\n  }\n\n  /**\n   * Scroll to the element under this one whose `id` attribute is `named` — a heading a link named, which\n   * the program drew but holds no handle to. Nothing happens when there is none. Only this element's\n   * subtree is searched, so this names nothing a handle to the element did not already reach.\n   */\n  void scrollToId(this, string named) {\n    this.alive(\"scrollToId\");\n    if (named == \"\") { trap \"Element.scrollToId: an empty name names nothing — scrollIntoView scrolls to the element itself\"; }\n    this.es.line.scroll(this.id, named);\n  }\n\n  /** Draw `rgba` — `w` by `h`, four bytes a pixel, row by row — as all of this canvas, sized to match. */\n  void pixels(this, i32 w, i32 h, u8[] rgba) {\n    this.drawable(\"pixels\", w, h, rgba);\n    this.es.line.pixels(this.id, w, h, rgba);\n  }\n\n  /**\n   * Draw `rgba`, `w` by `h`, into this canvas with its corner at `x`, `y`; the rest stays as it was. Each of\n   * the four is 0 to 65535, which is what `PAGE_PIXELS_IN` carries.\n   */\n  void pixelsIn(this, i32 x, i32 y, i32 w, i32 h, u8[] rgba) {\n    this.drawable(\"pixelsIn\", w, h, rgba);\n    if (x < 0 || y < 0 || x > 65535 || y > 65535 || w > 65535 || h > 65535) {\n      trap \"Element.pixelsIn: \\{x},\\{y} \\{w}x\\{h} — each is 0 to 65535\";\n    }\n    this.es.line.pixelsIn(this.id, x, y, w, h, rgba);\n  }\n\n  void drawable(this, string what, i32 w, i32 h, u8[] rgba) {\n    this.alive(what);\n    if (this.tag != \"canvas\") { trap \"Element.\" + what + \": a \" + this.tag + \" is not a canvas\"; }\n    if (w < 0 || h < 0 || rgba.len() != w * h * 4) {\n      trap \"Element.\" + what + \": \\{rgba.len()} bytes is not \\{w}x\\{h} pixels\";\n    }\n  }\n\n  /** The element's value as the document has it now — a round trip, so a ticket. */\n  Ticket<string> value(this) {\n    this.alive(\"value\");\n    Ticket<string> t;\n    Ticket<Answer> a = this.es.line.value(this.id);\n    when(a, () => { t.resolve(a.value().text); });\n    return t;\n  }\n\n  // ── Events ─────────────────────────────────────────────────────────────────\n\n  /** Deliver `kind` events from this element and everything under it, to be taken with `next()`. */\n  void listen(this, string kind, Listen how) {\n    Element me = this;\n    this.on(kind, how, (ElementEvent e) => { me.queue(e); });\n  }\n\n  /** Deliver `kind` events from this element and everything under it to `handler`. */\n  void on(this, string kind, Listen how, fn<void(ElementEvent)> handler) {\n    this.alive(\"listen\");\n    for (i32 i = 0; i < this.kinds.len(); i++) {\n      if (this.kinds.get(i) == kind) { this.handlers.set(i, handler); return; }\n    }\n    this.kinds.push(kind);\n    this.handlers.push(handler);\n    this.es.line.listen(this.id, kind, how.prevent);\n  }\n\n  /** The next event listened for with `listen`, as a ticket. */\n  Ticket<ElementEvent> next(this) {\n    Ticket<ElementEvent> t;\n    if (this.arrived.len() > 0) { t.resolve(this.arrived.pop()!); } else { this.waiting.push(t); }\n    return t;\n  }\n\n  void heard(this, ElementEvent e) {\n    for (i32 i = 0; i < this.kinds.len(); i++) {\n      if (this.kinds.get(i) == e.kind) {\n        this.handlers.get(i)(e);\n        return;\n      }\n    }\n  }\n\n  /** An event for `next()`: the oldest waiter takes it, or it waits for one. */\n  void queue(this, ElementEvent e) {\n    if (this.waiting.len() > 0) { this.waiting.pop()!.resolve(e); } else { this.arrived.push(e); }\n  }\n\n  // ── The mirror ─────────────────────────────────────────────────────────────\n\n  bool isLive(const this) { return this.live; }\n  Element? parentOf(this) { return this.parent; }\n  i32 kidCount(this) { return this.kids.len(); }\n  Element kidAt(this, i32 i) { return this.kids.get(i); }\n\n  i32 indexOfKid(this, Element k) {\n    for (i32 i = 0; i < this.kids.len(); i++) { if (this.kids.get(i) is k) { return i; } }\n    trap \"Element: a child the mirror does not hold\";\n  }\n\n  i32 positionOf(this, Element? before, string what) {\n    if (before is null) { return this.kids.len(); }\n    if (before!.parent is null || before!.parent! is not this) {\n      trap \"Element.\" + what + \": the element to go before is not a child of this one\";\n    }\n    return this.indexOfKid(before!);\n  }\n\n  void place(this, Element e, i32 at) {\n    if (at >= this.kids.len()) { this.kids.push(e); } else { this.kids.insert(at, e); }\n  }\n\n  void end(this) {\n    this.live = false;\n    this.es.byId.set(this.id, null);\n    for (i32 i = 0; i < this.kids.len(); i++) { this.kids.get(i).end(); }\n  }\n}\n\n// ── Policy ───────────────────────────────────────────────────────────────────\n\nbool lowerName(string s, bool colon) {\n  u8[] b = s.toBytes();\n  if (b.len() == 0 || b[0] < 'a' || b[0] > 'z') { return false; }\n  for (i32 i = 1; i < b.len(); i++) {\n    u8 c = b[i];\n    bool ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || (colon && c == ':');\n    if (!ok) { return false; }\n  }\n  return true;\n}\n\n/** The elements that run or load something on their own, which a page makes through no handle. */\nexport bool runsOnItsOwn(string tag) {\n  return tag == \"script\" || tag == \"iframe\" || tag == \"object\" || tag == \"embed\" || tag == \"base\"\n      || tag == \"meta\" || tag == \"link\" || tag == \"frame\" || tag == \"frameset\" || tag == \"applet\"\n      || tag == \"portal\";\n}\n\n/**\n * Why a page may not make element `tag`, or `\"\"` when it may. **Words rather than a trap**, for whoever is asked by\n * someone else — a host answering a child's `wac.page`, which must refuse a child's mistake and go on.\n */\nexport string whyNotTag(string tag) {\n  if (!lowerName(tag, false)) { return tag + \" is not an element name — [a-z][a-z0-9-]*\"; }\n  if (runsOnItsOwn(tag)) { return \"a page cannot make a \" + tag + \" element\"; }\n  return \"\";\n}\n\n/** Trap, naming `who` — the call refusing — unless `tag` is an element a page may make. */\nexport void refuseTag(string who, string tag) {\n  string why = whyNotTag(tag);\n  if (why != \"\") { trap who + \": \" + why; }\n}\n\n/** The attributes whose value is a URL a browser follows. */\nexport bool urlAttr(string name) {\n  return name == \"href\" || name == \"src\" || name == \"action\" || name == \"formaction\" || name == \"xlink:href\"\n      || name == \"poster\" || name == \"data\" || name == \"cite\" || name == \"background\";\n}\n\n/** Whether a URL runs script when followed: `javascript:`, in any case, after any leading spaces and controls. */\nexport bool scriptUrl(string v) {\n  u8[] b = v.toBytes();\n  i32 i = 0;\n  while (i < b.len() && b[i] <= ' ') { i++; }\n  string want = \"javascript:\";\n  u8[] w = want.toBytes();\n  i32 k = 0;\n  while (i < b.len() && k < w.len()) {\n    u8 c = b[i];\n    // Tabs and newlines inside the scheme are stripped by a URL parser, so they do not hide it.\n    if (c == '\\t' || c == '\\n' || c == '\\r') { i++; continue; }\n    u8 lc = c >= 'A' && c <= 'Z' ? c + 32 : c;\n    if (lc != w[k]) { return false; }\n    i++;\n    k++;\n  }\n  return k == w.len();\n}\n\n/** Why a page may not set attribute `name` to `value`, or `\"\"` when it may — `whyNotTag`'s companion. */\nexport string whyNotAttr(string name, string? value) {\n  if (!lowerName(name, true)) { return name + \" is not an attribute name — [a-z][a-z0-9-]*\"; }\n  if (name.len() >= 2 && name.slice(0, 2) == \"on\") { return name + \" — a handler is listened for, not written\"; }\n  if (name == \"srcdoc\") { return \"srcdoc writes a document\"; }\n  if (value is not null && urlAttr(name) && scriptUrl(value!)) { return name + \" is a javascript: URL\"; }\n  return \"\";\n}\n\n/** Trap, naming `who`, unless `name` set to `value` is an attribute a page may write. */\nexport void refuseAttr(string who, string name, string? value) {\n  string why = whyNotAttr(name, value);\n  if (why != \"\") { trap who + \": \" + why; }\n}\n",
    "// A static HTML tree: what markup builds when its tags come from here, and the text a browser parses.\n//\n// **A library, not the language** (`design/lang/0017`). Markup names no type: a tag calls a function in\n// scope, and its children are that function's `kids` element type, which builds text, quoted tags and\n// fragments itself through `core`'s `markup` symbols. This tree is one such type; the view's, with handlers\n// and components, is another (`design/system/0012`), and a module gets whichever its tags were imported\n// from.\n//\n// The tags are `tags.wac`, which the package exports as the namespace `html`: `import { html.div } from\n// \"web\"` brings in one and `<div>` calls it.\n\nimport { Buf, markup } from \"core\";\nimport { ElementEvent, refuseAttr, refuseTag } from \"./element.wac\";\nimport { Ref, Ui } from \"./view.wac\";\n\nexport struct Attr {\n  string name;\n  string value;\n}\n\n// **`Fragment` is a variant rather than an element with an empty tag**, so that a renderer is\n// *told*: `match` is exhaustive, and a walk written before fragments existed stops compiling with\n// the arm it is missing named. An empty tag would have rendered as `<>` in every renderer that had\n// not heard of them. `design/lang/0006`.\n/**\n * A handler on an element: the kind of event, the defaults the document prevents for it (`Listen`'s\n * spelling — `\"Tab ArrowUp\"`, `\"*\"` or `\"\"`), and what runs. Written into a page as nothing at all.\n */\nexport struct On {\n  string kind;\n  string prevent;\n  fn<void(ElementEvent)> run;\n}\n\n// **An element may carry a `Ref`**, which the view points at the element it made for it (`view.wac`);\n// `htmlOf` makes no element and leaves it alone.\n//\n// **A component is a node too** — what a tag naming a component builds (`design/lang/0017`): its\n// function's name, its `key`, a closure drawing it, its attributes' snapshots and a test of them. The\n// view keeps an instance per one (`view.wac`); `htmlOf` draws it once, with hooks that hold their first\n// values.\nexport enum Node {\n  Element(string tag, Attr[] attrs, On[] on, Node[] kids, Ref? ref),\n  Text(string text),\n  Fragment(Node[] kids),\n  Component(string name, string? key, fn<Node(Ui)> draw, anyref snaps, fn<bool(anyref)> same),\n\n  Node [markup.text](string text) { return Node.Text(text); }\n  Node [markup.fragment](Node[] kids) { return Node.Fragment(kids); }\n  Node [markup.element](string tag, string[] names, string[] values, Node[] kids) {\n    Attr[] attrs = Attr[].filled(names.len(), Attr(\"\", \"\"));\n    for (i32 i = 0; i < names.len(); i++) { attrs[i] = Attr(names[i], values[i]); }\n    return Node.Element(tag, attrs, On[](), kids, null);\n  }\n}\n\n// ── As HTML ───────────────────────────────────────────────────────────────────\n//\n// **Everything is escaped**: text and attribute values are data, never markup, so a string that happens\n// to hold `<script>` arrives as those characters. **And the handle layer's policy holds here too**\n// (`element.wac`): a tag or attribute name outside `[a-z][a-z0-9-]*`, an `on*` attribute, a\n// `javascript:` URL and an element that runs on its own all trap. Escaping alone left\n// `Attr(\"onerror\", \"…\")` and a tag spelled `\"img src=x onerror=… x\"` writing script into any page made of it.\n//\n// **A `<style>` is the one exception, because its text is not HTML**: the browser reads it as CSS up to\n// the first `</style`, and escaping `>` would break every child combinator in it. So its text goes out as\n// it is, with each `<` written as CSS's own escape for it, `\\3c ` — which no stylesheet needs to spell\n// literally, and which is what makes `</style>` inside one impossible.\n\n/** `n` as HTML. */\nexport string htmlOf(Node n) {\n  Buf out = Buf.create();\n  writeNode(out, n, false);\n  return string.fromBytes(out.take());\n}\n\nvoid writeNode(Buf out, Node n, bool css) {\n  match (n) {\n    Text(t): {\n      if (css) { writeCss(out, t); } else { writeEscaped(out, t, false); }\n    }\n    Fragment(kids): {\n      for (Node k in kids) { writeNode(out, k, css); }\n    }\n    // A component is what it draws — drawn here once, its hooks holding their first values.\n    Component(name, key, draw, snaps, same): {\n      writeNode(out, draw(Ui.made(null, name, key, draw, snaps, same)), css);\n    }\n    Element(tag, attrs, on, kids, ref): {\n      refuseTag(\"htmlOf\", tag);\n      out.pushStr(\"<\");\n      out.pushStr(tag);\n      for (Attr a in attrs) {\n        // `key` names a node among its siblings for the view, and is not an attribute of the element.\n        if (a.name == \"key\") { continue; }\n        refuseAttr(\"htmlOf\", a.name, a.value);\n        out.pushStr(\" \");\n        out.pushStr(a.name);\n        out.pushStr(\"=\\\"\");\n        writeEscaped(out, a.value, true);\n        out.pushStr(\"\\\"\");\n      }\n      out.pushStr(\">\");\n      // A void element has no content and no end tag: `<br></br>` is two line breaks to a browser.\n      if (isVoidElement(tag)) { return; }\n      for (Node k in kids) { writeNode(out, k, tag == \"style\"); }\n      out.pushStr(\"</\");\n      out.pushStr(tag);\n      out.pushStr(\">\");\n    }\n  }\n}\n\n/**\n * `s` with what would be read as markup replaced by references: `&` and `<` always, `>` too, and in\n * an attribute value the `\"` that would end it.\n */\nvoid writeEscaped(Buf out, string s, bool inAttr) {\n  u8[] b = s.toBytes();\n  for (u8 c in b) {\n    if (c == '&') { out.pushStr(\"&amp;\"); }\n    else if (c == '<') { out.pushStr(\"&lt;\"); }\n    else if (c == '>') { out.pushStr(\"&gt;\"); }\n    else if (inAttr && c == '\"') { out.pushStr(\"&quot;\"); }\n    else { out.push(c); }\n  }\n}\n\n/** A stylesheet's text as it is, except `<`, written as CSS's escape for it so nothing can end the element. */\nvoid writeCss(Buf out, string s) {\n  u8[] b = s.toBytes();\n  for (u8 c in b) {\n    if (c == '<') { out.pushStr(\"\\\\3c \"); } else { out.push(c); }\n  }\n}\n\n// ── As a document ────────────────────────────────────────────────────────────\n//\n// **For a builder writing a page ahead of time** — a static site, which runs nothing in the browser.\n// `htmlOf` refuses `meta`, `link` and `script` because what a *program* draws must not load or run\n// anything; a document's head is exactly those, and it is the builder's, written from fields rather\n// than from a tree, so the tree's policy still holds over everything in the body.\n\n/** What goes in a document's head. An empty string, or an empty list, leaves its element out. */\nexport struct Head {\n  string title;\n  string description;\n  /** The Content Security Policy, as the `content` of its `meta`. */\n  string policy;\n  /** Stylesheets, by URL. */\n  string[] styles;\n  /** Scripts, by URL — never inline, so a policy can allow them as `'self'` — each deferred. */\n  string[] scripts;\n  string icon;\n}\n\n/** `body` as a whole document under `head`: a doctype, the head, and `htmlOf(body)`. */\nexport string documentOf(Head head, Node body) {\n  Buf out = Buf.create();\n  out.pushStr(\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n\");\n  out.pushStr(\"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\");\n  if (head.policy != \"\") { metaTag(out, \"http-equiv\", \"Content-Security-Policy\", head.policy); }\n  out.pushStr(\"<title>\");\n  writeEscaped(out, head.title, false);\n  out.pushStr(\"</title>\\n\");\n  if (head.description != \"\") { metaTag(out, \"name\", \"description\", head.description); }\n  if (head.icon != \"\") { linkTag(out, \"icon\", head.icon); }\n  for (string s in head.styles) { linkTag(out, \"stylesheet\", s); }\n  for (string s in head.scripts) {\n    refuseAttr(\"documentOf\", \"src\", s);\n    out.pushStr(\"<script src=\\\"\");\n    writeEscaped(out, s, true);\n    out.pushStr(\"\\\" defer></script>\\n\");\n  }\n  out.pushStr(\"</head>\\n<body>\\n\");\n  writeNode(out, body, false);\n  out.pushStr(\"\\n</body>\\n</html>\\n\");\n  return string.fromBytes(out.take());\n}\n\nvoid metaTag(Buf out, string kind, string name, string content) {\n  out.pushStr(\"<meta \" + kind + \"=\\\"\" + name + \"\\\" content=\\\"\");\n  writeEscaped(out, content, true);\n  out.pushStr(\"\\\">\\n\");\n}\n\nvoid linkTag(Buf out, string rel, string href) {\n  refuseAttr(\"documentOf\", \"href\", href);\n  out.pushStr(\"<link rel=\\\"\" + rel + \"\\\" href=\\\"\");\n  writeEscaped(out, href, true);\n  out.pushStr(\"\\\">\\n\");\n}\n\n/** The HTML elements that cannot have content (the \"void elements\" of the HTML standard). */\nexport bool isVoidElement(string tag) {\n  return tag == \"area\" || tag == \"base\" || tag == \"br\" || tag == \"col\" || tag == \"embed\" || tag == \"hr\"\n      || tag == \"img\" || tag == \"input\" || tag == \"link\" || tag == \"meta\" || tag == \"source\"\n      || tag == \"track\" || tag == \"wbr\";\n}\n",
    "// `wac.page`: a page as requests to a host, and the program's end of them.\n//\n// **A page is a capability, not a thing the program is built around** (the desktop handover's design point 5).\n// A program finds it by name — `capability(host, \"wac.page\", \"^1\")` — and is answered with a range of request\n// numbers, one per operation below. Whoever answers them draws: a standalone page's host into the document\n// (`tools/build.wac`), a desktop into one of its windows, a test into records (`testdoc.wac`). The program\n// cannot tell which, and the same module runs under all three.\n//\n// **Changes wait for nothing, and travel together.** They are held and sent as one `PAGE_BATCH` — at the end of the\n// program's turn, and before anything the program asks, so a read sees every change made before it — and the\n// host answers the batch at once. One request a turn rather than one a change, which is what a page in a desktop's\n// window costs most, its requests crossing to the desktop; and a request, not a `host.tell`, because only what a\n// program asks is routed to a parent that provides the capability. A host that wants each change as it is made —\n// a test, reading the document after every call — says so in its answer to the lookup (`PAGE_ONE_AT_A_TIME`), and\n// is sent each change as a request nobody answers. **Everything that comes back is an answer** to a request the\n// program made: an element's value, the next event, the next frame, the next file handed over, the next change of\n// location. The program keeps one request outstanding for each stream (`Elements.follow`, `Page.follow`), and\n// asks again when it is answered — so a host never calls a program that did not ask, and a host that never\n// answers, which is what a page with no document is, costs nothing.\n//\n// **The clock and timers are not here.** They are `std`'s (`OP_MONOTONIC_NANOS`, `OP_SLEEP_MILLIS`), which every\n// host answers itself: a program in a desktop's window sleeps on its own host, not through the desktop.\n//\n// Each operation's fields, in `a`, `b`, `text` and `bytes`. A handle is an `i32` in `a`'s low half; an operation\n// that must not land over typing the program has not seen (`prop`, `select`, `typeText`) carries the number of\n// the last event the program saw in `a`'s high half. Two `i32`s in one field are `pair(high, low)`.\n\nimport { Answer, Host, ask } from \"std\";\nimport { Buf, Ticket, TicketBase, Vec } from \"core\";\n\n/** The capability's name, and the version this package speaks. */\nexport string PAGE_CAPABILITY() { return \"wac.page\"; }\nexport string PAGE_VERSION() { return \"1.3.0\"; }\n\n/** `a` handle, `b` pair(parent, before — -1 for last), `text` tag. */\nexport static i32 PAGE_MAKE = 0;\n/** `a` handle, `b` pair(parent, before), `text` the text. */\nexport static i32 PAGE_MAKE_TEXT = 1;\n/** `a` handle, `text`: everything under it replaced with text, or a text node's text. */\nexport static i32 PAGE_TEXT = 2;\n/** `a` handle, `b` 1 to set and 0 to remove, `text` name, `bytes` value. */\nexport static i32 PAGE_ATTR = 3;\n/** `a` pair(seen, handle), `text` name — `value`, `checked` or `selected` — `bytes` value. */\nexport static i32 PAGE_PROP = 4;\n/** `a` handle, `b` the handle to go before, -1 for last. */\nexport static i32 PAGE_MOVE = 5;\n/** `a` handle: it and everything under it go, and their handles with them. */\nexport static i32 PAGE_REMOVE = 6;\n/** `a` handle, `text` kind, `bytes` the defaults to prevent (`Listen.prevent`). */\nexport static i32 PAGE_LISTEN = 7;\n/** `a` handle. */\nexport static i32 PAGE_FOCUS = 8;\n/** `a` handle → `text`: its value as the document has it now. */\nexport static i32 PAGE_VALUE = 9;\n/** `a` handle, `b` pair(w, h), `bytes` rgba: all of a canvas, sized to match. */\nexport static i32 PAGE_PIXELS = 10;\n/** `a` handle, `b` four 16-bit fields x, y, w, h from the top, `bytes` rgba: a corner of a canvas. */\nexport static i32 PAGE_PIXELS_IN = 11;\n/** `a` handle, `text` the `id` attribute of an element under it to scroll to, or `\"\"` for the element itself. */\nexport static i32 PAGE_SCROLL = 12;\n/** `a` pair(seen, handle), `b` pair(start, end): a text field's selection. */\nexport static i32 PAGE_SELECT = 13;\n/** `a` pair(seen, handle), `text`: typed into a text field at its caret. */\nexport static i32 PAGE_TYPE_TEXT = 14;\n/** `text`: the page's title. */\nexport static i32 PAGE_TITLE = 15;\n/** `text`: a line for the console. */\nexport static i32 PAGE_LOG = 16;\n/** `text` name, `bytes`: offered to the user as a file. */\nexport static i32 PAGE_DOWNLOAD = 17;\n/**\n * → the next event on an element the program listens to: `n` pair(listener, target), `m` pair(x, y), `flags` the\n * modifier bits, `text` the value, `bytes` twenty bytes — the event's number, the caret's start and end, each a\n * little-endian `i32`, and when it happened, in microseconds by the page's clock, a little-endian `i64` — then the\n * kind.\n */\nexport static i32 PAGE_EVENT = 18;\n/** → the next file the user hands over: `text` its name, `bytes` its contents — or, with `flags` 1, why it could not be read. */\nexport static i32 PAGE_FILE = 19;\n/** → nothing, before the next paint. */\nexport static i32 PAGE_FRAME = 20;\n/** `text` the location the program knows → `text` the location, once it is not that: the hash, without its `#`. */\nexport static i32 PAGE_LOCATION = 21;\n/**\n * `a` how many changes, `bytes` each of them — the operation's number as a byte, `a` and `b` as eight bytes each,\n * then `text` and `bytes` each as a four-byte length and that many bytes, all little-endian — to be done in order.\n * → nothing, at once. What `PageLine.flush` sends, and `batchOf` reads.\n */\nexport static i32 PAGE_BATCH = 22;\n/**\n * `a` the sound's number, `b` its sample rate, `bytes` its samples — one channel, each a little-endian `i16`: a sound\n * the page can play from now on, kept until the page is gone. Sent once, played as often as the program likes.\n */\nexport static i32 PAGE_SOUND = 23;\n/**\n * `a` pair(voice, sound), `b` pair(volume in thousandths, 1 to loop and 0 to play once): the sound, playing as that\n * voice. A voice's number is the program's to choose, as a handle's is. `bytes`, when there are any, are two\n * little-endian `f64`s: when to start, in milliseconds by the page's clock (`Page.now`) — 0, or a time gone, for now\n * — and how far into the sound, in seconds. Voices started for the same moment start together, to the sample.\n */\nexport static i32 PAGE_PLAY = 24;\n/** `a` the voice: stopped, if it is still playing. */\nexport static i32 PAGE_STOP = 25;\n/** `a` the voice, `b` pair(volume in thousandths, milliseconds to get there): its volume, changed smoothly. */\nexport static i32 PAGE_GAIN = 26;\n/**\n * `text` a location — the hash, without its `#` — and `a` 1 to add it to the browser's history, so Back returns from\n * it, or 0 to take the place of the location there is. The program hears it as any new location (`PAGE_LOCATION`).\n */\nexport static i32 PAGE_GO = 27;\n/** How many request numbers the capability takes. */\nexport static i32 PAGE_COUNT = 28;\n/**\n * **How far apart a desktop's windows' slices of `wac.page` are**: more than `PAGE_COUNT`, so a request added later\n * does not move every window but the first — a program and the desktop it runs in are built separately, and each\n * finds its windows' requests where the other put them for as long as both agree on this.\n */\nexport static i32 PAGE_WINDOW = 64;\n\n/** In the `flags` of the host's answer to the lookup: send each change as it is made, not batched. */\nexport static i32 PAGE_ONE_AT_A_TIME = 1;\n\n/**\n * Run `f` once `t` has settled — now, if it has. **`whenSettled` alone never runs for a ticket already settled**, and\n * a host may answer inside the request that asked: the browser's host answers a location at once, and a\n * `PageServer` an event it already heard. Waited for with `whenSettled`, those answers were never heard.\n *\n * **Over `TicketBase`, not generic**: as `when<T>`, the lambdas handed to it were ones the compiler could not yet type\n * in a module as large as a desktop's, and the desktop stopped building (\"a lambda in a position the walk does not\n * type yet\") while every page here still built.\n */\nexport void when(TicketBase t, fn<void()> f) {\n  if (t.settled()) {\n    f();\n    return;\n  }\n  t.whenSettled(f);\n}\n\n/** Two `i32`s in one `i64`: `high` in the top half. */\nexport i64 pair(i32 high, i32 low) { return ((high as i64) << 32) | ((low as i64) & (4294967295 as i64)); }\n// `as@` keeps the bits: a half that was -1 comes back -1, where `as~` would give the nearest `i32` to 4294967295.\nexport i32 highOf(i64 v) { return (v >> 32) as@ i32; }\nexport i32 lowOf(i64 v) { return v as@ i32; }\n\n/** An `f64` as eight little-endian bytes at `at` — `PAGE_PLAY`'s when and how far in. */\nexport void putF64(u8[] b, i32 at, f64 v) {\n  u64 bits = f64.toBits(v);\n  for (i32 k = 0; k < 8; k++) { b[at + k] = ((bits >> (((8 * k) as i64) as@ u64)) & (255 as u64)) as@ u8; }\n}\n\nexport f64 getF64(u8[] b, i32 at) {\n  u64 bits = 0 as u64;\n  for (i32 k = 0; k < 8; k++) { bits = bits | ((b[at + k] as u64) << (((8 * k) as i64) as@ u64)); }\n  return f64.fromBits(bits);\n}\n\n/** Four 16-bit fields in one `i64`, `x` at the top — `PAGE_PIXELS_IN`'s corner and size. */\nexport i64 quad(i32 x, i32 y, i32 w, i32 h) {\n  return ((x as i64) << 48) | ((y as i64) << 32) | ((w as i64) << 16) | (h as i64);\n}\nexport i32 quadAt(i64 v, i32 k) { return ((v >> ((48 - 16 * k) as i64)) & (65535 as i64)) as~ i32; }\n\n/** Something that happened on an element, as the document said it. */\nexport struct Happened {\n  i32 seq;\n  string kind;\n  i32 target;\n  i32 listener;\n  string value;\n  i32 x;\n  i32 y;\n  i32 mods;\n  i32 selStart;\n  i32 selEnd;\n  /** When it happened, in milliseconds by the page's clock (`Page.now`). */\n  f64 at;\n}\n\nvoid putI32(u8[] b, i32 at, i32 v) {\n  for (i32 k = 0; k < 4; k++) { b[at + k] = ((v >> (8 * k)) & 255) as~ u8; }\n}\n\ni32 getI32(u8[] b, i32 at) {\n  i32 v = 0;\n  for (i32 k = 0; k < 4; k++) { v = v | ((b[at + k] as i32) << (8 * k)); }\n  return v;\n}\n\n/** An event as `PAGE_EVENT` answers it — for a host written in wac, which is a desktop or a test. */\nexport Answer eventAnswer(Happened h) {\n  u8[] kind = h.kind.toBytes();\n  u8[] b = u8[].filled(20 + kind.len(), 0 as u8);\n  putI32(b, 0, h.seq);\n  putI32(b, 4, h.selStart);\n  putI32(b, 8, h.selEnd);\n  i64 micros = (h.at * 1000.0) as~ i64;\n  putI32(b, 12, lowOf(micros));\n  putI32(b, 16, highOf(micros));\n  b.copyFrom(kind, 0, 20, kind.len());\n  return Answer(0, h.value, b, pair(h.listener, h.target), pair(h.x, h.y), h.mods);\n}\n\n/** `PAGE_EVENT`'s answer read back. A short one is a host's mistake, and reads as an event nobody listens to. */\nexport Happened happenedOf(Answer a) {\n  if (a.bytes.len() < 20) { return Happened(0, \"\", 0 - 1, 0 - 1, \"\", 0, 0, 0, 0 - 1, 0 - 1, 0.0); }\n  u8[] k = u8[].filled(a.bytes.len() - 20, 0 as u8);\n  k.copyFrom(a.bytes, 20, 0, k.len());\n  string kind = string.fromBytes(k);\n  i64 micros = pair(getI32(a.bytes, 16), getI32(a.bytes, 12));\n  return Happened(getI32(a.bytes, 0), kind, lowOf(a.n), highOf(a.n), a.text, highOf(a.m), lowOf(a.m), a.flags,\n                  getI32(a.bytes, 4), getI32(a.bytes, 8), (micros as~ f64) / 1000.0);\n}\n\n/** One change, as a batch carries it. */\nexport struct Change {\n  i32 op;\n  i64 a;\n  i64 b;\n  string text;\n  u8[] bytes;\n}\n\nvoid putI64(Buf b, i64 v) {\n  b.pushU32(lowOf(v) as@ u32);\n  b.pushU32(highOf(v) as@ u32);\n}\n\ni64 getI64(u8[] b, i32 at) { return pair(getI32(b, at + 4), getI32(b, at)); }\n\n/** A `PAGE_BATCH`'s changes, in order — for a host written in wac. One cut short ends the list where it stops. */\nexport Change[] batchOf(u8[] bytes) {\n  Vec<Change> out = Vec.create();\n  i32 at = 0;\n  while (at + 21 <= bytes.len()) {\n    i32 op = bytes[at] as i32;\n    i64 a = getI64(bytes, at + 1);\n    i64 b = getI64(bytes, at + 9);\n    i32 tlen = getI32(bytes, at + 17);\n    if (tlen < 0 || at + 21 + tlen + 4 > bytes.len()) { break; }\n    u8[] t = u8[].filled(tlen, 0 as u8);\n    t.copyFrom(bytes, at + 21, 0, tlen);\n    i32 blen = getI32(bytes, at + 21 + tlen);\n    i32 from = at + 25 + tlen;\n    if (blen < 0 || from + blen > bytes.len()) { break; }\n    u8[] body = u8[].filled(blen, 0 as u8);\n    body.copyFrom(bytes, from, 0, blen);\n    out.push(Change(op, a, b, string.fromBytes(t), body));\n    at = from + blen;\n  }\n  return out.toArray();\n}\n\n/** The program's end of `wac.page`: the host, where the capability's numbers start, and the changes held. */\nexport struct PageLine {\n  Host host;\n  i32 base;\n  /** Whether changes are held and sent together; false for a host that answered `PAGE_ONE_AT_A_TIME`. */\n  bool batched;\n  Buf held;\n  i32 count;\n  /** Told when a change is held and none was before — so whoever ends the turn knows one has something to send. */\n  fn<void()>? onHeld;\n\n  /** The line to the capability that starts at `base` on `host`, as the host's answer to the lookup asked (`flags`). */\n  PageLine of(Host host, i32 base, i32 flags) {\n    return PageLine(host, base, (flags & PAGE_ONE_AT_A_TIME) == 0, Buf.create(), 0, null);\n  }\n\n  void tell(this, i32 op, i64 a, i64 b, string text, u8[] bytes) {\n    if (!this.batched) {\n      this.host.tell(this.base + op, a, b, text, bytes);\n      return;\n    }\n    this.held.push(op as@ u8);\n    putI64(this.held, a);\n    putI64(this.held, b);\n    u8[] t = text.toBytes();\n    this.held.pushU32(t.len() as@ u32);\n    this.held.pushAll(t);\n    this.held.pushU32(bytes.len() as@ u32);\n    this.held.pushAll(bytes);\n    this.count++;\n    if (this.count == 1 && this.onHeld is not null) { this.onHeld!(); }\n  }\n\n  /** Send what is held, as one batch. Nothing, when nothing is. */\n  void flush(this) {\n    if (this.count == 0) { return; }\n    u8[] bytes = this.held.bytes();\n    i32 n = this.count;\n    this.held = Buf.create();\n    this.count = 0;\n    ask(this.host, this.base + PAGE_BATCH, n as i64, 0 as i64, \"\", bytes);\n  }\n\n  /** Ask, once every change made before it has gone. */\n  Ticket<Answer> ask(this, i32 op, i64 a, i64 b, string text, u8[] bytes) {\n    this.flush();\n    return ask(this.host, this.base + op, a, b, text, bytes);\n  }\n\n  void make(this, i32 id, i32 parent, string tag, i32 before) { this.tell(PAGE_MAKE, id as i64, pair(parent, before), tag, u8[]()); }\n  void makeText(this, i32 id, i32 parent, string text, i32 before) {\n    this.tell(PAGE_MAKE_TEXT, id as i64, pair(parent, before), text, u8[]());\n  }\n  void text(this, i32 id, string text) { this.tell(PAGE_TEXT, id as i64, 0 as i64, text, u8[]()); }\n  void attr(this, i32 id, string name, string value, bool present) {\n    this.tell(PAGE_ATTR, id as i64, (present ? 1 : 0) as i64, name, value.toBytes());\n  }\n  void prop(this, i32 id, string name, string value, i32 seen) { this.tell(PAGE_PROP, pair(seen, id), 0 as i64, name, value.toBytes()); }\n  void move(this, i32 id, i32 before) { this.tell(PAGE_MOVE, id as i64, before as i64, \"\", u8[]()); }\n  void remove(this, i32 id) { this.tell(PAGE_REMOVE, id as i64, 0 as i64, \"\", u8[]()); }\n  void listen(this, i32 id, string kind, string prevent) { this.tell(PAGE_LISTEN, id as i64, 0 as i64, kind, prevent.toBytes()); }\n  void focus(this, i32 id) { this.tell(PAGE_FOCUS, id as i64, 0 as i64, \"\", u8[]()); }\n  void pixels(this, i32 id, i32 w, i32 h, u8[] rgba) { this.tell(PAGE_PIXELS, id as i64, pair(w, h), \"\", rgba); }\n  void pixelsIn(this, i32 id, i32 x, i32 y, i32 w, i32 h, u8[] rgba) { this.tell(PAGE_PIXELS_IN, id as i64, quad(x, y, w, h), \"\", rgba); }\n  void scroll(this, i32 id, string named) { this.tell(PAGE_SCROLL, id as i64, 0 as i64, named, u8[]()); }\n  void select(this, i32 id, i32 start, i32 end, i32 seen) { this.tell(PAGE_SELECT, pair(seen, id), pair(start, end), \"\", u8[]()); }\n  void typeText(this, i32 id, string text, i32 seen) { this.tell(PAGE_TYPE_TEXT, pair(seen, id), 0 as i64, text, u8[]()); }\n  void title(this, string t) { this.tell(PAGE_TITLE, 0 as i64, 0 as i64, t, u8[]()); }\n  void go(this, string where, bool push) { this.tell(PAGE_GO, (push ? 1 : 0) as i64, 0 as i64, where, u8[]()); }\n  void log(this, string line) { this.tell(PAGE_LOG, 0 as i64, 0 as i64, line, u8[]()); }\n  void download(this, string name, u8[] bytes) { this.tell(PAGE_DOWNLOAD, 0 as i64, 0 as i64, name, bytes); }\n  void sound(this, i32 id, i32 rate, u8[] samples) { this.tell(PAGE_SOUND, id as i64, rate as i64, \"\", samples); }\n  void play(this, i32 voice, i32 sound, i32 thousandths, bool loop) {\n    this.tell(PAGE_PLAY, pair(voice, sound), pair(thousandths, loop ? 1 : 0), \"\", u8[]());\n  }\n  void stop(this, i32 voice) { this.tell(PAGE_STOP, voice as i64, 0 as i64, \"\", u8[]()); }\n  void playAt(this, i32 voice, i32 sound, i32 thousandths, bool loop, f64 at, f64 offset) {\n    u8[] when = u8[].filled(16, 0 as u8);\n    putF64(when, 0, at);\n    putF64(when, 8, offset);\n    this.tell(PAGE_PLAY, pair(voice, sound), pair(thousandths, loop ? 1 : 0), \"\", when);\n  }\n  void gain(this, i32 voice, i32 thousandths, i32 ms) { this.tell(PAGE_GAIN, voice as i64, pair(thousandths, ms), \"\", u8[]()); }\n\n  Ticket<Answer> value(this, i32 id) { return this.ask(PAGE_VALUE, id as i64, 0 as i64, \"\", u8[]()); }\n  Ticket<Answer> event(this) { return this.ask(PAGE_EVENT, 0 as i64, 0 as i64, \"\", u8[]()); }\n  Ticket<Answer> file(this) { return this.ask(PAGE_FILE, 0 as i64, 0 as i64, \"\", u8[]()); }\n  Ticket<Answer> frame(this) { return this.ask(PAGE_FRAME, 0 as i64, 0 as i64, \"\", u8[]()); }\n  Ticket<Answer> location(this, string known) { return this.ask(PAGE_LOCATION, 0 as i64, 0 as i64, known, u8[]()); }\n}\n",
    "// A web page, as a wac program sees it: `export async i32 main(Page page)`.\n//\n// **What a page shows is elements the program holds** (`design/system/0012`). `page.root()` is the\n// handle to everything the program draws (`element.wac`), and `page.mount(draw)` puts a view over it —\n// components that are functions of `Ui`, rendering only what changed (`view.wac`). What belongs to the\n// page rather than to an element is here: its title, the clock, timers and frames, files the user hands\n// over, a download, sound, and `page.sys`, what the build granted.\n//\n// **The program is an `async` function, and nothing blocks.** It waits for what happens later — a timer,\n// a frame, a file, an element's value, an event on an element it listens to — with `await`; each `await`\n// hands control back, and the host calls back in when something arrives. Nothing is shared, so a built\n// page needs nothing from the server that serves it.\n//\n// **A page is the `wac.page` capability** (`line.wac`): every change is a request to the program's host, and\n// everything that comes back — an event, a frame, a file, a value, a new location — is the answer to one.\n// Whoever answers them draws: a standalone page's host into the document, a desktop into a window, a test\n// into records. `Page.open(sys)` finds the capability on the program's own host, so the same program runs\n// under any of them, and one with no page to draw into is told so rather than started.\n//\n// **Where it runs is the host's choice, not the program's.** A standalone page's program runs in a worker\n// by default, so a program that computes for a long time costs its own responsiveness and not the tab's; on\n// the page's own thread with `--in-page`. Nothing here can tell.\n//\n// **A page's program is a module like any other** (`tools/build.wac`'s `moduleFor`): a `main(Sys sys)` that opens\n// the page, runs the program's `main(Page page)`, and renders each time a view has something to render\n// (`changed`, then `turn`). Its host runs it on as answers arrive, as it runs every program, and the render waits\n// behind what the program was doing, so it comes once a handler is done rather than in the middle of one.\n//\n// **A test runs it on by hand** (`TestDoc`): with this page as the schedule target (spec ch35), each machine that\n// suspends hands its continuation to `take`, which attaches it to the ticket it waits on; an answer settles the\n// ticket and runs the program on, there and then, and `drain` and `turn` finish the turn.\n\nimport { Continuation, Queue, Result, Ticket, TicketBase, Vec } from \"core\";\nimport { Answer, FAULT_NONE, OP_CAPABILITY, OP_MONOTONIC_NANOS, OP_SLEEP_MILLIS, Sys, ask } from \"std\";\nimport { Node, htmlOf } from \"./html.wac\";\nimport { Element, Elements } from \"./element.wac\";\nimport { PAGE_CAPABILITY, PageLine, when } from \"./line.wac\";\nimport { Ui, View } from \"./view.wac\";\n\n// The tree, its tags, the handles and the view are this package's too, so a page imports everything from\n// `\"web\"` (`design/system/0012`).\nexport { Attr, Head, Node, On, documentOf, htmlOf, isVoidElement } from \"./html.wac\";\nexport * as html from \"./tags.wac\";\nexport { Element, ElementEvent, Listen } from \"./element.wac\";\n// `wac.page` itself, for whoever answers it — a desktop drawing a program into a window, or a test.\nexport { PAGE_BATCH, PAGE_CAPABILITY, PAGE_ONE_AT_A_TIME, PAGE_VERSION, Change, batchOf, PAGE_MAKE, PAGE_MAKE_TEXT, PAGE_TEXT, PAGE_ATTR, PAGE_PROP, PAGE_MOVE, PAGE_REMOVE, PAGE_LISTEN, PAGE_FOCUS, PAGE_VALUE, PAGE_PIXELS, PAGE_PIXELS_IN,\n         PAGE_SCROLL, PAGE_SELECT, PAGE_TYPE_TEXT, PAGE_TITLE, PAGE_LOG, PAGE_DOWNLOAD, PAGE_EVENT, PAGE_FILE, PAGE_FRAME, PAGE_LOCATION, PAGE_SOUND, PAGE_PLAY, PAGE_STOP, PAGE_GAIN, PAGE_GO, PAGE_COUNT, PAGE_WINDOW, Happened, PageLine, eventAnswer, happenedOf, highOf, lowOf, pair, putF64, getF64, quad, quadAt, when } from \"./line.wac\";\nexport { Mounted, Ref, State, Ui, View } from \"./view.wac\";\nexport { TestDoc, TestNode } from \"./testdoc.wac\";\n// `wac.page` answered into an element this program holds — a desktop drawing a program into a window.\nexport { PageServer } from \"./serve.wac\";\n// `wac.desktop`, for a program a desktop started: `Desktop.of(sys)`.\nexport { DESKTOP_CAPABILITY, DESKTOP_COPY, DESKTOP_COUNT, DESKTOP_NOTE, DESKTOP_OPEN, DESKTOP_PASTE, DESKTOP_PICK,\n         DESKTOP_VERSION, DESKTOP_WINDOW, DESKTOP_ASK, DESKTOP_NEW, Desktop } from \"./desktop.wac\";\n// `wac.site`: the site a page was served from, read a file at a time, or mounted read-only as files.\nexport { SITE_CAPABILITY, SITE_COUNT, SITE_GET, SITE_VERSION, Site, siteFiles } from \"./site.wac\";\n\n\n/** `ElementEvent.mods`: which modifier keys were held. */\nexport static i32 MOD_SHIFT = 1;\nexport static i32 MOD_CTRL = 2;\nexport static i32 MOD_ALT = 4;\nexport static i32 MOD_META = 8;\n\n/** A file the user handed over — chosen with an `<input type=\"file\">`, or dropped on the page. */\nexport struct Picked {\n  bool ok;\n  /**\n   * Its name — or, for a file inside a folder the user handed over, its path from that folder down:\n   * `photos/2024/a.jpg`. A folder dropped on the page, or chosen with `<input type=\"file\"\n   * webkitdirectory>`, arrives as one `Picked` per file in it; the folder itself never arrives.\n   */\n  string name;\n  u8[] bytes;\n  /** Why it could not be read, when `ok` is false. */\n  string error;\n}\n\n/** A page: what the program is handed. */\nexport struct Page {\n  /** Where the page's requests go: the program's host, and the capability's numbers on it. */\n  PageLine line;\n  /** Where the program's suspended machines wait, and how they are run on. */\n  Runner runner;\n  /** Every handle the program holds, the root among them. */\n  Elements es;\n  /** The views mounted, rendered at the end of every call into the program. */\n  Vec<View> views;\n  /**\n   * **What the host granted** (`design/system/0012`): the files, clock, randomness and output a page's\n   * program has — the `Sys` its module was started with, as a command-line program's is. A standalone page's\n   * host grants what the build said (`--grant read,write`) and refuses the rest, naming the flag. Its host is\n   * the one the page's requests go to.\n   */\n  Sys sys;\n  /**\n   * **A development build's check** (`--dev`): after every turn each view renders everything again and\n   * logs each place the page does not show what its components render (`View.check`).\n   */\n  bool checking;\n  /**\n   * **Where the reader is**: the document's location hash, without its `#` — `\"/spec/strings\"` for\n   * `…#/spec/strings`. Asked for when the page opens, and again after each change (`follow`); a link\n   * written `href=\"#/spec\"` changes it, and so do the browser's back and forward.\n   */\n  string at;\n  /** Who hears each change of `at`, by slot; a stopped watcher's slot is null. */\n  Vec<fn<void(string)>?> watchers;\n  /** Whether a view has had something to render since `changed` last answered, and who waits to hear it. */\n  bool woken;\n  Ticket<void>? waking;\n  /** The last number given a sound or a voice: each is the page's own, numbered as handles are. */\n  i32 played;\n\n  /**\n   * **The page the program's host provides**, found by name: `Err` says why there is none — a program run\n   * from a command line has no page, and is told so rather than handed one that draws nowhere.\n   */\n  async Result<Page, string> open(Sys sys) {\n    // `capability` asked by hand, which is what it does, for the answer's `flags`: how the host wants the changes.\n    Answer found = await ask(sys.host, OP_CAPABILITY(), 0 as i64, 0 as i64, PAGE_CAPABILITY(), \"^1\".toBytes());\n    if (found.fault != FAULT_NONE()) { return Result.Err(found.text); }\n    return Result.Ok(Page.over(PageLine.of(sys.host, found.n as~ i32, found.flags), sys));\n  }\n\n  /**\n   * **Settled when the page is closed** — a window of a desktop's, closed by the person or the desktop — and never\n   * for a standalone page. A program with several windows forgets this one then; one with only this has ended.\n   */\n  Ticket<bool> closed(this) { return this.es.ended; }\n\n  /** A page over `line`, whose host is `sys`'s, following the document's events and location from here on. */\n  Page over(PageLine line, Sys sys) {\n    Vec<View> views = Vec.create();\n    Vec<fn<void(string)>?> watchers = Vec.create();\n    Page p = Page(line, Runner.create(), Elements.create(line), views, sys, false, \"\", watchers, false, null, 0);\n    // A change held is a turn to end, whether or not a view has anything to render: a handler that only changed an\n    // element of its own still has that change to send.\n    line.onHeld = () => { p.wake(); };\n    p.follow();\n    return p;\n  }\n\n  /** **The location, asked for again each time it is answered**: the host answers once it is not `at`. */\n  void follow(this) {\n    Page page = this;\n    Ticket<Answer> t = this.line.location(this.at);\n    when(t, () => {\n      string hash = t.value().text;\n      page.at = hash.len() > 0 && hash[0] == \"#\" ? hash.slice(1, hash.len()) : hash;\n      for (i32 i = 0; i < page.watchers.len(); i++) {\n        fn<void(string)>? w = page.watchers.get(i);\n        if (w is not null) { w!(page.at); }\n      }\n      page.follow();\n    });\n  }\n\n  /**\n   * The page's root element: the authority over everything the program shows. Children made through it\n   * come back as handles, and holding one is the right to change that element and hear its events.\n   */\n  Element root(this) { return this.es.root(); }\n\n  /**\n   * Render `draw` into the root and keep it rendered: a component of no attributes, whose state and whose\n   * children's state the view watches (`view.wac`). The view owns the root's children from here on.\n   */\n  View mount(this, fn<Node(Ui)> draw) { return this.mountIn(this.root(), draw); }\n\n  /** The same, into one element the program holds — a widget's own corner of the page. */\n  View mountIn(this, Element host, fn<Node(Ui)> draw) {\n    Page page = this;\n    View v = View.create(host, (i32 ms, fn<void()> f) => { when(page.sleep(ms), f); });\n    v.onDirty = () => { page.wake(); };\n    this.views.push(v);\n    v.mount(draw);\n    return v;\n  }\n\n  /**\n   * **Settles once a view has something to render** — at once, if one has since this last answered. What runs a\n   * page as a module awaits it and calls `turn`: the wait is queued behind whatever the program was doing, so the\n   * render comes once the program has run on, not in the middle of a handler.\n   */\n  Ticket<void> changed(this) {\n    Ticket<void> t;\n    if (this.woken) {\n      this.woken = false;\n      t.settleWith(() => { });\n      return t;\n    }\n    this.waking = t;\n    return t;\n  }\n\n  void wake(this) {\n    Ticket<void>? w = this.waking;\n    if (w is null) {\n      this.woken = true;\n      return;\n    }\n    this.waking = null;\n    w!.settleWith(() => { });\n  }\n\n  /**\n   * **Render each time a view has something to render, for as long as the page lives** — what runs a page's program\n   * as a module does (`tools/build.wac`'s `moduleFor`), and `Desktop.openWindow` for each window it opens.\n   */\n  async void keepRendering(this) {\n    this.turn();\n    while (true) {\n      await this.changed();\n      this.turn();\n    }\n  }\n\n  /** The end of a call into the program: every view renders what changed, and the changes go to the host. */\n  void turn(this) {\n    for (i32 i = 0; i < this.views.len(); i++) { this.views.get(i).turn(); }\n    if (this.checking) {\n      for (i32 i = 0; i < this.views.len(); i++) {\n        string[] said = this.views.get(i).check();\n        for (i32 j = 0; j < said.len(); j++) { this.line.log(\"view check: \" + said[j]); }\n      }\n    }\n    this.line.flush();\n  }\n\n  /** The location hash, without its `#`: empty when there is none. */\n  string location(this) { return this.at; }\n\n  /**\n   * Call `f` with each new location from here on; answers what stops it. A component follows the\n   * location with a state and an effect whose cleanup is that answer:\n   * `ui.effect(\"\", () => page.onLocation((string where) => { at.set(where); }))`.\n   */\n  fn<void()> onLocation(this, fn<void(string)> f) {\n    i32 slot = this.watchers.len();\n    this.watchers.push(f);\n    Vec<fn<void(string)>?> ws = this.watchers;\n    return () => { ws.set(slot, null); };\n  }\n\n  void title(this, string t) { this.line.title(t); }\n\n  /**\n   * **The location becomes `where`** — with `push`, a new place in the browser's history, which Back leaves for the\n   * one before; without, in place of this one. Heard as any new location is (`onLocation`). A page in a window of a\n   * desktop has no location of its own: its server refuses it.\n   */\n  void go(this, string where, bool push) { this.line.go(where, push); }\n  void log(this, string line) { this.line.log(line); }\n\n  /**\n   * Milliseconds, from a clock that only goes forward — the host's own, which answers at once; 0 from a host\n   * that cannot.\n   */\n  f64 now(this) {\n    Ticket<Answer> t = ask(this.line.host, OP_MONOTONIC_NANOS(), 0 as i64, 0 as i64, \"\", u8[]());\n    return t.settled() && t.value().fault == 0 ? (t.value().n as~ f64) / 1000000.0 : 0.0;\n  }\n\n  /** Offer `bytes` to the user as a file called `name`. */\n  void download(this, string name, u8[] bytes) { this.line.download(name, bytes); }\n\n  /**\n   * **A sound the page can play**: `samples` from -1 to 1, one channel, `rate` of them a second — made by the program,\n   * which is how a game has the sounds it has. Sent to the host once, here, and played from there as often as the\n   * program likes (`Sound.play`), so playing one costs a few bytes, whatever its length.\n   *\n   * **A browser plays nothing until the person has done something on the page** — a click or a key — and the\n   * host starts the sound then; what was played before that is not heard.\n   */\n  Sound sound(this, f64[] samples, i32 rate) {\n    u8[] b = u8[].filled(samples.len() * 2, 0 as u8);\n    for (i32 i = 0; i < samples.len(); i++) {\n      f64 x = samples[i];\n      if (x > 1.0) { x = 1.0; }\n      if (x < 0.0 - 1.0) { x = 0.0 - 1.0; }\n      i32 v = (x * 32767.0) as~ i32;\n      b[i * 2] = (v & 255) as@ u8;\n      b[i * 2 + 1] = ((v >> 8) & 255) as@ u8;\n    }\n    this.played++;\n    this.line.sound(this.played, rate, b);\n    return Sound(this, this.played, (samples.len() as f64) / (rate as f64));\n  }\n\n  /** The next file the user hands over, waited for. The host keeps one handed over before anything asked. */\n  Ticket<Picked> nextFile(this) {\n    Ticket<Picked> t;\n    Ticket<Answer> a = this.line.file();\n    when(a, () => {\n      Answer x = a.value();\n      bool ok = x.flags == 0;\n      t.resolve(Picked(ok, x.text, ok ? x.bytes : u8[](), ok ? \"\" : string.fromBytes(x.bytes)));\n    });\n    return t;\n  }\n\n  /** A ticket that settles after `ms` milliseconds, answering `now()` when it did. */\n  Ticket<f64> sleep(this, i32 ms) {\n    return this.nowWhen(ask(this.line.host, OP_SLEEP_MILLIS(), ms as i64, 0 as i64, \"\", u8[]()));\n  }\n\n  /** A ticket that settles before the browser next paints, answering `now()` — one per frame drawn. */\n  Ticket<f64> nextFrame(this) { return this.nowWhen(this.line.frame()); }\n\n  Ticket<f64> nowWhen(this, Ticket<Answer> a) {\n    Page page = this;\n    Ticket<f64> t;\n    when(a, () => { t.resolve(page.now()); });\n    return t;\n  }\n\n  /**\n   * Settles once the browser has painted what the page shows now, answering `now()`. Before long work,\n   * so a \"reading…\" note is on screen while it runs: on the page's own thread (`--in-page`) nothing is\n   * painted while the program computes, and a frame callback runs *before* the paint it belongs to, so\n   * the wait is a frame and then a timer. In a worker the page paints regardless, and this is a frame.\n   */\n  async f64 painted(this) {\n    await this.nextFrame();\n    return await this.sleep(0);\n  }\n\n  /** Where a suspended machine's continuation goes — see `Runner.take`. */\n  void take(this, Continuation k) { this.runner.take(k); }\n\n  /** Run what is ready, until nothing is. */\n  void drain(this) { this.runner.drain(); }\n}\n\n/** A sound sent to the host (`Page.sound`), to play. */\nexport struct Sound {\n  Page page;\n  i32 id;\n  /** How long it lasts, played once. */\n  f64 seconds;\n\n  /** Play it once, at `volume` — 1 as it was made, 0 silent — over whatever else is playing. */\n  Voice play(this, f64 volume) { return this.start(volume, false); }\n\n  /** Play it over and over, until the voice is stopped: music, or a sound that lasts as long as something does. */\n  Voice loop(this, f64 volume) { return this.start(volume, true); }\n\n  Voice start(this, f64 volume, bool loop) {\n    Page p = this.page;\n    p.played++;\n    f64 v = volume < 0.0 ? 0.0 : volume;\n    p.line.play(p.played, this.id, (v * 1000.0) as~ i32, loop);\n    return Voice(p, p.played);\n  }\n\n  /**\n   * **Played at a moment**: `at` milliseconds by the page's clock (`Page.now`), `offset` seconds into the sound.\n   * Several started for the same moment play together, to the sample — the layers of a song, each its own voice,\n   * turned up and down as the program likes (`Voice.fade`) without ever drifting apart.\n   */\n  Voice playAt(this, f64 volume, bool loop, f64 at, f64 offset) {\n    Page p = this.page;\n    p.played++;\n    f64 v = volume < 0.0 ? 0.0 : volume;\n    p.line.playAt(p.played, this.id, (v * 1000.0) as~ i32, loop, at, offset);\n    return Voice(p, p.played);\n  }\n}\n\n/** A sound playing (`Sound.play`, `Sound.loop`). */\nexport struct Voice {\n  Page page;\n  i32 id;\n\n  /** Stop it, if it is still playing. */\n  void stop(this) { this.page.line.stop(this.id); }\n\n  /** Its volume to `volume`, smoothly over `ms` milliseconds. */\n  void fade(this, f64 volume, i32 ms) {\n    f64 v = volume < 0.0 ? 0.0 : volume;\n    this.page.line.gain(this.id, (v * 1000.0) as~ i32, ms < 0 ? 0 : ms);\n  }\n}\n\n/**\n * How a program that never blocks is run on: the schedule target its machines hand their\n * continuations to, and the queue of the ones with nothing to wait for. A page has one, and so does a\n * copy of it started by `spawnSelf`, which has no page.\n */\nexport struct Runner {\n  /** Continuations with nothing to wait on — a bare `await;` — run before control goes back. */\n  Queue<Continuation> ready;\n\n  Runner create() {\n    Queue<Continuation> ready;\n    return Runner(ready);\n  }\n\n  /**\n   * Where a suspended machine's continuation goes. A continuation waiting on a ticket runs when that\n   * ticket settles; one waiting on nothing runs before control goes back to the browser.\n   */\n  void take(this, Continuation k) {\n    TicketBase? on = k.t;\n    if (on is null || on!.settled()) {\n      this.ready.push(k);\n      return;\n    }\n    on!.whenSettled(k.call);\n  }\n\n  /** Run what is ready, until nothing is. */\n  void drain(this) {\n    while (Continuation k matches this.ready.pop()) { k.call(); }\n  }\n}\n",
    "// `wac.page` answered by a program written in wac: another program's page, drawn into an element this one holds.\n//\n// **A desktop's window is this.** The desktop starts a page's module as a child (`Procs.spawnProviding`) and\n// provides `wac.page` with `PageServer.provider`; the child's handle 0 is the element the desktop handed over — the\n// window's body — and every element the child makes is one made under it here, through this program's own\n// handles. So the child reaches nothing above or beside its window: the handle layer's rule, held across a process.\n//\n// **A child's mistake is refused, not trapped on.** A trap here would end the desktop, so each change is checked\n// before it is made — a handle that is not live, a `<script>`, an `on…` attribute, a canvas drawn at the wrong\n// size — and one that fails is dropped and noted in `refused`, the way a browser drops what its policy refuses.\n//\n// **What comes back is the child's to ask for**, as `line.wac` has it: its next event is answered from what its\n// elements heard, a frame by this page's next frame, a value by the element's, a file by what the desktop hands it\n// (`hand`). Its location never changes — a window has no address bar.\n//\n// **Its sounds are this page's**, made and played through it under this side's numbers, and they stop when the\n// window closes: a closed window is not heard.\n\nimport { Answer, FAULT_UNSUPPORTED, Provider } from \"std\";\nimport { Map, Queue, Ticket, Vec, hashI32, i32Eq } from \"core\";\nimport { Element, ElementEvent, Listen, whyNotAttr, whyNotTag } from \"./element.wac\";\nimport { Page, Sound, Voice } from \"./page.wac\";\nimport { Change, Happened, PAGE_ATTR, PAGE_BATCH, PAGE_CAPABILITY, PAGE_COUNT, PAGE_DOWNLOAD, PAGE_EVENT, PAGE_FILE,\n         PAGE_FOCUS, PAGE_FRAME, PAGE_LISTEN, PAGE_LOCATION, PAGE_LOG, PAGE_MAKE, PAGE_MAKE_TEXT, PAGE_MOVE,\n         PAGE_GAIN, PAGE_GO, PAGE_PIXELS, PAGE_PIXELS_IN, PAGE_PLAY, PAGE_PROP, PAGE_REMOVE, PAGE_SCROLL, PAGE_SELECT, PAGE_SOUND, PAGE_STOP, PAGE_TEXT, PAGE_TITLE,\n         PAGE_TYPE_TEXT, PAGE_VALUE, PAGE_VERSION, batchOf, eventAnswer, getF64, highOf, lowOf, quadAt, when } from \"./line.wac\";\n\n/** What a closed page's requests are answered. */\nAnswer closedAnswer() { return Answer(FAULT_UNSUPPORTED(), \"the page was closed\", u8[](), 0 as i64, 0 as i64, 0); }\n\n/** How many refusals are kept: the latest, which is what someone looking at a misbehaving window wants. */\nstatic i32 KEPT_REFUSALS = 32;\n\nexport struct PageServer {\n  /** The page this program draws into: its frames, and its downloads, are the child's too. */\n  Page page;\n  /** The child's handles, by its numbers: 0 is the element handed over, a removed one is not live. */\n  Vec<Element?> byId;\n  /** Each element the child made, by this side's number for it: the child's number. */\n  Map<i32, i32> childOf;\n  /** Events heard that the child has not asked for yet, and its requests for the next one. */\n  Queue<Happened> heard;\n  Queue<Ticket<Answer>> asking;\n  /** Files handed over that the child has not asked for yet, and its requests for the next one. */\n  Queue<Answer> handed;\n  Queue<Ticket<Answer>> wanting;\n  i32 seq;\n  /** Told each title the child gives its page — a window's caption. */\n  fn<void(string)> onTitle;\n  /** Told each line the child logs. */\n  fn<void(string)> onLog;\n  /** What the child asked for that was refused, latest last. */\n  Vec<string> refused;\n  /** Closed (`close`): every request answered \"closed\" from now on. */\n  bool closed;\n  /** The child's sounds, and the voices it played, by its numbers. */\n  Map<i32, Sound> sounds;\n  Map<i32, Voice> voices;\n  /** How loud the child asked each of its voices to be, before `loudness` scales it. */\n  Map<i32, f64> asked;\n  /** **How loud this child is, all of it** (`louder`): what it asks for is scaled by this, 1 being as asked. */\n  f64 loudness;\n\n  /** A server drawing the child into `root`, which this program holds and the child may fill as it likes. */\n  PageServer into(Page page, Element root, fn<void(string)> onTitle, fn<void(string)> onLog) {\n    Vec<Element?> byId = Vec.create();\n    byId.push(root);\n    Queue<Happened> heard;\n    Queue<Ticket<Answer>> asking;\n    Queue<Answer> handed;\n    Queue<Ticket<Answer>> wanting;\n    return PageServer(page, byId, Map.create(hashI32, i32Eq), heard, asking, handed, wanting, 0, onTitle, onLog,\n                      Vec.create(), false, Map.create(hashI32, i32Eq), Map.create(hashI32, i32Eq), Map.create(hashI32, i32Eq), 1.0);\n  }\n\n  /** What `Procs.spawnProviding` is handed, so the child finds this as `wac.page`. */\n  Provider provider(this) {\n    PageServer s = this;\n    return Provider(PAGE_CAPABILITY(), PAGE_VERSION(), PAGE_COUNT,\n                    (i32 k, i64 a, i64 b, string text, u8[] bytes) => s.answer(k, a, b, text, bytes));\n  }\n\n  /**\n   * **The window is gone.** What the child is waiting for — its next event, its next file — is answered \"closed\",\n   * as is everything it asks from now on, so its page knows (`Page.closed`) instead of waiting for ever.\n   */\n  void close(this) {\n    this.closed = true;\n    Voice[] playing = this.voices.values();\n    for (i32 i = 0; i < playing.len(); i++) { playing[i].stop(); }\n    this.voices = Map.create(hashI32, i32Eq);\n    this.asked = Map.create(hashI32, i32Eq);\n    while (true) {\n      Ticket<Answer>? t = this.asking.pop();\n      if (t is null) { break; }\n      t!.resolve(closedAnswer());\n    }\n    while (true) {\n      Ticket<Answer>? t = this.wanting.pop();\n      if (t is null) { break; }\n      t!.resolve(closedAnswer());\n    }\n  }\n\n  /** The child's request `k` of the capability, answered — at once, or when what it waits for arrives. */\n  Ticket<Answer> answer(this, i32 k, i64 a, i64 b, string text, u8[] bytes) {\n    if (this.closed) {\n      Ticket<Answer> t;\n      t.resolve(closedAnswer());\n      return t;\n    }\n    if (k == PAGE_BATCH) {\n      Change[] changes = batchOf(bytes);\n      for (i32 i = 0; i < changes.len(); i++) {\n        Change c = changes[i];\n        this.change(c.op, c.a, c.b, c.text, c.bytes);\n      }\n      return done(\"\");\n    }\n    if (k == PAGE_VALUE) {\n      Element? e = this.at(lowOf(a));\n      if (e is null) { return done(\"\"); }\n      Ticket<Answer> t;\n      Ticket<string> v = e!.value();\n      when(v, () => { t.resolve(Answer(0, v.value(), u8[](), 0 as i64, 0 as i64, 0)); });\n      return t;\n    }\n    if (k == PAGE_EVENT) {\n      Ticket<Answer> t;\n      Happened? h = this.heard.pop();\n      if (h is not null) {\n        t.resolve(eventAnswer(h!));\n        return t;\n      }\n      this.asking.push(t);\n      return t;\n    }\n    if (k == PAGE_FRAME) {\n      Ticket<Answer> t;\n      Ticket<f64> f = this.page.nextFrame();\n      when(f, () => { t.resolve(Answer(0, \"\", u8[](), 0 as i64, 0 as i64, 0)); });\n      return t;\n    }\n    if (k == PAGE_LOCATION) {\n      // The location is always the empty one: answered only to a child that thinks it is somewhere else.\n      if (text != \"\") { return done(\"\"); }\n      Ticket<Answer> never;\n      return never;\n    }\n    if (k == PAGE_FILE) {\n      Ticket<Answer> t;\n      Answer? f = this.handed.pop();\n      if (f is not null) {\n        t.resolve(f!);\n        return t;\n      }\n      this.wanting.push(t);\n      return t;\n    }\n    if (k >= 0 && k < PAGE_COUNT) {\n      this.change(k, a, b, text, bytes);\n      return done(\"\");\n    }\n    Ticket<Answer> t;\n    t.resolve(Answer(FAULT_UNSUPPORTED(), \"wac.page has no request \\{k}\", u8[](), 0 as i64, 0 as i64, 0));\n    return t;\n  }\n\n  /** The child's live element `h`, or null. */\n  Element? at(this, i32 h) {\n    if (h < 0 || h >= this.byId.len()) { return null; }\n    Element? e = this.byId.get(h);\n    if (e is null || !e!.isLive()) { return null; }\n    return e;\n  }\n\n  void refuse(this, string why) {\n    if (this.refused.len() >= KEPT_REFUSALS) { this.refused.remove(0); }\n    this.refused.push(why);\n  }\n\n  /** Record `e` as the child's `h`. A number already taken by a live element is the child's mistake. */\n  bool adopt(this, i32 h, Element e) {\n    if (h <= 0 || h > this.byId.len() + 4096) {\n      this.refuse(\"handle \\{h} is not one the child could have made\");\n      return false;\n    }\n    while (this.byId.len() <= h) { this.byId.push(null); }\n    if (this.at(h) is not null) {\n      this.refuse(\"handle \\{h} is already in use\");\n      return false;\n    }\n    this.byId.set(h, e);\n    this.childOf.set(e.id, h);\n    return true;\n  }\n\n  /** A sound made, played or stopped: the child's numbers for them, this page's sounds and voices. */\n  void audio(this, i32 k, i64 a, i64 b, u8[] bytes) {\n    if (k == PAGE_SOUND) {\n      i32 rate = b as~ i32;\n      if (rate < 3000 || rate > 192000) {\n        this.refuse(\"sound: \\{rate} is not a sample rate a page plays\");\n        return;\n      }\n      f64[] samples = f64[].filled(bytes.len() / 2, 0.0);\n      for (i32 i = 0; i < samples.len(); i++) {\n        i32 v = (bytes[i * 2] as i32) | ((bytes[i * 2 + 1] as i32) << 8);\n        if (v >= 32768) { v = v - 65536; }\n        samples[i] = (v as f64) / 32767.0;\n      }\n      this.sounds.set(a as~ i32, this.page.sound(samples, rate));\n      return;\n    }\n    if (k == PAGE_PLAY) {\n      Sound? sound = this.sounds.get(lowOf(a));\n      if (sound is null) {\n        this.refuse(\"play: \\{lowOf(a)} is not a sound of the child's\");\n        return;\n      }\n      f64 asked = (highOf(b) as f64) / 1000.0;\n      f64 volume = asked * this.loudness;\n      // When and from where, as the child asked: its clock and this page's are the same one.\n      Voice v = bytes.len() >= 16 ? sound!.playAt(volume, lowOf(b) != 0, getF64(bytes, 0), getF64(bytes, 8))\n                                  : (lowOf(b) != 0 ? sound!.loop(volume) : sound!.play(volume));\n      this.voices.set(highOf(a), v);\n      this.asked.set(highOf(a), asked);\n      return;\n    }\n    if (k == PAGE_GAIN) {\n      Voice? fading = this.voices.get(a as~ i32);\n      if (fading is not null) {\n        f64 asked = (highOf(b) as f64) / 1000.0;\n        this.asked.set(a as~ i32, asked);\n        fading!.fade(asked * this.loudness, lowOf(b));\n      }\n      return;\n    }\n    Voice? playing = this.voices.get(a as~ i32);\n    if (playing is not null) {\n      playing!.stop();\n      this.voices.remove(a as~ i32);\n      this.asked.remove(a as~ i32);\n    }\n  }\n\n  /**\n   * **Every sound the child makes, `loudness` as loud** — 0 silent, 1 as it asked — from now on, and what is playing\n   * already faded there over `ms`. The child is not told: its own volumes stay its own, and this scales them.\n   */\n  void louder(this, f64 loudness, i32 ms) {\n    this.loudness = loudness < 0.0 ? 0.0 : loudness;\n    i32[] ids = this.voices.keys();\n    for (i32 i = 0; i < ids.len(); i++) {\n      Voice? v = this.voices.get(ids[i]);\n      f64? asked = this.asked.get(ids[i]);\n      if (v is not null && asked is not null) { v!.fade(asked! * this.loudness, ms); }\n    }\n  }\n\n  /** One change, made through this program's own handles once it has been checked. */\n  void change(this, i32 k, i64 a, i64 b, string text, u8[] bytes) {\n    i32 h = lowOf(a);\n    if (k == PAGE_GO) {\n      this.refuse(\"go: a window's page has no location of its own\");\n      return;\n    }\n    if (k == PAGE_TITLE) {\n      this.onTitle(text);\n      return;\n    }\n    if (k == PAGE_LOG) {\n      this.onLog(text);\n      return;\n    }\n    if (k == PAGE_DOWNLOAD) {\n      this.page.download(text, bytes);\n      return;\n    }\n    if (k == PAGE_SOUND || k == PAGE_PLAY || k == PAGE_STOP || k == PAGE_GAIN) {\n      this.audio(k, a, b, bytes);\n      return;\n    }\n    if (k == PAGE_MAKE || k == PAGE_MAKE_TEXT) {\n      Element? parent = this.at(highOf(b));\n      if (parent is null || parent!.tag == \"\") {\n        this.refuse(\"make: \\{highOf(b)} is not an element of the child's that can hold children\");\n        return;\n      }\n      Element? before = null;\n      if (lowOf(b) >= 0) {\n        before = this.at(lowOf(b));\n        if (before is null || before!.parentOf() is null || before!.parentOf()! is not parent!) {\n          this.refuse(\"make: \\{lowOf(b)} is not a child of \\{highOf(b)}\");\n          return;\n        }\n      }\n      if (k == PAGE_MAKE) {\n        string why = whyNotTag(text);\n        if (why != \"\") {\n          this.refuse(\"make: \" + why);\n          return;\n        }\n        Element made = parent!.insert(text, before);\n        if (!this.adopt(h, made)) { made.remove(); }\n        return;\n      }\n      Element madeText = parent!.insertText(text, before);\n      if (!this.adopt(h, madeText)) { madeText.remove(); }\n      return;\n    }\n    Element? found = this.at(h);\n    if (found is null) {\n      this.refuse(\"request \\{k}: handle \\{h} is not live\");\n      return;\n    }\n    Element e = found!;\n    if (k == PAGE_TEXT) {\n      e.text(text);\n      return;\n    }\n    if (k == PAGE_ATTR) {\n      string value = string.fromBytes(bytes);\n      string why = whyNotAttr(text, b != 0 as i64 ? value : null);\n      if (why != \"\") {\n        this.refuse(\"attr: \" + why);\n        return;\n      }\n      e.attr(text, b != 0 as i64 ? value : null);\n      return;\n    }\n    if (k == PAGE_PROP) {\n      if (text != \"value\" && text != \"checked\" && text != \"selected\") {\n        this.refuse(\"prop: \" + text + \" is not a property a page sets\");\n        return;\n      }\n      e.prop(text, string.fromBytes(bytes));\n      return;\n    }\n    if (k == PAGE_MOVE || k == PAGE_REMOVE) {\n      if (h == 0) {\n        this.refuse(\"the element handed over stays where it is\");\n        return;\n      }\n      if (k == PAGE_REMOVE) {\n        e.remove();\n        return;\n      }\n      Element? to = null;\n      if (lowOf(b) >= 0) {\n        to = this.at(lowOf(b));\n        if (to is null || to!.parentOf() is null || e.parentOf() is null || to!.parentOf()! is not e.parentOf()!) {\n          this.refuse(\"move: \\{lowOf(b)} is not beside \\{h}\");\n          return;\n        }\n      }\n      e.move(to);\n      return;\n    }\n    if (k == PAGE_LISTEN) {\n      PageServer s = this;\n      i32 listener = h;\n      e.on(text, Listen(string.fromBytes(bytes)), (ElementEvent ev) => { s.heardOn(listener, ev); });\n      return;\n    }\n    if (k == PAGE_FOCUS) {\n      e.focus();\n      return;\n    }\n    if (k == PAGE_SCROLL) {\n      if (text == \"\") { e.scrollIntoView(); } else { e.scrollToId(text); }\n      return;\n    }\n    if (k == PAGE_SELECT) {\n      e.select(highOf(b), lowOf(b));\n      return;\n    }\n    if (k == PAGE_TYPE_TEXT) {\n      e.typeText(text);\n      return;\n    }\n    if (k == PAGE_PIXELS || k == PAGE_PIXELS_IN) {\n      i32 x = k == PAGE_PIXELS ? 0 : quadAt(b, 0);\n      i32 y = k == PAGE_PIXELS ? 0 : quadAt(b, 1);\n      i32 w = k == PAGE_PIXELS ? highOf(b) : quadAt(b, 2);\n      i32 ht = k == PAGE_PIXELS ? lowOf(b) : quadAt(b, 3);\n      if (e.tag != \"canvas\" || w < 0 || ht < 0 || bytes.len() != w * ht * 4) {\n        this.refuse(\"pixels: \\{bytes.len()} bytes is not \\{w}x\\{ht} pixels of a canvas\");\n        return;\n      }\n      if (k == PAGE_PIXELS) { e.pixels(w, ht, bytes); } else { e.pixelsIn(x, y, w, ht, bytes); }\n      return;\n    }\n    this.refuse(\"wac.page has no change \\{k}\");\n  }\n\n  /**\n   * A file the person handed the child — dropped on its window, say — or, with `ok` false, one that could not be\n   * read, saying why in `bytes`: its `nextFile`, now if it is asking, or when it does.\n   */\n  void hand(this, bool ok, string name, u8[] bytes) {\n    Answer a = Answer(0, name, bytes, 0 as i64, 0 as i64, ok ? 0 : 1);\n    Ticket<Answer>? t = this.wanting.pop();\n    if (t is not null) {\n      t!.resolve(a);\n      return;\n    }\n    this.handed.push(a);\n  }\n\n  /** An event heard by the child's listener `listener`, for the child — told now if it is asking, or kept. */\n  void heardOn(this, i32 listener, ElementEvent ev) {\n    i32? target = this.childOf.get(ev.target.id);\n    this.seq++;\n    Happened h = Happened(this.seq, ev.kind, target ?? listener, listener, ev.value, ev.x, ev.y, ev.mods, ev.selStart,\n                          ev.selEnd, ev.at);\n    Ticket<Answer>? t = this.asking.pop();\n    if (t is not null) {\n      t!.resolve(eventAnswer(h));\n      return;\n    }\n    this.heard.push(h);\n  }\n}\n\n/** An answer with nothing in it but `text`, already settled. */\nTicket<Answer> done(string text) {\n  Ticket<Answer> t;\n  t.resolve(Answer(0, text, u8[](), 0 as i64, 0 as i64, 0));\n  return t;\n}\n",
    "// `wac.site`: the site a page was served from, read a path at a time — and as files, read-only.\n//\n// **A GET of a path on the page's own origin, and nothing wider** (the desktop handover's design point 7). A page's\n// host answers it with `fetch`, so the browser's HTTP cache does the caching and nothing is copied into a page's own\n// storage; a page opened from a file has no site, and its host says so. It is narrower than a network grant, and its\n// own capability, so a program is handed it — or not — apart from any other.\n//\n// **As files** (`siteFiles`): reading a file is a GET of it, and what a directory holds, and how large a file is,\n// come from the site's `index.json`, which its build writes (`tools/index.wac`) — every path under the site's root,\n// each a file with its size or a directory — fetched once. A file opened to stream is fetched whole, then streamed.\n// Nothing can be changed.\n\nimport { Answer, FAULT_NONE, FileOps, Files, HostFault, Input, IsDir, LookFault, MkdirFault, ModeFault, MoveFault, NotADir,\n         NotFound, OP_CAPABILITY, Output, ReadFault, ReadOnly, Stat, Sys, WriteFault, ask } from \"std\";\nimport { Read, Result, Ticket, Vec } from \"core\";\n\nexport string SITE_CAPABILITY() { return \"wac.site\"; }\nexport string SITE_VERSION() { return \"1.0.0\"; }\n\n/** `text` a path under the site's root → `bytes` what is there; a fault when there is nothing, or no site. */\nexport static i32 SITE_GET = 0;\n/** How many request numbers the capability takes. */\nexport static i32 SITE_COUNT = 1;\n\n/** The site this program's host was served from. */\nexport struct Site {\n  Sys sys;\n  i32 base;\n\n  /** The site, if the program's host has one; `Err` says why not — a page opened from a file has none. */\n  async Result<Site, string> of(Sys sys) {\n    Answer found = await ask(sys.host, OP_CAPABILITY(), 0 as i64, 0 as i64, SITE_CAPABILITY(), \"^1\".toBytes());\n    if (found.fault != FAULT_NONE()) { return Result.Err(found.text); }\n    return Result.Ok(Site(sys, found.n as~ i32));\n  }\n\n  /** What is at `path` on the site, or why not. */\n  async Result<u8[], string> get(this, string path) {\n    Answer a = await ask(this.sys.host, this.base + SITE_GET, 0 as i64, 0 as i64, path, u8[]());\n    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }\n    return Result.Ok(a.bytes);\n  }\n}\n\n/** One path of a site's index: a file and its size, or a directory. */\nstruct Entry {\n  string path;\n  bool dir;\n  i64 size;\n}\n\n/**\n * A site's `index.json`, read: `{\"files\": [[\"apps/explorer.wasm\", 310588], …], \"dirs\": [\"apps\", …]}`. Written by\n * `tools/index.wac`, so only that shape is read, and anything else answers an empty site.\n */\nVec<Entry> indexOf(u8[] json) {\n  Vec<Entry> out = Vec.create();\n  string s = string.fromBytes(json);\n  i32 at = s.indexOf(\"\\\"files\\\"\");\n  if (at >= 0) {\n    // Each file is `[\"path\", size]`, its path with no `\"` or `\\` in it, which `tools/index.wac` refuses to write.\n    i32 i = at;\n    while (true) {\n      i32 open = s.slice(i, s.len()).indexOf(\"[\\\"\");\n      i32 dirsAt = s.indexOf(\"\\\"dirs\\\"\");\n      if (open < 0 || (dirsAt >= 0 && i + open > dirsAt)) { break; }\n      i32 from = i + open + 2;\n      i32 close = s.slice(from, s.len()).indexOf(\"\\\"\");\n      if (close < 0) { break; }\n      string path = s.slice(from, from + close);\n      i32 n = from + close + 2;\n      i64 size = 0 as i64;\n      while (n < s.len() && s.slice(n, n + 1) >= \"0\" && s.slice(n, n + 1) <= \"9\") {\n        size = size * (10 as i64) + ((s.toBytes()[n] as i32 - 48) as i64);\n        n++;\n      }\n      out.push(Entry(path, false, size));\n      i = n;\n    }\n  }\n  i32 dirs = s.indexOf(\"\\\"dirs\\\"\");\n  if (dirs >= 0) {\n    i32 i = dirs + 6;\n    while (true) {\n      i32 q = s.slice(i, s.len()).indexOf(\"\\\"\");\n      if (q < 0) { break; }\n      i32 from = i + q + 1;\n      i32 close = s.slice(from, s.len()).indexOf(\"\\\"\");\n      if (close < 0) { break; }\n      out.push(Entry(s.slice(from, from + close), true, 0 as i64));\n      i = from + close + 1;\n    }\n  }\n  return out;\n}\n\n/** `p` as the index names it: no leading `/`, no `.` parts. */\nstring indexed(string p) {\n  string out = \"\";\n  i32 start = 0;\n  for (i32 i = 0; i <= p.len(); i++) {\n    if (i < p.len() && p.slice(i, i + 1) != \"/\") { continue; }\n    string part = p.slice(start, i);\n    start = i + 1;\n    if (part == \"\" || part == \".\") { continue; }\n    out = out == \"\" ? part : out + \"/\" + part;\n  }\n  return out;\n}\n\n/** The site's index, fetched once, and shared by every call that needs it. */\nstruct Index {\n  Site site;\n  Ticket<Vec<Entry>>? got;\n\n  Ticket<Vec<Entry>> entries(this) {\n    if (this.got is not null) { return this.got!; }\n    Ticket<Vec<Entry>> t = fetchIndex(this.site);\n    this.got = t;\n    return t;\n  }\n}\n\nasync Vec<Entry> fetchIndex(Site site) {\n  Result<u8[], string> got = await site.get(\"index.json\");\n  if (got.isErr()) { return Vec.create(); }\n  return indexOf(got.ok()!);\n}\n\nEntry? find(Vec<Entry> all, string p) {\n  for (i32 i = 0; i < all.len(); i++) { if (all.get(i).path == p) { return all.get(i); } }\n  return null;\n}\n\nasync Result<u8[], ReadFault> siteRead(Index ix, string path) {\n  string p = indexed(path);\n  Entry? e = find(await ix.entries(), p);\n  if (e is null) { return Result.Err(NotFound(path + \": No such file or directory\")); }\n  if (e!.dir) { return Result.Err(IsDir(path + \": Is a directory\")); }\n  Result<u8[], string> got = await ix.site.get(p);\n  if (got.isErr()) { return Result.Err(NotFound(path + \": \" + got.err()!)); }\n  return Result.Ok(got.ok()!);\n}\n\n/** What `path` is on the site — absence an answer, as `Stat` has it, not a fault. */\nasync Result<Stat, LookFault> siteStat(Index ix, string path) {\n  string p = indexed(path);\n  if (p == \"\") { return Result.Ok(Stat.of(true, false, true, 0 as i64, 0 as i64, false, false, 0, 365)); }\n  Entry? e = find(await ix.entries(), p);\n  if (e is null) { return Result.Ok(Stat.of(false, false, false, 0 as i64, 0 as i64, false, false, 0, 0)); }\n  return Result.Ok(Stat.of(true, !e!.dir, e!.dir, e!.size, 0 as i64, false, false, 0, e!.dir ? 365 : 292));\n}\n\nasync Result<string[], LookFault> siteList(Index ix, string path) {\n  string p = indexed(path);\n  Vec<Entry> all = await ix.entries();\n  if (p != \"\") {\n    Entry? e = find(all, p);\n    if (e is null) { return Result.Err(NotFound(path + \": No such file or directory\")); }\n    if (!e!.dir) { return Result.Err(NotADir(path + \": Not a directory\")); }\n  }\n  Vec<string> names = Vec.create();\n  string prefix = p == \"\" ? \"\" : p + \"/\";\n  for (i32 i = 0; i < all.len(); i++) {\n    string q = all.get(i).path;\n    if (q.len() <= prefix.len() || q.slice(0, prefix.len()) != prefix) { continue; }\n    string rest = q.slice(prefix.len(), q.len());\n    if (rest.indexOf(\"/\") < 0) { names.push(rest); }\n  }\n  return Result.Ok(names.toArray());\n}\n\n// Every change refused, each taking what its `FileOps` slot is handed so it is passed by name: a lambda apiece would\n// cost a program that uses this one of the emitter's limited lambdas each, for nothing.\nstring readOnlyWords(string p) { return p + \": Read-only file system\"; }\nasync Result<void, WriteFault> siteNoWrite(string p, u8[] b) { return Result.Err(ReadOnly(readOnlyWords(p))); }\nasync Result<Output, WriteFault> siteNoOutput(string p) { return Result.Err(ReadOnly(readOnlyWords(p))); }\nasync Result<void, MkdirFault> siteNoMkdir(string p, bool parents) { return Result.Err(ReadOnly(readOnlyWords(p))); }\nasync Result<void, MoveFault> siteNoRemove(string p, bool recursive) { return Result.Err(ReadOnly(readOnlyWords(p))); }\nasync Result<void, MoveFault> siteNoRename(string from, string to) { return Result.Err(ReadOnly(readOnlyWords(from))); }\nasync Result<void, ModeFault> siteNoChmod(string p, i32 mode) { return Result.Err(ReadOnly(readOnlyWords(p))); }\nasync Result<void, ModeFault> siteNoFlag(string p, bool on) { return Result.Err(ReadOnly(readOnlyWords(p))); }\nasync Result<void, ModeFault> siteNoChown(string p, string owner) { return Result.Err(ReadOnly(readOnlyWords(p))); }\n\n/**\n * A file opened to stream, as a command does — fetched whole first, since a site is read a file at a time, then\n * handed over as one piece and the end.\n */\nasync Result<Input, ReadFault> siteStream(Index ix, string path) {\n  Result<u8[], ReadFault> got = await siteRead(ix, path);\n  if (got.isErr()) { return Result.Err(got.err()!); }\n  u8[] data = got.ok()!;\n  bool[] gone = bool[].filled(1, false);\n  return Result.Ok(Input(() => onePiece(data, gone), () => theRest(data, gone), closed));\n}\n\nasync Result<Read, HostFault> onePiece(u8[] data, bool[] gone) {\n  if (gone[0] || data.len() == 0) { return Result.Ok(Read.End); }\n  gone[0] = true;\n  return Result.Ok(Read.Data(data));\n}\n\nasync Result<u8[], HostFault> theRest(u8[] data, bool[] gone) {\n  bool was = gone[0];\n  gone[0] = true;\n  return Result.Ok(was ? u8[]() : data);\n}\n\nasync Result<void, HostFault> closed() { return Result.Ok(); }\n\n/** The site as files: read-only, its listings and sizes from its `index.json`, each file a GET. */\nexport Files siteFiles(Site site) {\n  Index ix = Index(site, null);\n  return Files.of(FileOps(\n    (string p) => siteRead(ix, p),\n    siteNoWrite,\n    (string p) => siteStream(ix, p),\n    siteNoOutput,\n    siteNoOutput,\n    (string p) => siteStat(ix, p),\n    (string p) => siteStat(ix, p),\n    (string p) => siteList(ix, p),\n    siteNoMkdir,\n    siteNoRemove,\n    siteNoRename,\n    siteNoChmod,\n    siteNoFlag,\n    siteNoChown), \"\");\n}\n",
    "// The HTML tag functions: one per element, each answering `Node.Element` with its own name, an `Attr` per\n// attribute written, an `On` per handler, and its children as `kids`. The package exports this module as\n// the namespace `html`, so `<p class=\"hi\">` is `html.p(class: \"hi\", kids: [])` once `html.p` is imported,\n// and an attribute left out is `null` here and absent from the element.\n//\n// Every element takes the same attributes, the common ones: a list written per element would be a list\n// nobody has decided yet, and a uniform one is easy to widen. A name outside it is written with a quoted\n// tag, `<\"div\" aria-label=\"…\">`, which takes any. `key` names a node among its siblings for the view and is\n// never sent; `ref` is a `Ref` the view points at the element it makes (`view.wac`); `prevent` lists the\n// defaults the document prevents for this element's handlers — `\"Tab ArrowUp\"` for keys, `\"*\"` for every\n// event (`element.wac`'s `Listen`).\n//\n// The functions differ only in their names: a change to the lists in `element` is a change to every one.\n\nimport { Attr, Node, On } from \"./html.wac\";\nimport { ElementEvent } from \"./element.wac\";\nimport { Ref } from \"./view.wac\";\n\n/**\n * An element named `tag`: an `Attr` for each attribute given and for `key`, and an `On` for each handler\n * given — what every tag function builds.\n */\nNode element(string tag, Node[] kids, string?[] values, string? key, string? prevent, Ref? ref,\n             fn<void(ElementEvent)>?[] handlers) {\n  string[] names = [\"class\", \"id\", \"style\", \"title\", \"lang\", \"role\", \"href\", \"src\", \"alt\", \"type\", \"name\", \"value\", \"for\", \"placeholder\", \"rel\", \"target\", \"width\", \"height\", \"action\", \"method\", \"content\", \"charset\", \"disabled\", \"checked\", \"accept\", \"spellcheck\", \"rows\", \"cols\", \"tabindex\", \"autocomplete\", \"autofocus\", \"multiple\", \"download\", \"readonly\", \"selected\", \"min\", \"max\", \"step\", \"maxlength\"];\n  string[] kinds = [\"click\", \"dblclick\", \"input\", \"change\", \"keydown\", \"keyup\", \"submit\", \"focus\", \"blur\", \"pointerdown\", \"pointermove\", \"pointerup\", \"wheel\", \"scroll\", \"contextmenu\"];\n  i32 n = key is null ? 0 : 1;\n  for (i32 i = 0; i < values.len(); i++) { if (values[i] is not null) { n++; } }\n  Attr[] attrs = Attr[].filled(n, Attr(\"\", \"\"));\n  i32 at = 0;\n  if (key is not null) {\n    attrs[0] = Attr(\"key\", key!);\n    at = 1;\n  }\n  for (i32 i = 0; i < values.len(); i++) {\n    if (values[i] is null) { continue; }\n    attrs[at] = Attr(names[i], values[i]!);\n    at++;\n  }\n  i32 h = 0;\n  for (i32 i = 0; i < handlers.len(); i++) { if (handlers[i] is not null) { h++; } }\n  On[] on = On[].filled(h, On(\"\", \"\", (ElementEvent e) => { }));\n  i32 k = 0;\n  for (i32 i = 0; i < handlers.len(); i++) {\n    if (handlers[i] is null) { continue; }\n    on[k] = On(kinds[i], prevent ?? \"\", handlers[i]!);\n    k++;\n  }\n  return Node.Element(tag, attrs, on, kids, ref);\n}\n\nexport Node a(Node[] kids, string? @\"class\", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @\"type\", string? name, string? value, string? @\"for\", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {\n  return element(\"a\", kids, [@\"class\", id, style, title, lang, role, href, src, alt, @\"type\", name, value, @\"for\", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);\n}\n\nexport Node abbr(Node[] kids, string? @\"class\", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @\"type\", string? name, string? value, string? @\"for\", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {\n  return element(\"abbr\", kids, [@\"class\", id, style, title, lang, role, href, src, alt, @\"type\", name, value, @\"for\", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);\n}\n\nexport Node article(Node[] kids, string? @\"class\", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @\"type\", string? name, string? value, string? @\"for\", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {\n  return element(\"article\", kids, [@\"class\", id, style, title, lang, role, href, src, alt, @\"type\", name, value, @\"for\", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);\n}\n\nexport Node aside(Node[] kids, string? @\"class\", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @\"type\", string? name, string? value, string? @\"for\", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {\n  return element(\"aside\", kids, [@\"class\", id, style, title, lang, role, href, src, alt, @\"type\", name, value, @\"for\", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);\n}\n\nexport Node b(Node[] kids, string? @\"class\", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @\"type\", string? name, string? value, string? @\"for\", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {\n  return element(\"b\", kids, [@\"class\", id, style, title, lang, role, href, src, alt, @\"type\", name, value, @\"for\", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);\n}\n\nexport Node blockquote(Node[] kids, string? @\"class\", stri