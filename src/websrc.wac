et, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {\n  return element(\"body\", kids, [@\"class\", id, style, title, lang, role, href, src, alt, @\"type\", name, value, @\"for\", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);\n}\n\nexport Node br(Node[] kids, string? @\"class\", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @\"type\", string? name, string? value, string? @\"for\", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? 