    "// A document for tests: a host answering `wac.page` (`line.wac`) into a tree of records.\n//\n// Every change the program sends lands in `nodes`, and an event is fired the way a browser fires one — at a\n// target, heard by every listener from the target up, nearest first — as the answer to the program's request for\n// its next event. `ops` counts the element operations, which is what says how much a render sent; `said` is\n// every request the program made that a reader would check, one line each.\n//\n// **The host's other answers are the test's to give**: the clock stands still until `advance` moves it, a frame\n// comes when `paint` says, an element's value when `answerValue` does, a file when `hand` does, a new location\n// when `go` does. So every order in which things can arrive is one a test can write down.\n//\n// **Part of the package, for an application's tests**: `doc.page()` is a page over this document, and events\n// fired at what the view drew run the program on and render, as a browser's would. `template/test` does.\n\nimport { Vec } from \"core\";\nimport { Answer, FAULT_UNSUPPORTED, HOST_CANNOT_WAIT, Host, OP_CAPABILITY, OP_MONOTONIC_NANOS, OP_SLEEP_MILLIS, Sys,\n         answered } from \"std\";\nimport { Elements } from \"./element.wac\";\nimport { Page } from \"./page.wac\";\nimport { Change, Happened, PAGE_BATCH, PAGE_CAPABILITY, batchOf, PAGE_COUNT, PAGE_EVENT, PAGE_ONE_AT_A_TIME, PAGE_FILE, PAGE_FRAME, PAGE_GAIN, PAGE_GO, PAGE_LOCATION, PAGE_PLAY, PAGE_SOUND, PAGE_STOP, PAGE_TYPE_TEXT,\n         PAGE_VALUE, PAGE_VERSION, PageLine, eventAnswer, highOf, lowOf, quadAt, getF64 } from \"./line.wac\";\n\n/** Where this document's `wac.page` numbers start, as a host would choose them. */\nstatic i32 BASE = 4096;\n\n/** One node of the document: an element or, with an empty `tag`, a text node. */\nexport struct TestNode {\n  i32 id;\n  string tag;\n  string text;\n  Vec<string> names;\n  Vec<string> values;\n  Vec<i32> kids;\n  i32 parent;\n  Vec<string> listens;\n  Vec<string> prevents;\n  /** The number of the last event typed into it; a `prop(\"value\")` the program sent before seeing it is dropped. */\n  i32 typed;\n  /** Its caret, for an `input` or a `textarea`: the selection's two ends, equal when nothing is selected; -1 elsewhere. */\n  i32 selStart;\n  i32 selEnd;\n}\n\n/** A file handed over before anything asked for one. */\nstruct Kept {\n  bool ok;\n  string name;\n  u8[] bytes;\n}\n\nexport struct TestDoc {\n  Vec<TestNode?> nodes;\n  i32 ops;\n  i32 seq;\n  /** The host the program's requests go to, and the `Sys` over it, once made. */\n  Host? host;\n  Sys? sys;\n  /** How deep in the program's requests this is: an answer given inside one is that request's, and runs nothing on. */\n  i32 asking;\n  /** The handles' owner, once the elements exist. */\n  Elements? es;\n  /** The page they belong to, when there is one: an answer then runs it on, and its views render. */\n  Page? owner;\n  /** The last scroll asked for, as `\"<handle> <name>\"` — the name empty when it was the element itself. */\n  string scrolled;\n  /**\n   * Fields `typeText` typed into, whose `input` events are still to fire: a browser fires them after the operation,\n   * not inside the handler that sent it, so they are fired once the event being handled is done — or, for text typed\n   * outside any event, with the next one.\n   */\n  Vec<i32> typedInto;\n  /** Every request a reader would check, one line each: `make 1 button`, `sleep 250`, `title Notes`… */\n  string said;\n  /** The clock, in milliseconds: still until `advance` moves it. */\n  f64 now;\n  /** The requests waiting for an answer, each by its number: the next event, sleeps, frames, values, files, locations. */\n  Vec<i32> eventAsks;\n  Vec<i32> sleepAsks;\n  Vec<f64> sleepDue;\n  Vec<i32> frameAsks;\n  /** Every value read, in the order asked — `answerValue(k, …)` answers the `k`th — and whether it has been. */\n  Vec<i32> valueAsks;\n  Vec<i32> fileAsks;\n  Vec<Kept> kept;\n  Vec<i32> locationAsks;\n  /** The location, without its `#`. */\n  string location;\n  /** Whether the program is told to hold its changes and send them together, as a browser's host tells it. */\n  bool batching;\n  /** The locations the program went on from, adding to the history: what `back` returns to, latest last. */\n  Vec<string> visited;\n\n  TestDoc create() {\n    Vec<TestNode?> nodes = Vec.create();\n    TestDoc d = TestDoc(nodes, 0, 0, null, null, 0, null, null, \"\", Vec.create(), \"\", 0.0, Vec.create(), Vec.create(),\n                        Vec.create(), Vec.create(), Vec.create(), Vec.create(), Vec.create(), Vec.create(), \"\", false, Vec.create());\n    d.put(0, \"div\", 0 - 1);\n    Host h = Host.of(\n      (i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) => {\n        d.asking++;\n        d.request(op, id, a, b, text, bytes);\n        d.asking--;\n      },\n      // Nothing is ever waiting to be collected — every answer is given as it is — so a wait that would block cannot.\n      (i32[] ids, i32 millis) => millis == 0 ? 0 - 1 : HOST_CANNOT_WAIT(),\n      (i32 code) => { },\n      () => false);\n    d.host = h;\n    d.sys = Sys.__wacOn(h);\n    return d;\n  }\n\n  /**\n   * A document whose program holds its changes and sends them together (`PAGE_BATCH`), as a browser's host has it\n   * do: nothing lands here until the program's turn ends, or until it asks something.\n   */\n  TestDoc batched() {\n    TestDoc d = TestDoc.create();\n    d.batching = true;\n    return d;\n  }\n\n  /** The program's end of this document: the host, and where `wac.page` starts on it. */\n  PageLine line(this) { return PageLine.of(this.host!, BASE, this.batching ? 0 : PAGE_ONE_AT_A_TIME); }\n\n  /** A page over this document, whose answers run it on and render its views. */\n  Page page(this) {\n    Page p = Page.over(this.line(), this.sys!);\n    this.owner = p;\n    this.es = p.es;\n    return p;\n  }\n\n  /** Handles over this document with no page around them — a view's test, which renders by hand. */\n  Elements elements(this) {\n    Elements es = Elements.create(this.line());\n    this.es = es;\n    return es;\n  }\n\n  // ── Answering ──────────────────────────────────────────────────────────────\n\n  /**\n   * Answer request `id`. **From outside the program's requests it runs the page on**, under the page as its schedule\n   * target, as a host's turn would: what the answer settled runs, then every view renders. Inside one it only settles:\n   * the request that asked is still running.\n   */\n  void answer(this, i32 id, Answer a) {\n    if (this.owner is null || this.asking > 0) {\n      answered(this.host!, id, a.fault, a.text, a.bytes, a.n, a.m, a.flags);\n      return;\n    }\n    Page p = this.owner!;\n    schedule p.take;\n    answered(this.host!, id, a.fault, a.text, a.bytes, a.n, a.m, a.flags);\n    p.drain();\n    p.turn();\n  }\n\n  void answerWith(this, i32 id, string text, u8[] bytes, i64 n, i64 m, i32 flags) {\n    this.answer(id, Answer(0, text, bytes, n, m, flags));\n  }\n\n  /** An event, as the document would say it: the oldest request for one hears it. None waiting, and it is lost. */\n  void event(this, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y, i32 mods,\n             i32 selStart, i32 selEnd) {\n    if (this.eventAsks.len() == 0) { return; }\n    i32 id = this.eventAsks.remove(0);\n    this.answer(id, eventAnswer(Happened(seq, kind, target, listener, value, x, y, mods, selStart, selEnd, this.now)));\n  }\n\n  /** Move the clock on by `ms`, waking each sleep that falls due, earliest first. */\n  void advance(this, i32 ms) {\n    f64 until = this.now + (ms as f64);\n    while (true) {\n      i32 best = 0 - 1;\n      for (i32 i = 0; i < this.sleepDue.len(); i++) {\n        if (this.sleepDue.get(i) <= until && (best < 0 || this.sleepDue.get(i) < this.sleepDue.get(best))) { best = i; }\n      }\n      if (best < 0) { break; }\n      this.now = this.sleepDue.remove(best);\n      i32 id = this.sleepAsks.remove(best);\n      this.answerWith(id, \"\", u8[](), this.nanos(), 0 as i64, 0);\n    }\n    this.now = until;\n  }\n\n  i64 nanos(this) { return (this.now * 1000000.0) as~ i64; }\n\n  /** The browser paints: every frame asked for is answered. */\n  void paint(this) {\n    Vec<i32> asked = this.frameAsks;\n    this.frameAsks = Vec.create();\n    for (i32 i = 0; i < asked.len(); i++) { this.answerWith(asked.get(i), \"\", u8[](), 0 as i64, 0 as i64, 0); }\n  }\n\n  /** The `k`th value read, in the order they were asked, answers `value`. A read answered already ignores it. */\n  void answerValue(this, i32 k, string value) { this.answerWith(this.valueAsks.get(k), value, u8[](), 0 as i64, 0 as i64, 0); }\n\n  /** The user hands over a file — or one that could not be read, saying why. */\n  void hand(this, bool ok, string name, u8[] bytes) {\n    if (this.fileAsks.len() == 0) {\n      this.kept.push(Kept(ok, name, bytes));\n      return;\n    }\n    this.answerWith(this.fileAsks.remove(0), name, bytes, 0 as i64, 0 as i64, ok ? 0 : 1);\n  }\n\n  /** The location becomes `hash`; everything asking for a location other than it hears it. */\n  void go(this, string hash) {\n    this.location = hash.len() > 0 && hash[0] == \"#\" ? hash.slice(1, hash.len()) : hash;\n    Vec<i32> asked = this.locationAsks;\n    this.locationAsks = Vec.create();\n    for (i32 i = 0; i < asked.len(); i++) { this.answerWith(asked.get(i), this.location, u8[](), 0 as i64, 0 as i64, 0); }\n  }\n\n  /** The browser's Back: the location before the last the program added to the history, if there is one. */\n  void back(this) {\n    if (this.visited.len() == 0) { return; }\n    this.go(this.visited.remove(this.visited.len() - 1));\n  }\n\n  // ── The requests ───────────────────────────────────────────────────────────\n\n  void request(this, i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) {\n    if (op == OP_CAPABILITY()) {\n      if (text != PAGE_CAPABILITY()) {\n        this.answer(id, Answer(FAULT_UNSUPPORTED(), \"no capability \" + text + \" in a test document\", u8[](), 0 as i64, 0 as i64, 0));\n        return;\n      }\n      // Each change as it is made, so a test reads the document straight after the call that changed it.\n      this.answerWith(id, PAGE_VERSION(), u8[](), BASE as i64, PAGE_COUNT as i64, this.batching ? 0 : PAGE_ONE_AT_A_TIME);\n      return;\n    }\n    if (op == OP_MONOTONIC_NANOS()) {\n      this.answerWith(id, \"\", u8[](), this.nanos(), 0 as i64, 0);\n      return;\n    }\n    if (op == OP_SLEEP_MILLIS()) {\n      this.said = this.said + \"sleep \\{a}\\n\";\n      this.sleepAsks.push(id);\n      this.sleepDue.push(this.now + (a as~ f64));\n      return;\n    }\n    i32 k = op - BASE;\n    if (k < 0 || k >= PAGE_COUNT) {\n      if (id != 0) { this.answer(id, Answer(FAULT_UNSUPPORTED(), \"a test document does not serve request \\{op}\", u8[](), 0 as i64, 0 as i64, 0)); }\n      return;\n    }\n    if (k <= PAGE_TYPE_TEXT) {\n      this.ops++;\n      this.element(k, id, a, b, text, bytes);\n      return;\n    }\n    if (k == 15) { this.said = this.said + \"title \" + text + \"\\n\"; return; }\n    if (k == 16) { this.said = this.said + \"log \" + text + \"\\n\"; return; }\n    if (k == 17) { this.said = this.said + \"download \" + text + \"\\n\"; return; }\n    if (k == PAGE_GO) {\n      this.said = this.said + \"go \" + text + (a != (0 as i64) ? \" push\" : \"\") + \"\\n\";\n      if (a != (0 as i64)) { this.visited.push(this.location); }\n      this.go(text);\n      return;\n    }\n    if (k == PAGE_SOUND) { this.said = this.said + \"sound \\{a} \\{b} \\{bytes.len() / 2}\\n\"; return; }\n    if (k == PAGE_PLAY) {\n      string when = bytes.len() >= 16 ? \" at \\{getF64(bytes, 0)} from \\{getF64(bytes, 8)}\" : \"\";\n      this.said = this.said + \"play \\{highOf(a)} \\{lowOf(a)} \\{highOf(b)}\" + (lowOf(b) != 0 ? \" loop\" : \"\") + when + \"\\n\";\n      return;\n    }\n    if (k == PAGE_STOP) { this.said = this.said + \"stop \\{a}\\n\"; return; }\n    if (k == PAGE_GAIN) { this.said = this.said + \"gain \\{a} \\{highOf(b)} \\{lowOf(b)}\\n\"; return; }\n    if (k == PAGE_EVENT) { this.eventAsks.push(id); return; }\n    if (k == PAGE_BATCH) {\n      Change[] changes = batchOf(bytes);\n      this.said = this.said + \"batch \\{changes.len()}\\n\";\n      for (i32 i = 0; i < changes.len(); i++) {\n        Change c = changes[i];\n        this.request(BASE + c.op, 0, c.a, c.b, c.text, c.bytes);\n      }\n      this.answerWith(id, \"\", u8[](), 0 as i64, 0 as i64, 0);\n      return;\n    }\n    if (k == PAGE_FRAME) {\n      this.said = this.said + \"frame\\n\";\n      this.frameAsks.push(id);\n      return;\n    }\n    if (k == PAGE_FILE) {\n      if (this.kept.len() == 0) { this.fileAsks.push(id); return; }\n      Kept f = this.kept.remove(0);\n      this.answerWith(id, f.name, f.bytes, 0 as i64, 0 as i64, f.ok ? 0 : 1);\n      return;\n    }\n    if (k == PAGE_LOCATION) {\n      if (text != this.location) { this.answerWith(id, this.location, u8[](), 0 as i64, 0 as i64, 0); return; }\n      this.locationAsks.push(id);\n    }\n  }\n\n  /** An element operation, done to the records. */\n  void element(this, i32 k, i32 id, i64 a, i64 b, string text, u8[] bytes) {\n    i32 h = lowOf(a);\n    i32 seen = highOf(a);\n    if (k == 0 || k == 1) {\n      i32 parent = highOf(b);\n      i32 before = lowOf(b);\n      this.said = this.said + (k == 0 ? \"make \\{h} \" : \"makeText \\{h} \") + text + \"\\n\";\n      this.put(h, k == 0 ? text : \"\", parent);\n      if (k == 1) {\n        TestNode made = this.at(h);\n        made.text = text;\n      }\n      this.place(h, parent, before);\n      return;\n    }\n    if (k == 2) {\n      this.said = this.said + \"text \\{h} \" + text + \"\\n\";\n      TestNode n = this.at(h);\n      if (n.tag != \"\") {\n        for (i32 i = 0; i < n.kids.len(); i++) { this.forget(n.kids.get(i)); }\n        n.kids.clear();\n      }\n      n.text = text;\n      return;\n    }\n    if (k == 3) {\n      this.setAttr(this.at(h), text, string.fromBytes(bytes), b != 0 as i64);\n      return;\n    }\n    if (k == 4) {\n      TestNode n = this.at(h);\n      string value = string.fromBytes(bytes);\n      if (text == \"value\" && n.typed > seen) { return; }\n      this.setAttr(n, \".\" + text, value, true);\n      // A value set by a program puts the caret at its end, as a browser does.\n      if (text == \"value\" && n.selStart >= 0) { n.selStart = value.len(); n.selEnd = value.len(); }\n      return;\n    }\n    if (k == 5) {\n      TestNode n = this.at(h);\n      this.unplace(h);\n      this.place(h, n.parent, b as~ i32);\n      return;\n    }\n    if (k == 6) {\n      this.unplace(h);\n      this.forget(h);\n      return;\n    }\n    if (k == 7) {\n      this.said = this.said + \"listen \\{h} \" + text + \"\\n\";\n      this.at(h).listens.push(text);\n      this.at(h).prevents.push(string.fromBytes(bytes));\n      return;\n    }\n    if (k == PAGE_VALUE) {\n      this.said = this.said + \"value \\{h}\\n\";\n      this.valueAsks.push(id);\n      return;\n    }\n    // A canvas's picture as its text: its size and its first byte, which is what a test can tell apart.\n    if (k == 10) {\n      TestNode c = this.at(h);\n      c.text = \"pixels \\{highOf(b)}x\\{lowOf(b)} \\{bytes.len() > 0 ? bytes[0] as i32 : 0 - 1}\";\n      return;\n    }\n    if (k == 11) {\n      TestNode c = this.at(h);\n      c.text = \"pixelsIn \\{quadAt(b, 0)},\\{quadAt(b, 1)} \\{quadAt(b, 2)}x\\{quadAt(b, 3)} \\{bytes.len() > 0 ? bytes[0] as i32 : 0 - 1}\";\n      return;\n    }\n    if (k == 12) {\n      this.scrolled = \"\\{h} \" + text;\n      return;\n    }\n    if (k == 13) {\n      TestNode n = this.at(h);\n      if (n.selStart < 0 || n.typed > seen) { return; }\n      this.caret(h, highOf(b), lowOf(b));\n      return;\n    }\n    if (k == 14) {\n      TestNode n = this.at(h);\n      if (n.selStart < 0 || n.typed > seen) { return; }\n      string v = this.valueOf(h);\n      this.setAttr(n, \".value\", v.slice(0, n.selStart) + text + v.slice(n.selEnd, v.len()), true);\n      n.selStart = n.selStart + text.len();\n      n.selEnd = n.selStart;\n      this.typedInto.push(h);\n    }\n  }\n\n  void put(this, i32 id, string tag, i32 parent) {\n    while (this.nodes.len() <= id) { this.nodes.push(null); }\n    Vec<string> names = Vec.create();\n    Vec<string> values = Vec.create();\n    Vec<i32> kids = Vec.create();\n    Vec<string> listens = Vec.create();\n    Vec<string> prevents = Vec.create();\n    i32 caret = tag == \"input\" || tag == \"textarea\" ? 0 : 0 - 1;\n    this.nodes.set(id, TestNode(id, tag, \"\", names, values, kids, parent, listens, prevents, 0, caret, caret));\n  }\n\n  TestNode at(this, i32 id) { return this.nodes.get(id)!; }\n\n  void place(this, i32 id, i32 parent, i32 before) {\n    TestNode p = this.at(parent);\n    if (before < 0) { p.kids.push(id); return; }\n    for (i32 i = 0; i < p.kids.len(); i++) {\n      if (p.kids.get(i) == before) { p.kids.insert(i, id); return; }\n    }\n    p.kids.push(id);\n  }\n\n  void unplace(this, i32 id) {\n    TestNode n = this.at(id);\n    if (n.parent < 0) { return; }\n    TestNode p = this.at(n.parent);\n    for (i32 i = 0; i < p.kids.len(); i++) {\n      if (p.kids.get(i) == id) { p.kids.remove(i); return; }\n    }\n  }\n\n  void forget(this, i32 id) {\n    TestNode n = this.at(id);\n    for (i32 i = 0; i < n.kids.len(); i++) { this.forget(n.kids.get(i)); }\n    this.nodes.set(id, null);\n  }\n\n  void setAttr(this, TestNode n, string name, string value, bool present) {\n    for (i32 i = 0; i < n.names.len(); i++) {\n      if (n.names.get(i) == name) {\n        if (present) { n.values.set(i, value); } else { n.names.remove(i); n.values.remove(i); }\n        return;\n      }\n    }\n    if (present) { n.names.push(name); n.values.push(value); }\n  }\n\n  string? attr(this, i32 id, string name) {\n    TestNode n = this.at(id);\n    for (i32 i = 0; i < n.names.len(); i++) { if (n.names.get(i) == name) { return n.values.get(i); } }\n    return null;\n  }\n\n  /** The first live node, in document order, whose attribute `name` is `value`, or -1. */\n  i32 find(this, string name, string value) { return this.findFrom(0, name, value); }\n\n  i32 findFrom(this, i32 id, string name, string value) {\n    string? v = this.attr(id, name);\n    if (v is not null && v! == value) { return id; }\n    TestNode n = this.at(id);\n    for (i32 i = 0; i < n.kids.len(); i++) {\n      i32 f = this.findFrom(n.kids.get(i), name, value);\n      if (f >= 0) { return f; }\n    }\n    return 0 - 1;\n  }\n\n  /** The first element called `tag`, or -1. */\n  i32 findTag(this, string tag) { return this.findTagFrom(0, tag); }\n\n  i32 findTagFrom(this, i32 id, string tag) {\n    TestNode n = this.at(id);\n    if (n.tag == tag && id != 0) { return id; }\n    for (i32 i = 0; i < n.kids.len(); i++) {\n      i32 f = this.findTagFrom(n.kids.get(i), tag);\n      if (f >= 0) { return f; }\n    }\n    return 0 - 1;\n  }\n\n  /** A text field's value: what the program set or the user typed, or `\"\"`. */\n  string valueOf(this, i32 id) { return this.attr(id, \".value\") ?? \"\"; }\n\n  /**\n   * Put text field `id`'s caret at `start`..`end`, clamped to its value — a user's click or drag, so no event:\n   * the next one carries it. Counted in bytes here; a browser counts UTF-16 code units, which agree for ASCII.\n   */\n  void caret(this, i32 id, i32 start, i32 end) {\n    TestNode n = this.at(id);\n    i32 len = this.valueOf(id).len();\n    n.selStart = start < 0 ? 0 : (start > len ? len : start);\n    n.selEnd = end < n.selStart ? n.selStart : (end > len ? len : end);\n  }\n\n  /** The text under a node, all of it, in order. */\n  string shown(this, i32 id) {\n    TestNode n = this.at(id);\n    if (n.tag == \"\") { return n.text; }\n    string s = n.kids.len() == 0 ? n.text : \"\";\n    for (i32 i = 0; i < n.kids.len(); i++) { s = s + this.shown(n.kids.get(i)); }\n    return s;\n  }\n\n  /** How many children a node has in the document. */\n  i32 kidCount(this, i32 id) { return this.at(id).kids.len(); }\n\n  /**\n   * `kind` happens at `target`, carrying `value`: every listener from the target up hears it, nearest\n   * first, as in a browser, with the target's caret. An `input` is typing: the field holds `value` after it,\n   * the caret at its end, and it is marked as typed into with this event's number. What `typeText` typed while\n   * it was handled fires its own `input` after.\n   */\n  void fire(this, i32 target, string kind, string value) {\n    this.seq = this.seq + 1;\n    TestNode hit = this.at(target);\n    if (kind == \"input\") {\n      hit.typed = this.seq;\n      if (hit.selStart >= 0 && this.valueOf(target) != value) {\n        this.setAttr(hit, \".value\", value, true);\n        hit.selStart = value.len();\n        hit.selEnd = value.len();\n      }\n    }\n    i32 selStart = hit.selStart;\n    i32 selEnd = hit.selEnd;\n    i32 at = target;\n    while (at >= 0) {\n      TestNode n = this.at(at);\n      for (i32 i = 0; i < n.listens.len(); i++) {\n        if (n.listens.get(i) != kind) { continue; }\n        this.event(this.seq, kind, target, at, value, 0, 0, 0, selStart, selEnd);\n      }\n      if (this.nodes.get(at) is null) { break; }\n      at = n.parent;\n    }\n    while (this.typedInto.len() > 0) {\n      i32 field = this.typedInto.remove(0);\n      if (this.nodes.get(field) is null) { continue; }\n      this.fire(field, \"input\", this.valueOf(field));\n    }\n  }\n}\n",
    "// Components, hooks and the diff: what turns a function of state into changes to the page.\n//\n// **A component is a function whose first parameter is `Ui`** (`design/system/0012`). Its tag is not\n// called: markup builds a component node through `Ui.[markup.component]` below (`design/lang/0017`), and\n// the view matches it against what it rendered in that place last time. The same place, the same function\n// and the same `key` is the same instance, and its `Ui` — its hooks — carries over.\n//\n// **Hooks are found again by the order of the calls, and nothing checks the order.** A component that\n// calls `ui.state` under an `if` gets another hook's slot and traps on the cast. `auto n = ui.state(0)`\n// answers a `State<T>`; `set` marks the component that made it dirty, and only dirty components render\n// again — outermost first, at the end of the host's call into the program.\n//\n// **A child whose attributes have not changed is skipped**: the compiler gives each tag its attributes'\n// snapshots and a test of them, and a function attribute is not among them. A skipped child is marked\n// *stale*, and renders again before an event is dispatched through it — so a handler that captured\n// something since changed is never the one that runs.\n//\n// **The view owns its element's children.** Nothing else writes there.\n\nimport { Map, Vec, hashString, markup, stringEq } from \"core\";\nimport { Element, ElementEvent, Listen } from \"./element.wac\";\nimport { Attr, Node, On } from \"./html.wac\";\n\n// ── Hooks ────────────────────────────────────────────────────────────────────\n\n/** One hook's storage. A component's hooks are its `Ui`'s slots, in call order. */\nexport struct Slot { i32 unused = 0; }\n\n/** A value a component shows. `set` marks the component that made it; `version` counts the sets. */\nexport struct State<T> : Slot {\n  T v;\n  Ui owner;\n  i32 version = 0;\n\n  T get(this) { return this.v; }\n  void set(this, T x) {\n    this.v = x;\n    this.version = this.version + 1;\n    this.owner.changed();\n  }\n  /** `f` of the value as it is now: two handlers that each await and then update lose nothing. */\n  void update(this, fn<T(T)> f) { this.set(f(this.v)); }\n\n  /**\n   * What a render remembers of a cell handed to a child: the cell, and how many times it had been set\n   * — so the same cell after a `set` is a changed attribute, and the child renders again.\n   */\n  (State<T>, i32) [markup.snapshot](this) { return (this, this.version); }\n}\n\nstruct Memo<T> : Slot { string dep; T v; }\n\n/** An effect: `run` after the render when its dependency changed; `cleanup` before the next run, and at the end. */\nstruct Effect : Slot { string dep; fn<fn<void()>()> run; fn<void()> cleanup; bool pending; }\n\n/**\n * A name for an element the component draws: `Ref at = ui.ref();` and `<canvas ref={at}/>`. Once the\n * render that made the element has been applied — in an effect, or in a handler — `at.element()` is its\n * handle, to draw in or focus; null before then and after the element is gone. Setting it renders\n * nothing.\n */\nexport struct Ref : Slot {\n  Element? el = null;\n\n  Element? element(this) { return this.el; }\n}\n\nvoid noop() {}\n\n// ── A component ──────────────────────────────────────────────────────────────\n\n/** A component as its function sees it: the handle to its hooks, and to the view it is part of. */\nexport struct Ui {\n  View? view;\n  string name;\n  string? key;\n  fn<Node(Ui)> draw;\n  anyref snaps;\n  fn<bool(anyref)> same;\n  Vec<Slot> slots;\n  i32 next = 0;\n  Vec<Effect> effects;\n  /** Where it rendered: the nodes in its place. */\n  Mounted? at = null;\n  Ui? parent = null;\n  /** How many components it sits inside: the root is 0. Dirty components render shallowest first. */\n  i32 depth = 0;\n  bool dirty = false;\n  bool stale = false;\n  bool live = true;\n\n  /**\n   * What markup builds for a tag naming a component (`design/lang/0017`): the function's name, the\n   * `key` attribute, a closure drawing it with these attributes, their snapshots, and a test of whether\n   * another instance's snapshots are these.\n   */\n  Node [markup.component](string name, string? key, fn<Node(Ui)> draw, anyref snaps, fn<bool(anyref)> same) {\n    return Node.Component(name, key, draw, snaps, same);\n  }\n\n  Ui made(View? view, string name, string? key, fn<Node(Ui)> draw, anyref snaps, fn<bool(anyref)> same) {\n    Vec<Slot> slots = Vec.create();\n    Vec<Effect> effects = Vec.create();\n    return Ui { view: view, name: name, key: key, draw: draw, snaps: snaps, same: same, slots: slots, effects: effects };\n  }\n\n  State<T> state<T>(this, T init) {\n    if (this.next == this.slots.len()) {\n      State<T> s = State<T> { v: init, owner: this };\n      this.slots.push(s);\n    }\n    Slot got = this.slots.get(this.next);\n    this.next = this.next + 1;\n    return got as! State<T>;\n  }\n\n  /** `f()`, computed again only when `dep` differs from last render's. */\n  T memo<T>(this, string dep, fn<T()> f) {\n    if (this.next == this.slots.len()) {\n      Memo<T> fresh = Memo<T> { dep: dep, v: f() };\n      this.slots.push(fresh);\n      this.next = this.next + 1;\n      return fresh.v;\n    }\n    Slot got = this.slots.get(this.next);\n    this.next = this.next + 1;\n    Memo<T> m = got as! Memo<T>;\n    if (m.dep != dep) {\n      m.dep = dep;\n      m.v = f();\n    }\n    return m.v;\n  }\n\n  /** Run `run` after this render if `dep` changed; what it answers runs before the next run, or at the end. */\n  void effect(this, string dep, fn<fn<void()>()> run) {\n    if (this.next == this.slots.len()) {\n      Effect fresh = Effect { dep: dep, run: run, cleanup: noop, pending: true };\n      this.slots.push(fresh);\n      this.effects.push(fresh);\n      this.next = this.next + 1;\n      return;\n    }\n    Slot got = this.slots.get(this.next);\n    this.next = this.next + 1;\n    Effect e = got as! Effect;\n    if (e.dep != dep) {\n      e.dep = dep;\n      e.run = run;\n      e.pending = true;\n    }\n  }\n\n  /** A `Ref` that lasts as this component does — the same one every render. */\n  Ref ref(this) {\n    if (this.next == this.slots.len()) { this.slots.push(Ref {}); }\n    Slot got = this.slots.get(this.next);\n    this.next = this.next + 1;\n    return got as! Ref;\n  }\n\n  /** Run `f` once after `ms` milliseconds, unless this component has gone. Answers its cancel. */\n  fn<void()> after(this, i32 ms, fn<void()> f) { return this.timer(ms, false, f); }\n\n  /** Run `f` every `ms` milliseconds while this component lives. Answers its cancel. */\n  fn<void()> every(this, i32 ms, fn<void()> f) { return this.timer(ms, true, f); }\n\n  fn<void()> timer(this, i32 ms, bool repeat, fn<void()> f) {\n    if (this.view is null) { return noop; }\n    Timer t = Timer(this, repeat, ms, f, false);\n    this.view!.arm(t);\n    return () => { t.off = true; };\n  }\n\n  void changed(this) {\n    if (!this.live || this.dirty) { return; }\n    this.dirty = true;\n    if (this.view is not null) {\n      this.view!.dirty.push(this);\n      this.view!.woke();\n    }\n  }\n\n  void unmount(this) {\n    this.live = false;\n    for (i32 i = 0; i < this.effects.len(); i++) { this.effects.get(i).cleanup(); }\n  }\n}\n\n// ── What is on the page ──────────────────────────────────────────────────────\n\n/** A rendered node in its place: what it was rendered as, its handle, and what it sits in. */\nexport struct Mounted {\n  /** 0 an element, 1 a text node, 2 a component. */\n  i32 kind;\n  /** The element's tag, or the component's name. */\n  string tag;\n  string? key;\n  /** The handle of an element or a text node. */\n  Element? el;\n  /** A component's instance. */\n  Ui? comp;\n  /** An element's children, or the nodes a component rendered — in document order. */\n  Vec<Mounted> kids;\n  /** An element's attributes as last set, and a text node's text. */\n  Attr[] attrs;\n  string text;\n  /** What the element's listeners dispatch to: replaced every render, without touching the document. */\n  On[] handlers;\n  Vec<string> listening;\n  /** The component whose render made this node. */\n  Ui owner;\n  /** The element or component this node sits in, and the element whose children its handles are. */\n  Mounted? up;\n  Element parentEl;\n  /** The `Ref` naming this element, as last rendered. */\n  Ref? ref;\n\n  Mounted fresh(i32 kind, string tag, string? key, Ui owner, Mounted? up, Element parentEl) {\n    Vec<Mounted> kids = Vec.create();\n    Vec<string> listening = Vec.create();\n    return Mounted(kind, tag, key, null, null, kids, Attr[](), \"\", On[](), listening, owner, up, parentEl, null);\n  }\n\n  /** Point `r` at this element, letting go of whatever `Ref` named it before. */\n  void named(this, Ref? r) {\n    if (this.ref is not null) {\n      Ref old = this.ref!;\n      bool kept = r is not null && old is r!;\n      // Only if it still names this element: another node may have taken it since.\n      if (!kept && this.el is not null && old.el is not null && old.el! is this.el!) { old.el = null; }\n    }\n    this.ref = r;\n    if (r is not null) { r!.el = this.el; }\n  }\n\n  /** The first handle in this node's range, or null for a component that rendered nothing. */\n  Element? first(this) {\n    if (this.kind != 2) { return this.el; }\n    for (i32 i = 0; i < this.kids.len(); i++) {\n      Element? h = this.kids.get(i).first();\n      if (h is not null) { return h; }\n    }\n    return null;\n  }\n\n  /** Every handle in this node's range, in document order. */\n  void handles(this, Vec<Element> into) {\n    if (this.kind != 2) { into.push(this.el!); return; }\n    for (i32 i = 0; i < this.kids.len(); i++) { this.kids.get(i).handles(into); }\n  }\n}\n\n// ── The view ─────────────────────────────────────────────────────────────────\n\nstruct Timer { Ui owner; bool repeat; i32 ms; fn<void()> run; bool off; }\n\n/** A view over one element: the components rendered into it, kept rendered. */\nexport struct View {\n  Element host;\n  /** The host's timer: calls the function after so many milliseconds, from the host's turn. */\n  fn<void(i32, fn<void()>)> later;\n  Mounted? top;\n  /** The components set dirty since they last rendered — some may have rendered since, or gone. */\n  Vec<Ui> dirty;\n  /** Components rendered this turn, whose effects are run at its end. */\n  Vec<Ui> ran;\n  /** The names of the components rendered, in order — what a test reads. */\n  Vec<string> rendered;\n  /**\n   * **Told each time a component has something to render**, so whoever runs the turns knows one is due: a page\n   * renders once the program has run on (`Page.changed`). Nothing, for a view whose turns a test runs by hand.\n   */\n  fn<void()>? onDirty;\n\n  View create(Element host, fn<void(i32, fn<void()>)> later) {\n    Vec<Ui> dirty = Vec.create();\n    Vec<Ui> ran = Vec.create();\n    Vec<string> rendered = Vec.create();\n    return View(host, later, null, dirty, ran, rendered, null);\n  }\n\n  void woke(this) { if (this.onDirty is not null) { this.onDirty!(); } }\n\n  /** Render `draw` into the host, and keep it rendered: a root component of no attributes. */\n  void mount(this, fn<Node(Ui)> draw) {\n    Ui r = Ui.made(this, \"root\", null, draw, NoSnaps {}, (anyref other) => false);\n    Mounted m = Mounted.fresh(2, \"root\", null, r, null, this.host);\n    m.comp = r;\n    r.at = m;\n    this.top = m;\n    Node[] nodes = this.renderOf(r);\n    for (i32 i = 0; i < nodes.len(); i++) { m.kids.push(this.build(nodes[i], this.host, null, r, m)); }\n    this.turn();\n  }\n\n  // ── The turn ───────────────────────────────────────────────────────────────\n\n  /**\n   * The end of every call into the program: render each dirty component, outermost first, then run the\n   * effects of what rendered. An effect may set state, so this goes round until nothing is dirty.\n   */\n  void turn(this) {\n    if (this.top is null) { return; }\n    while (true) {\n      while (true) {\n        Ui? d = this.shallowestDirty();\n        if (d is null) { break; }\n        this.rerender(d!);\n      }\n      if (this.ran.len() == 0) { break; }\n      Ui[] ran = this.ran.toArray();\n      this.ran.clear();\n      for (i32 i = 0; i < ran.len(); i++) {\n        if (!ran[i].live) { continue; }\n        for (i32 j = 0; j < ran[i].effects.len(); j++) {\n          Effect e = ran[i].effects.get(j);\n          if (!e.pending) { continue; }\n          e.pending = false;\n          e.cleanup();\n          e.cleanup = e.run();\n        }\n      }\n    }\n  }\n\n  /** The dirty live component nearest the root, dropping the entries that have rendered or gone. */\n  Ui? shallowestDirty(this) {\n    Ui? best = null;\n    Vec<Ui> keep = Vec.create();\n    for (i32 i = 0; i < this.dirty.len(); i++) {\n      Ui u = this.dirty.get(i);\n      if (!u.dirty || !u.live) { continue; }\n      keep.push(u);\n      if (best is null || u.depth < best!.depth) { best = u; }\n    }\n    this.dirty = keep;\n    return best;\n  }\n\n  void arm(this, Timer t) {\n    View v = this;\n    this.later(t.ms, () => {\n      if (t.off || !t.owner.live) { return; }\n      t.run();\n      if (t.repeat && !t.off && t.owner.live) { v.arm(t); }\n      v.turn();\n    });\n  }\n\n  // ── Rendering ──────────────────────────────────────────────────────────────\n\n  Node[] renderOf(this, Ui u) {\n    u.dirty = false;\n    u.stale = false;\n    u.next = 0;\n    Node n = u.draw(u);\n    this.rendered.push(u.name);\n    this.ran.push(u);\n    Vec<Node> out = Vec.create();\n    flattenInto(n, out);\n    return out.toArray();\n  }\n\n  void rerender(this, Ui u) {\n    if (u.at is null || !u.live) { return; }\n    Mounted m = u.at!;\n    Node[] nodes = this.renderOf(u);\n    this.patch(m, nodes, m.parentEl, anchorAfter(m), u);\n  }\n\n  /** `n` made in `parent` before `before`, as a node of `owner`'s render sitting in `up`. */\n  Mounted build(this, Node n, Element parent, Element? before, Ui owner, Mounted up) {\n    match (n) {\n      Text(t): {\n        Mounted m = Mounted.fresh(1, \"\", null, owner, up, parent);\n        m.el = parent.insertText(t, before);\n        m.text = t;\n        return m;\n      }\n      Element(tag, attrs, on, kids, ref): {\n        Mounted m = Mounted.fresh(0, tag, keyOfAttrs(attrs), owner, up, parent);\n        Element el = parent.insert(tag, before);\n        m.el = el;\n        m.named(ref);\n        this.setAttrs(m, attrs);\n        this.setHandlers(m, on);\n        Vec<Node> flat = Vec.create();\n        for (i32 i = 0; i < kids.len(); i++) { flattenInto(kids[i], flat); }\n        for (i32 i = 0; i < flat.len(); i++) { m.kids.push(this.build(flat.get(i), el, null, owner, m)); }\n        return m;\n      }\n      Fragment(kids): { trap \"View: a fragment reached build unflattened\"; }\n      Component(name, key, draw, snaps, same): {\n        Mounted m = Mounted.fresh(2, name, key, owner, up, parent);\n        Ui u = Ui.made(this, name, key, draw, snaps, same);\n        u.parent = owner;\n        u.depth = owner.depth + 1;\n        u.at = m;\n        m.comp = u;\n        Node[] nodes = this.renderOf(u);\n        for (i32 i = 0; i < nodes.len(); i++) { m.kids.push(this.build(nodes[i], parent, before, u, m)); }\n        return m;\n      }\n    }\n  }\n\n  /**\n   * `container`'s nodes made to be `want`, in `pe` before `end`. Matched by `key` where a node has one\n   * and by kind and position where it has none; what is left over is removed, what is new is made, and\n   * what moved is moved — the fewest moves that keep the matched nodes' order, found from the longest\n   * run of them already in order. Then each matched node is brought up to date, once the list is whole,\n   * so a component that renders again finds its neighbours where they now are.\n   */\n  void patch(this, Mounted container, Node[] want, Element pe, Element? end, Ui owner) {\n    Mounted[] old = container.kids.toArray();\n    bool[] used = bool[].filled(old.len(), false);\n    i32[] found = i32[].filled(want.len(), -1);\n    Map<string, i32> keyed = Map.create(hashString, stringEq);\n    for (i32 j = 0; j < old.len(); j++) {\n      if (old[j].key is not null) { keyed.set(old[j].key!, j); }\n    }\n    i32 cursor = 0;\n    for (i32 i = 0; i < want.len(); i++) {\n      string? k = keyOfNode(want[i]);\n      if (k is not null) {\n        i32? j = keyed.get(k!);\n        if (j is not null && !used[j!] && sameKind(old[j!], want[i])) {\n          used[j!] = true;\n          found[i] = j!;\n        }\n        continue;\n      }\n      while (cursor < old.len() && (used[cursor] || old[cursor].key is not null)) { cursor = cursor + 1; }\n      if (cursor < old.len() && sameKind(old[cursor], want[i])) {\n        used[cursor] = true;\n        found[i] = cursor;\n        cursor = cursor + 1;\n      }\n    }\n    for (i32 j = 0; j < old.len(); j++) {\n      if (!used[j]) { this.remove(old[j]); }\n    }\n    // Which matched nodes stay: those in increasing order of where they were, the rest move.\n    bool[] moves = bool[].filled(want.len(), false);\n    i32 last = -1;\n    for (i32 i = 0; i < want.len(); i++) {\n      if (found[i] < 0) { continue; }\n      if (found[i] < last) { moves[i] = true; } else { last = found[i]; }\n    }\n    Mounted[] now = Mounted[].filled(want.len(), container);\n    Element? anchor = end;\n    for (i32 i = want.len() - 1; i >= 0; i--) {\n      Mounted m = container;\n      if (found[i] >= 0) {\n        m = old[found[i]];\n        if (moves[i]) { moveBefore(m, anchor); }\n      } else {\n        m = this.build(want[i], pe, anchor, owner, container);\n      }\n      now[i] = m;\n      Element? h = m.first();\n      if (h is not null) { anchor = h; }\n    }\n    container.kids.clear();\n    for (i32 i = 0; i < now.len(); i++) { container.kids.push(now[i]); }\n    for (i32 i = 0; i < want.len(); i++) {\n      if (found[i] >= 0) { this.update(now[i], want[i], owner); }\n    }\n  }\n\n  /** A matched node brought up to date with what was rendered for it. */\n  void update(this, Mounted m, Node n, Ui owner) {\n    m.owner = owner;\n    match (n) {\n      Text(t): {\n        if (m.text != t) {\n          m.el!.text(t);\n          m.text = t;\n        }\n      }\n      Element(tag, attrs, on, kids, ref): {\n        m.named(ref);\n        this.setAttrs(m, attrs);\n        this.setHandlers(m, on);\n        Vec<Node> flat = Vec.create();\n        for (i32 i = 0; i < kids.len(); i++) { flattenInto(kids[i], flat); }\n        this.patch(m, flat.toArray(), m.el!, null, owner);\n      }\n      Fragment(kids): { }\n      Component(name, key, draw, snaps, same): {\n        Ui u = m.comp!;\n        bool changed = !same(u.snaps);\n        u.draw = draw;\n        u.snaps = snaps;\n        u.same = same;\n        u.parent = owner;\n        if (changed || u.dirty) { this.rerender(u); } else { u.stale = true; }\n      }\n    }\n  }\n\n  /** Remove a node and everything in it; every component in it ends, its effects cleaned up. */\n  void remove(this, Mounted m) {\n    unmountAll(m);\n    if (m.kind != 2) {\n      m.el!.remove();\n      return;\n    }\n    for (i32 i = 0; i < m.kids.len(); i++) { this.remove(m.kids.get(i)); }\n  }\n\n  /** An element's attributes made to be `want`: only what changed is sent. */\n  void setAttrs(this, Mounted m, Attr[] want) {\n    Element el = m.el!;\n    for (i32 i = 0; i < want.len(); i++) {\n      Attr a = want[i];\n      if (a.name == \"key\") { continue; }\n      string? had = attrIn(m.attrs, a.name);\n      if (had is not null && had! == a.value) { continue; }\n      if (a.name == \"value\" || a.name == \"checked\" || a.name == \"selected\") {\n        el.prop(a.name, a.name == \"value\" ? a.value : (a.value == \"false\" ? \"false\" : \"true\"));\n      } else {\n        el.attr(a.name, a.value);\n      }\n    }\n    for (i32 i = 0; i < m.attrs.len(); i++) {\n      string name = m.attrs[i].name;\n      if (name == \"key\" || attrIn(want, name) is not null) { continue; }\n      if (name == \"value\") { el.prop(\"value\", \"\"); }\n      else if (name == \"checked\" || name == \"selected\") { el.prop(name, \"false\"); }\n      else { el.attr(name, null); }\n    }\n    m.attrs = want;\n  }\n\n  // ── The development build's check ──────────────────────────────────────────\n\n  /**\n   * What a development build asks after every turn (`design/system/0012`): each live component rendered\n   * again, its nodes compared with what the page shows for it, and a sentence for each place the two\n   * differ, naming the component. They differ only when a render read something that changed without a\n   * `set` — a `Vec` in a cell pushed to in place — so the page kept showing what it was. Nothing on the\n   * page changes, and an effect a fresh render would have scheduled is left as it was.\n   */\n  string[] check(this) {\n    Vec<string> said = Vec.create();\n    if (this.top is not null) { this.checkIn(this.top!, said); }\n    return said.toArray();\n  }\n\n  void checkIn(this, Mounted m, Vec<string> said) {\n    if (m.kind == 2 && m.comp is not null && m.comp!.live) {\n      Ui u = m.comp!;\n      bool[] pending = bool[].filled(u.effects.len(), false);\n      for (i32 i = 0; i < pending.len(); i++) { pending[i] = u.effects.get(i).pending; }\n      u.next = 0;\n      Node n = u.draw(u);\n      for (i32 i = 0; i < pending.len(); i++) {\n        Effect e = u.effects.get(i);\n        e.pending = pending[i];\n      }\n      Vec<Node> fresh = Vec.create();\n      flattenInto(n, fresh);\n      compareNodes(u.name, fresh.toArray(), m.kids, said);\n    }\n    for (i32 i = 0; i < m.kids.len(); i++) { this.checkIn(m.kids.get(i), said); }\n  }\n\n  /** What an element's listeners run, replaced; a kind not listened for yet is listened for. */\n  void setHandlers(this, Mounted m, On[] on) {\n    m.handlers = on;\n    for (i32 i = 0; i < on.len(); i++) {\n      string kind = on[i].kind;\n      bool have = false;\n      for (i32 j = 0; j < m.listening.len(); j++) { if (m.listening.get(j) == kind) { have = true; } }\n      if (have) { continue; }\n      m.listening.push(kind);\n      View v = this;\n      Mounted target = m;\n      m.el!.on(kind, Listen(on[i].prevent), (ElementEvent e) => { v.dispatch(target, kind, e); });\n    }\n  }\n\n  /**\n   * An event on an element: every stale component on the way down to it renders first, outermost first,\n   * so the handler that runs is one from a render with the attributes of now — then the handler, then\n   * the turn.\n   */\n  void dispatch(this, Mounted m, string kind, ElementEvent e) {\n    Vec<Ui> chain = Vec.create();\n    Ui? u = m.owner;\n    while (u is not null) {\n      chain.push(u!);\n      u = u!.parent;\n    }\n    for (i32 i = chain.len() - 1; i >= 0; i--) {\n      Ui c = chain.get(i);\n      if (c.stale && c.live) { this.rerender(c); }\n    }\n    if (m.el is null || !m.el!.isLive()) {\n      this.turn();\n      return;\n    }\n    for (i32 i = 0; i < m.handlers.len(); i++) {\n      if (m.handlers[i].kind == kind) {\n        m.handlers[i].run(e);\n        break;\n      }\n    }\n    this.turn();\n  }\n}\n\n// ── The tree's pieces ────────────────────────────────────────────────────────\n\n/** `n` with its fragments opened, into `out`. */\nvoid flattenInto(Node n, Vec<Node> out) {\n  match (n) {\n    Fragment(kids): { for (i32 i = 0; i < kids.len(); i++) { flattenInto(kids[i], out); } }\n    Text(t): { out.push(n); }\n    Element(tag, attrs, on, kids, ref): { out.push(n); }\n    Component(name, key, draw, snaps, same): { out.push(n); }\n  }\n}\n\nstring? attrIn(Attr[] attrs, string name) {\n  for (i32 i = 0; i < attrs.len(); i++) { if (attrs[i].name == name) { return attrs[i].value; } }\n  return null;\n}\n\nstring? keyOfAttrs(Attr[] attrs) { return attrIn(attrs, \"key\"); }\n\nstring? keyOfNode(Node n) {\n  match (n) {\n    Element(tag, attrs, on, kids, ref): { return keyOfAttrs(attrs); }\n    Component(name, key, draw, snaps, same): { return key; }\n    Text(t): { return null; }\n    Fragment(kids): { return null; }\n  }\n}\n\n/** Whether a mounted node can become `n`: the same kind, and the same tag or component. */\nbool sameKind(Mounted m, Node n) {\n  match (n) {\n    Text(t): { return m.kind == 1; }\n    Element(tag, attrs, on, kids, ref): { return m.kind == 0 && m.tag == tag; }\n    Component(name, key, draw, snaps, same): { return m.kind == 2 && m.tag == name; }\n    Fragment(kids): { return false; }\n  }\n}\n\n/** The handle that follows `m`'s range in its element, or null at the end. */\nElement? anchorAfter(Mounted m) {\n  Mounted c = m;\n  while (c.up is not null) {\n    Mounted up = c.up!;\n    i32 at = -1;\n    for (i32 i = 0; i < up.kids.len(); i++) { if (up.kids.get(i) is c) { at = i; } }\n    for (i32 j = at + 1; j < up.kids.len(); j++) {\n      Element? h = up.kids.get(j).first();\n      if (h is not null) { return h; }\n    }\n    if (up.kind == 0) { return null; }\n    c = up;\n  }\n  return null;\n}\n\n/** Every handle of `m` moved, in order, before `anchor`. */\nvoid moveBefore(Mounted m, Element? anchor) {\n  Vec<Element> hs = Vec.create();\n  m.handles(hs);\n  for (i32 i = 0; i < hs.len(); i++) { hs.get(i).move(anchor); }\n}\n\n/**\n * Where `want` — a fresh render's nodes — differs from `have`, what the page shows for them, each said\n * once and naming `who`. A child component's own nodes are its own render's to compare, so here it is\n * only matched by name.\n */\nvoid compareNodes(string who, Node[] want, Vec<Mounted> have, Vec<string> said) {\n  if (want.len() != have.len()) {\n    said.push(who + \" renders \\{want.len()} nodes where the page shows \\{have.len()}: it changed something without a `set`\");\n    return;\n  }\n  for (i32 i = 0; i < want.len(); i++) {\n    Mounted h = have.get(i);\n    match (want[i]) {\n      Text(t): {\n        if (h.kind != 1 || h.text != t) {\n          said.push(who + \" renders the text \\\"\" + t + \"\\\" where the page shows \\\"\" + h.text + \"\\\"\");\n        }\n      }\n      Element(tag, attrs, on, kids, ref): {\n        if (h.kind != 0 || h.tag != tag) {\n          said.push(who + \" renders a <\" + tag + \"> where the page shows \" + (h.kind == 0 ? \"a <\" + h.tag + \">\" : \"something else\"));\n          continue;\n        }\n        for (i32 j = 0; j < attrs.len(); j++) {\n          if (attrs[j].name == \"key\") { continue; }\n          string? had = attrIn(h.attrs, attrs[j].name);\n          if (had is null || had! != attrs[j].value) {\n            said.push(who + \" renders \" + tag + \"'s \" + attrs[j].name + \" as \\\"\" + attrs[j].value + \"\\\" where the page has \\\"\" + (had ?? \"\") + \"\\\"\");\n          }\n        }\n        Vec<Node> flat = Vec.create();\n        for (i32 j = 0; j < kids.len(); j++) { flattenInto(kids[j], flat); }\n        compareNodes(who, flat.toArray(), h.kids, said);\n      }\n      Fragment(kids): { }\n      Component(name, key, draw, snaps, same): {\n        if (h.kind != 2 || h.tag != name) { said.push(who + \" renders a \" + name + \" where the page shows something else\"); }\n      }\n    }\n  }\n}\n\nvoid unmountAll(Mounted m) {\n  if (m.comp is not null) { m.comp!.unmount(); }\n  m.named(null);\n  for (i32 i = 0; i < m.kids.len(); i++) { unmountAll(m.kids.get(i)); }\n}\n\n/** What the root component's attributes are: there are none. */\nstruct NoSnaps { i32 unused = 0; }\n"
  ];
}
