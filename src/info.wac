// What a name is, as wacc's `queryIn` answers: its type, where it is declared, and what it says there.

import { Vec } from "core";

export struct Info {
  /** The file and the token it is about, in bytes. */
  string path;
  i32 start;
  i32 end;
  string type;
  /** Where it is declared; "" when that is not known. */
  string defPath;
  i32 defLine;
  i32 defCol;
  string kind;
  /** The declaration's line, as written, and its doc comment. */
  string sig;
  string[] doc;
}

i32 number(string s) {
  i32 n = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] >= '0' && b[i] <= '9') { n = n * 10 + ((b[i] - '0') as i32); } }
  return n;
}

/** `queryIn`'s lines read back; null when they say nothing about a token. */
export Info? parseInfo(string path, string answer) {
  Info out = Info(path, -1, -1, "", "", 0, 0, "", "", string[]());
  Vec<string> doc = Vec.create();
  i32 start = 0;
  u8[] b = answer.toBytes();
  for (i32 i = 0; i <= b.len(); i++) {
    if (i < b.len() && b[i] != '\n') { continue; }
    string line = answer.slice(start, i);
    start = i + 1;
    Vec<string> f = Vec.create();
    i32 at = 0;
    u8[] lb = line.toBytes();
    for (i32 k = 0; k <= lb.len(); k++) {
      if (k == lb.len() || lb[k] == '\t') { f.push(line.slice(at, k)); at = k + 1; }
    }
    if (f.len() < 2) { continue; }
    string key = f.get(0);
    if (key == "token" && f.len() >= 3) { out.start = number(f.get(1)); out.end = number(f.get(2)); }
    else if (key == "type") { out.type = f.get(1); }
    else if (key == "def" && f.len() >= 5) { out.defPath = f.get(1); out.defLine = number(f.get(2)); out.defCol = number(f.get(3)); out.kind = f.get(4); }
    else if (key == "sig") { out.sig = line.slice(4, line.len()); }
    else if (key == "doc") { doc.push(line.slice(4, line.len())); }
  }
  out.doc = doc.toArray();
  if (out.start < 0) { return null; }
  return out;
}
